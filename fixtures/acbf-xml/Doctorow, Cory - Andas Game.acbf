  <page>
   <image href="05.jpg"/>
   <text-layer lang="en">
     <text-area points="133,180 137,168 153,159 180,156 212,160 225,170 228,180 224,191 211,200 188,203 159,201 141,194">
       <p>GOT 'IM!</p>
     </text-area>
     <text-area points="520,565 525,560 620,559 626,564 627,604 621,610 526,608 521,603" bgcolor="#000000" type="code" inverted="True">
       <p>&gt;bitch!</p>
     </text-area>
     <text-area points="99,707 102,694 117,686 134,682 164,684 184,689 193,699 194,713 187,724 169,731 137,733 110,727 101,719">
       <p>SARGE!</p>
     </text-area>
     <text-area points="405,702 408,690 419,683 441,679 469,683 482,690 486,703 481,715 471,721 453,726 427,723 410,717 406,710">
       <p>SHIT!</p>
     </text-area>
     <text-area points="966,720 969,709 982,700 1005,696 1034,699 1047,707 1052,719 1049,732 1039,739 1020,744 988,743 973,736 967,729">
       <p>YAAAR!</p>
     </text-area>
     <text-area points="345,1288 348,1273 360,1261 385,1253 416,1250 458,1256 480,1270 485,1282 485,1297 479,1309 467,1317 450,1322 434,1324 394,1325 364,1317 349,1303 345,1291">
       <p>SARGE, WHERE'D YOU <emphasis>RESPAWN?</emphasis></p>
     </text-area>
     <text-area points="74,1537 80,1514 94,1496 121,1482 150,1477 195,1477 229,1486 251,1504 262,1528 262,1555 248,1577 220,1595 189,1599 138,1598 110,1592 87,1575 76,1554">
       <p>ALL THE WAY OVER AT <emphasis>BODY ELECTRIC.</emphasis> IT'LL TAKE ME <emphasis>HOURS</emphasis> TO GET THERE.</p>
     </text-area>
     <text-area points="277,1586 283,1560 299,1541 325,1528 378,1527 414,1535 435,1552 446,1584 442,1606 433,1625 420,1634 401,1644 372,1647 330,1645 307,1638 287,1621 279,1603">
       <p>DO YOU THINK YOU CAN <emphasis>COMPLETE</emphasis> THE MISSION ON YOUR OWN?</p>
     </text-area>
     <text-area points="408,1762 411,1747 424,1738 441,1733 464,1732 483,1741 494,1753 493,1772 486,1783 467,1791 436,1790 420,1785 409,1772">
       <p>UH, SURE.</p>
     </text-area>
     <text-area points="1000,1345 1003,1326 1019,1308 1046,1296 1074,1293 1118,1293 1145,1299 1172,1313 1182,1329 1184,1358 1176,1371 1162,1382 1141,1391 1114,1396 1061,1393 1027,1385 1007,1369 1002,1358">
       <p>YOU'RE THE <emphasis>BEST,</emphasis> GIRL. KILL <emphasis>EVERYONE</emphasis> IN THE COTTAGE.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="133,180 137,168 153,159 180,156 212,160 225,170 228,180 224,191 211,200 188,203 159,201 141,194">
       <p>MÁM HO!</p>
     </text-area>
     <text-area points="520,565 525,560 620,559 626,564 627,604 621,610 526,608 521,603" bgcolor="#000000" type="code" inverted="True">
       <p>&gt;suka!</p>
     </text-area>
     <text-area points="99,707 102,694 117,686 134,682 164,684 184,689 193,699 194,713 187,724 169,731 137,733 110,727 101,719">
       <p>SERŽANT!</p>
     </text-area>
     <text-area points="405,702 408,690 419,683 441,679 469,683 482,690 486,703 481,715 471,721 453,726 427,723 410,717 406,710">
       <p>SAKRA!</p>
     </text-area>
     <text-area points="966,720 969,709 982,700 1005,696 1034,699 1047,707 1052,719 1049,732 1039,739 1020,744 988,743 973,736 967,729">
       <p>ÁÁÁÁ!</p>
     </text-area>
     <text-area points="345,1288 348,1273 360,1261 385,1253 416,1250 458,1256 480,1270 485,1282 485,1297 479,1309 467,1317 450,1322 434,1324 394,1325 364,1317 349,1303 345,1291">
       <p>SERŽANT, KDE ŤA <emphasis>OŽIVILO?</emphasis></p>
     </text-area>
     <text-area points="74,1537 80,1514 94,1496 121,1482 150,1477 195,1477 229,1486 251,1504 262,1528 262,1555 248,1577 220,1595 189,1599 138,1598 110,1592 87,1575 76,1554">
       <p>CELÚ CESTU SPÄŤ AŽ K <emphasis>ELEKTRICKÉMU TELU.</emphasis> POTRVÁ MI TO <emphasis>VÄČNOSŤ</emphasis> DOSTAŤ SA SPÄŤ.</p>
     </text-area>
     <text-area points="277,1586 283,1560 299,1541 325,1528 378,1527 414,1535 435,1552 446,1584 442,1606 433,1625 420,1634 401,1644 372,1647 330,1645 307,1638 287,1621 279,1603">
       <p>MYSLÍŠ, ŽE DOKÁŽEŠ <emphasis>DOKONČIŤ</emphasis> MISIU SAMA?</p>
     </text-area>
     <text-area points="408,1762 411,1747 424,1738 441,1733 464,1732 483,1741 494,1753 493,1772 486,1783 467,1791 436,1790 420,1785 409,1772">
       <p>HMM, JASNE.</p>
     </text-area>
     <text-area points="1000,1345 1003,1326 1019,1308 1046,1296 1074,1293 1118,1293 1145,1299 1172,1313 1182,1329 1184,1358 1176,1371 1162,1382 1141,1391 1114,1396 1061,1393 1027,1385 1007,1369 1002,1358">
       <p>SI <emphasis>NAJLEPŠIA,</emphasis> DIEVČA. VYZABÍJAJ <emphasis>VŠETKÝCH</emphasis> V CHATRČI.</p>
     </text-area>
   </text-layer>
   <frame points="54,41 468,41 474,647 54,647"/>
   <frame points="477,44 894,44 894,83 894,86 909,77 936,62 981,47 1014,44 1014,50 996,71 978,92 972,101 1014,95 1014,101 987,119 969,128 963,137 969,140 1011,140 1011,146 1002,158 987,173 969,185 936,203 912,215 897,215 897,647 480,647"/>
   <frame points="909,215 912,215 969,185 987,173 1011,146 1017,47 1272,47 1272,650 1062,650 909,647"/>
   <frame points="54,659 372,659 372,1211 60,1211"/>
   <frame points="384,662 480,662 495,647 507,647 513,659 852,659 849,1211 603,1211 564,1235 558,1235 558,1226 567,1211 384,1211"/>
   <frame points="867,659 1050,662 1062,650 1080,650 1089,653 1092,647 1101,641 1107,644 1116,644 1122,641 1134,641 1143,629 1149,626 1155,617 1158,605 1161,599 1167,602 1170,605 1188,596 1200,590 1197,575 1203,572 1212,578 1218,593 1230,602 1245,602 1248,611 1257,629 1260,647 1266,656 1267,1209 861,1209"/>
