  <page>
   <image href="04.jpg"/>
   <text-layer lang="en">
     <text-area points="155,422 158,401 170,383 192,370 219,364 258,363 290,369 311,381 325,398 329,415 328,434 323,452 310,466 292,476 272,481 241,483 209,480 187,473 165,456 157,439">
       <p>NUKE 'EM TILL THEY <emphasis>GLOW</emphasis> AND SHOOT 'EM IN THE <emphasis>DARK!</emphasis> YEE-HAW!</p>
     </text-area>
     <text-area points="585,145 589,126 607,112 638,104 672,101 710,104 738,112 754,127 758,145 753,163 736,178 708,186 669,188 628,185 602,175 588,158">
       <p>I COUNT <emphasis>THREE</emphasis> SURVIVORS. I'M ON THEM.</p>
     </text-area>
     <text-area points="1075,130 1080,125 1181,126 1185,132 1185,159 1182,165 1080,165 1076,159" bgcolor="#000000" type="code" inverted="True">
       <p>&gt;Urgh!</p>
     </text-area>
     <text-area points="609,878 613,860 631,847 654,840 698,841 721,848 734,860 741,880 736,899 722,912 702,919 668,921 634,915 615,902 610,889">
       <p>MAKE THAT TWO SURVIVORS.</p>
     </text-area>
     <text-area points="188,1405 196,1393 211,1387 233,1383 273,1383 296,1388 312,1395 317,1405 313,1415 295,1423 270,1427 233,1427 211,1423 192,1416">
       <p>YEEEARGH!</p>
     </text-area>
     <text-area points="910,1373 914,1366 997,1366 1004,1372 1004,1405 1000,1412 916,1412 910,1406" bgcolor="#000000" type="code" inverted="True">
       <p>&gt;die!</p>
     </text-area>
     <text-area points="1021,1690 1025,1678 1040,1666 1068,1660 1111,1659 1139,1667 1152,1676 1159,1691 1153,1708 1136,1719 1115,1723 1087,1725 1053,1722 1032,1712 1022,1700">
       <p>NO. NO. NO! IT'S <emphasis>STUCK!</emphasis></p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="155,422 158,401 170,383 192,370 219,364 258,363 290,369 311,381 325,398 329,415 328,434 323,452 310,466 292,476 272,481 241,483 209,480 187,473 165,456 157,439">
       <p>ZBOMBARDUJ ICH AŽ <emphasis>ZČERNAJÚ</emphasis> A NASTRIEĽAJ IM DO <emphasis>ZADKOV!</emphasis> JÉÉ-HAW!</p>
     </text-area>
     <text-area points="585,145 589,126 607,112 638,104 672,101 710,104 738,112 754,127 758,145 753,163 736,178 708,186 669,188 628,185 602,175 588,158">
       <p>VIDÍM <emphasis>TROCH</emphasis> PREŽIVŠÍCH. IDEM NA NICH.</p>
     </text-area>
     <text-area points="1075,130 1080,125 1181,126 1185,132 1185,159 1182,165 1080,165 1076,159" bgcolor="#000000" type="code" inverted="True">
       <p>&gt;Urgh!</p>
     </text-area>
     <text-area points="609,878 613,860 631,847 654,840 698,841 721,848 734,860 741,880 736,899 722,912 702,919 668,921 634,915 615,902 610,889">
       <p>UŽ ZOSTALI IBA DVAJA.</p>
     </text-area>
     <text-area points="188,1405 196,1393 211,1387 233,1383 273,1383 296,1388 312,1395 317,1405 313,1415 295,1423 270,1427 233,1427 211,1423 192,1416">
       <p>JÉÉÉARG!</p>
     </text-area>
     <text-area points="910,1373 914,1366 997,1366 1004,1372 1004,1405 1000,1412 916,1412 910,1406" bgcolor="#000000" type="code" inverted="True">
       <p>&gt;zomrieš!</p>
     </text-area>
     <text-area points="1021,1690 1025,1678 1040,1666 1068,1660 1111,1659 1139,1667 1152,1676 1159,1691 1153,1708 1136,1719 1115,1723 1087,1725 1053,1722 1032,1712 1022,1700">
       <p>NIE. NIE. NIE! <emphasis>ZASEKLO</emphasis> SA MI TO!</p>
     </text-area>
   </text-layer>
   <frame points="119,85 558,88 552,828 114,826"/>
   <frame points="570,87 826,89 821,828 564,829"/>
   <frame points="1212,90 1211,832 834,829 835,90"/>
   <frame points="33,827 762,827 763,1323 35,1322"/>
   <frame points="771,827 1296,831 1296,1325 776,1324"/>
   <frame points="35,1336 637,1338 634,1893 35,1891"/>
   <frame points="1293,1338 1295,1894 646,1894 645,1339"/>
