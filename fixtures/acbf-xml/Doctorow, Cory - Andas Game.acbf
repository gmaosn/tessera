   <frame points="635,868 654,787 655,708 920,707 953,692 1202,693 1202,1118 1213,1114 1216,1121 1204,1133 1203,1285 1155,1283 1169,1319 1166,1325 1132,1285 1122,1284 1116,1288 1111,1285 636,1286 635,866"/>
   <frame points="115,1302 149,1302 147,1292 149,1289 153,1289 162,1302 438,1301 441,1864 359,1864 360,1870 356,1871 346,1865 89,1865 82,1676 82,1660 91,1643 104,1633 112,1628 113,1427 107,1426 114,1415"/>
   <frame points="453,1746 453,1737 473,1713 474,1699 482,1698 485,1676 486,1665 494,1668 494,1658 490,1647 492,1638 502,1620 497,1592 503,1564 474,1434 471,1427 475,1420 484,1421 486,1438 514,1554 525,1551 527,1527 537,1511 541,1490 556,1471 556,1457 521,1410 491,1406 467,1395 455,1376 456,1349 467,1331 493,1318 527,1316 560,1317 590,1329 646,1307 659,1317 679,1351 684,1343 693,1352 730,1354 751,1361 757,1355 762,1357 762,1367 766,1369 793,1354 798,1360 777,1381 786,1396 787,1428 780,1445 765,1458 799,1503 800,1863 631,1864 638,1882 634,1886 612,1864 453,1865 453,1838 441,1843 440,1837 442,1831 452,1823 452,1805 448,1789 447,1766 450,1753"/>
   <frame points="811,1304 842,1301 1127,1294 1205,1295 1205,1863 813,1863"/>
