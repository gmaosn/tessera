  <page>
   <image href="06.jpg"/>
   <text-layer lang="en">
     <text-area points="390,209 394,192 408,181 433,176 464,180 478,191 484,207 479,225 464,235 443,240 413,238 397,228 391,219">
       <p>WHAT THE - ?</p>
     </text-area>
     <text-area points="548,543 553,517 566,502 591,491 625,487 664,491 691,505 705,527 706,552 700,574 685,588 662,598 629,601 593,598 568,588 551,568">
       <p>SARGE, IT'S JUST A BUNCH OF <emphasis>NOOBS</emphasis> CRAFTING SHIRTS!</p>
     </text-area>
     <text-area points="931,190 936,177 950,166 972,160 1016,161 1042,171 1053,184 1053,201 1044,214 1024,223 974,224 953,221 937,210 930,196">
       <p>GOOD, KILL THEM ALL.</p>
     </text-area>
     <text-area points="1095,240 1101,224 1120,214 1163,213 1184,220 1194,234 1192,249 1184,258 1158,265 1125,266 1106,259 1098,248">
       <p>REALLY?</p>
     </text-area>
     <text-area points="237,733 240,714 251,701 270,692 307,692 335,699 349,714 351,740 344,756 325,768 298,770 274,770 251,762 239,746">
       <p>YEAH, THAT'S THE ORDERS.</p>
     </text-area>
     <text-area points="1111,957 1114,950 1231,951 1238,958 1238,1027 1230,1035 1119,1035 1111,1028" bgcolor="#000000" type="formal" inverted="True">
       <p>&gt;no porfa necesito mi plata</p>
     </text-area>
     <text-area points="73,1131 77,1112 93,1098 123,1089 163,1089 189,1096 206,1111 211,1133 204,1154 183,1166 154,1172 118,1171 91,1162 77,1148">
       <p>HUH ... ITALIAN? NO, <emphasis>SPANISH</emphasis> ...</p>
     </text-area>
     <text-area points="628,1206 1076,1243 1083,1306 636,1272" text-rotation="356" type="code">
       <p>&gt;no [colloquial] please, I need my [colloquial] [money - silver]</p>
     </text-area>
     <text-area points="52,1534 59,1507 83,1484 125,1472 186,1472 226,1483 250,1505 257,1524 255,1552 245,1571 223,1586 181,1597 128,1596 91,1588 66,1571 54,1550">
       <p>CRAFTING SHIRTS FOR A FEW COPPER PIECES. <emphasis>PATHETIC.</emphasis> WHY NOT PLAYING MISSION FOR GOLD?</p>
     </text-area>
     <text-area points="117,1653 120,1636 134,1625 165,1616 203,1617 232,1627 243,1644 241,1666 223,1682 186,1688 150,1685 125,1675 117,1663">
       <p>SARGE, THEY'RE ALL DEAD.</p>
     </text-area>
     <text-area points="716,1606 721,1577 740,1558 767,1546 821,1546 847,1552 871,1568 881,1592 881,1619 874,1637 855,1653 825,1663 771,1663 741,1654 721,1631">
       <p>GOOD JOB. GET MY STUFF AND MEET ME AT <emphasis>MARIONETTE TAVERN.</emphasis> OK?</p>
     </text-area>
     <text-area points="1141,1638 1145,1626 1161,1620 1181,1621 1193,1628 1196,1639 1191,1649 1181,1655 1156,1655 1144,1647">
       <p>OK.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="390,209 394,192 408,181 433,176 464,180 478,191 484,207 479,225 464,235 443,240 413,238 397,228 391,219">
       <p>ČO DO - ?</p>
     </text-area>
     <text-area points="548,543 553,517 566,502 591,491 625,487 664,491 691,505 705,527 706,552 700,574 685,588 662,598 629,601 593,598 568,588 551,568">
       <p>SERŽANT, JE TU LEN KOPA <emphasis>AMATÉROV</emphasis> VYRÁBAJÚCICH KOŠELE!</p>
     </text-area>
     <text-area points="931,190 936,177 950,166 972,160 1016,161 1042,171 1053,184 1053,201 1044,214 1024,223 974,224 953,221 937,210 930,196">
       <p>DOBRE, ZABI ICH VŠETKÝCH.</p>
     </text-area>
     <text-area points="1095,240 1101,224 1120,214 1163,213 1184,220 1194,234 1192,249 1184,258 1158,265 1125,266 1106,259 1098,248">
       <p>NAOZAJ?</p>
     </text-area>
     <text-area points="237,733 240,714 251,701 270,692 307,692 335,699 349,714 351,740 344,756 325,768 298,770 274,770 251,762 239,746">
       <p>JASNE, TO JE ROZKAZ.</p>
     </text-area>
     <text-area points="1111,957 1114,950 1231,951 1238,958 1238,1027 1230,1035 1119,1035 1111,1028" bgcolor="#000000" type="formal" inverted="True">
       <p>&gt;no porfa necesito mi plata</p>
     </text-area>
     <text-area points="73,1131 77,1112 93,1098 123,1089 163,1089 189,1096 206,1111 211,1133 204,1154 183,1166 154,1172 118,1171 91,1162 77,1148">
       <p>HMM ... TALIANSKY? NIE, <emphasis>ŠPANIELSKY</emphasis> ...</p>
     </text-area>
     <text-area points="628,1206 1076,1243 1083,1306 636,1272" text-rotation="356" type="code">
       <p>&gt;nie [hovorovo] prosím, potrebujem svoje [hovorovo] [peniaze - striebro]</p>
     </text-area>
     <text-area points="52,1534 59,1507 83,1484 125,1472 186,1472 226,1483 250,1505 257,1524 255,1552 245,1571 223,1586 181,1597 128,1596 91,1588 66,1571 54,1550">
       <p>VYRÁBANIE KOŠIEL PRE PÁR KÚSKOV MEDI. <emphasis>SMIEŠNE.</emphasis> PREČO RADŠEJ NEHRAŤ PRE ZLATO?</p>
     </text-area>
     <text-area points="117,1653 120,1636 134,1625 165,1616 203,1617 232,1627 243,1644 241,1666 223,1682 186,1688 150,1685 125,1675 117,1663">
       <p>SERŽANT, VŠETCI SÚ MŔTVI.</p>
     </text-area>
     <text-area points="716,1606 721,1577 740,1558 767,1546 821,1546 847,1552 871,1568 881,1592 881,1619 874,1637 855,1653 825,1663 771,1663 741,1654 721,1631">
       <p>SKVELÁ PRÁCA. ZOBER MOJE VECI A STRETNEME SA PRI <emphasis>HOSTINCI MARIONET.</emphasis> OK?</p>
     </text-area>
     <text-area points="1141,1638 1145,1626 1161,1620 1181,1621 1193,1628 1196,1639 1191,1649 1181,1655 1156,1655 1144,1647">
       <p>OK.</p>
     </text-area>
   </text-layer>
   <frame points="36,39 953,39 921,226 959,346 958,667 40,667"/>
   <frame points="964,229 949,228 942,222 920,229 921,224 934,214 925,200 927,180 939,165 957,158 951,136 957,137 970,153 976,149 981,154 1019,156 1029,159 1037,153 1041,162 1049,162 1064,157 1066,161 1211,164 1206,653 961,653"/>
   <frame points="38,689 261,689 254,664 256,660 274,687 279,680 284,687 310,688 327,690 692,689 690,957 710,963 721,970 721,987 716,996 707,1000 690,1001 690,1059 37,1059"/>
   <frame points="709,690 814,690 817,676 827,668 827,663 849,648 862,648 874,653 880,652 885,642 889,644 892,654 895,659 892,665 905,673 913,682 914,688 1294,690 1294,1061 707,1060"/>
   <frame points="36,1206 71,1184 97,1171 76,1158 67,1139 69,1113 86,1094 116,1084 165,1084 186,1071 314,1073 333,1084 349,1100 364,1124 414,1122 412,1448 36,1445"/>
   <frame points="427,1448 428,1414 518,1358 491,1115 493,1097 510,1071 533,1073 1031,1076 1100,1089 1119,1197 1295,1123 1295,1457 1004,1454"/>
   <frame points="38,1458 490,1461 484,1962 31,1962 37,1817"/>
   <frame points="495,1463 1007,1468 1011,1459 1026,1444 1039,1435 1055,1420 1066,1420 1074,1423 1083,1416 1096,1424 1113,1452 1109,1463 1114,1470 1295,1472 1297,1962 495,1963"/>
  </page>
  <page>
   <image href="07.jpg"/>
   <text-layer lang="en">
     <text-area points="96,71 415,72 414,162 96,162" bgcolor="#f3ff9d" type="commentary">
       <p>LUCY'S VOICE IN HER EAR WAS A CONSTANT COMPANION IN HER LIFE NOW, AS THEY RAN MISSION INTO THE WEE HOURS OF THE NIGHT.</p>
     </text-area>
     <text-area points="105,251 112,220 137,198 180,185 243,185 279,194 303,211 316,239 315,267 304,288 281,305 252,314 188,316 154,311 127,297 110,275 105,260">
       <p>BUT, SARGE, I JUST CAN'T UNDERSTAND <emphasis>WHY</emphasis> ANYONE WOULD PAY US CASH FOR THESE MISSIONS.</p>
     </text-area>
     <text-area points="349,267 353,241 365,220 385,204 424,193 479,194 511,202 537,221 549,239 553,272 548,298 533,319 511,332 477,341 423,341 390,331 365,315 352,291">
       <p>DUNNO, EITHER, HELL, IT'S PROBABLY TWO RICH GAMERS. ONE'S <emphasis>FUCKING</emphasis> WITH THE OTHER ONE AND PAYING US.</p>
     </text-area>
     <text-area points="452,681 456,669 470,659 496,653 535,652 570,656 589,668 594,682 587,698 564,707 525,711 485,710 463,701 453,690">
       <p>YOU REALLY THINK THAT?</p>
     </text-area>
     <text-area points="445,964 449,934 460,909 485,887 515,874 554,866 616,866 656,873 689,887 712,908 724,933 729,954 729,981 718,1011 705,1031 678,1048 647,1058 607,1064 543,1061 509,1052 478,1037 454,1009 445,984">
       <p>"SIGH" LOOK AT IT THIS WAY - MOST OF THE WORLD IS LIVING ON, LIKE, A DOLLAR A DAY. MY DAD SENDS MOM THREE THOUSAND A MONTH IN CHILD-SUPPORT, AND WE'RE NOT EVEN <emphasis>RICH!</emphasis> BUT TO AN <emphasis>AFRICAN</emphasis> OR WHATEVER, I <emphasis>AM.</emphasis></p>
     </text-area>
     <text-area points="539,1187 722,1188 723,1312 540,1314" bgcolor="#f3ff9d" type="commentary">
       <p>"ANDA, IT'S  NOT <emphasis>HEALTHY</emphasis> FOR YOU TO SPEND SO MUCH TIME WITH YOUR GAME," HER DA WOULD SAY.</p>
     </text-area>
     <text-area points="1035,1068 1033,1019 1039,985 1057,948 1084,924 1126,912 1178,913 1216,928 1243,960 1255,990 1259,1022 1258,1067 1246,1107 1222,1138 1189,1156 1150,1161 1107,1156 1071,1138 1046,1107 1037,1078">
       <p>SO THERE'S PROBABLY SOME <emphasis>SAUDI</emphasis> OR <emphasis>JAPANESE</emphasis> GUY OR <emphasis>RUSSIAN</emphasis> MAFIA KID OUT THERE WHO'S SO RICH THAT THIS IS JUST CHUMP CHANGE FOR HIM, AND HE'S PAYING US TO <emphasis>MESS</emphasis> AROUND WITH SOME OTHER RICH PERSON.</p></text-area>
     <text-area points="782,1255 1087,1255 1087,1313 782,1313" bgcolor="#f3ff9d" type="commentary">
       <p>"DAAAA!" SHE'D PROTEST. "I GO TO P.E. EVERY STINKING DAY."</p>
     </text-area>
     <text-area points="547,1459 552,1431 571,1410 603,1395 665,1393 701,1401 729,1418 741,1442 743,1467 737,1488 724,1507 700,1520 668,1527 618,1527 584,1519 560,1502 548,1477">
       <p>TO THEM, WE'RE LIKE THE AFRICANS MAKING A DOLLAR A DAY TO CRAFT ... I MEAN, SEW T-SHIRTS.</p>
     </text-area>
     <text-area points="929,1507 1255,1507 1255,1564 929,1565" bgcolor="#f3ff9d" type="commentary">
       <p>"OK, ANDA. BUT <emphasis>DO</emphasis> TRY TO GET A LITTLE MORE EXCERSICE, <emphasis>PLEASE".</emphasis></p>
     </text-area>
     <text-area points="115,1646 120,1626 138,1612 159,1607 199,1607 216,1612 234,1624 240,1640 239,1657 230,1671 212,1681 176,1685 145,1681 127,1673 118,1659">
       <p><emphasis>GUESS</emphasis> THAT MAKES SENSE.</p>
     </text-area>
     <text-area points="662,1705 665,1689 682,1676 703,1673 734,1674 758,1679 771,1694 774,1710 762,1727 741,1735 692,1734 671,1725 664,1714">
       <p><emphasis>NICE</emphasis> ONE, ANDA.</p>
     </text-area>
     <text-area points="701,1812 704,1796 718,1784 745,1779 772,1781 791,1789 800,1803 800,1821 795,1833 775,1844 749,1845 723,1842 709,1835 701,1821">
       <p>THANKS, SARGE.</p>
     </text-area>
     <text-area points="1104,1840 1106,1820 1114,1802 1137,1790 1156,1785 1206,1785 1237,1796 1252,1817 1253,1844 1242,1862 1225,1874 1204,1879 1163,1880 1133,1874 1116,1862 1106,1850">
       <p>NOW, LET'S GO FIND THAT NEW COTTAGE.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="96,71 415,72 414,162 96,162" bgcolor="#f3ff9d" type="commentary">
       <p>LUCYIN HLAS V JEJ UCHU BOL TERAZ STÁLYM SPRIEVODCOM V JEJ ŽIVOTE, KEĎ PLNILI RÔZNE MISIE AŽ DO NESKORÝCH NOČNÝCH HODÍN.</p>
     </text-area>
     <text-area points="105,251 112,220 137,198 180,185 243,185 279,194 303,211 316,239 315,267 304,288 281,305 252,314 188,316 154,311 127,297 110,275 105,260">
       <p>ALE, SERŽANT, NEDOKÁŽEM POROZUMIEŤ TOMU, <emphasis>PREČO</emphasis> BY NÁM NIEKTO MAL PLATIŤ PENIAZE ZA TIETO MISIE.</p>
     </text-area>
     <text-area points="349,267 353,241 365,220 385,204 424,193 479,194 511,202 537,221 549,239 553,272 548,298 533,319 511,332 477,341 423,341 390,331 365,315 352,291">
       <p>NEVIEM ANI JA, DO PEKLA, PRAVDEPODOBNE NEJAKÍ BOHATÍ HRÁČI. JEDEN <emphasis>BOJUJE</emphasis> S DRUHÝM A PLATIA NÁM.</p>
     </text-area>
     <text-area points="452,681 456,669 470,659 496,653 535,652 570,656 589,668 594,682 587,698 564,707 525,711 485,710 463,701 453,690">
       <p>NAOZAJ SI TO MYSLÍŠ?</p>
     </text-area>
     <text-area points="445,964 449,934 460,909 485,887 515,874 554,866 616,866 656,873 689,887 712,908 724,933 729,954 729,981 718,1011 705,1031 678,1048 647,1058 607,1064 543,1061 509,1052 478,1037 454,1009 445,984">
       <p>"ACH" POZRI SA NA TO TAKTO - VÄČŠINA SVETA ŽIJE ASI Z JEDNÉHO DOLÁRA NA DEŇ. MÔJ OTEC POSIELA MAME KAŽDÝ MESIAC TRI TISÍC NA PODPORU DIEŤAŤA, A TO ANI NIE SME <emphasis>BOHATÍ!</emphasis> ALE PRE <emphasis>AFRIČANA</emphasis> ALEBO NIEKOHO INEÉHO, JA <emphasis>SOM</emphasis> BOHATÁ.</p>
     </text-area>
     <text-area points="539,1187 722,1188 723,1312 540,1314" bgcolor="#f3ff9d" type="commentary">
       <p>"ANDA, NIE JE <emphasis>ZDRAVÉ,</emphasis> KEĎ TRÁVIŠ TAK VEĽA ČASU SO SVOJOU HROU," POVEDAL BY JEJ OTEC.</p>
     </text-area>
     <text-area points="1035,1068 1033,1019 1039,985 1057,948 1084,924 1126,912 1178,913 1216,928 1243,960 1255,990 1259,1022 1258,1067 1246,1107 1222,1138 1189,1156 1150,1161 1107,1156 1071,1138 1046,1107 1037,1078">
       <p>TAKŽE EXISTUJE PRAVDEPODOBNE NEJAKÝ <emphasis>SAUDSKÝ</emphasis> ALEBO <emphasis>JAPONSKÝ</emphasis> CHALAN ALEBO DIEŤA <emphasis>RUSKEJ</emphasis> MAFIE, KTORÍ SÚ TAK BOHATÍ, ŽE TOTO JE PRE NICH LEN PÁR DROBNÝCH, A ONI NÁM PLATIA, ABY SME <emphasis>BOJOVALI</emphasis> PROTI NEJAKÝM INÝM BOHATÝM.</p></text-area>
     <text-area points="782,1255 1087,1255 1087,1313 782,1313" bgcolor="#f3ff9d" type="commentary">
       <p>"OCÓÓÓ!" PROTESTOVALA BY. "CHODÍM DO TELOCVIČNE KAŽDÝ PREKLIATY DEŇ."</p>
     </text-area>
     <text-area points="547,1459 552,1431 571,1410 603,1395 665,1393 701,1401 729,1418 741,1442 743,1467 737,1488 724,1507 700,1520 668,1527 618,1527 584,1519 560,1502 548,1477">
       <p>PRE NICH SME LEN ROVNAKÍ AKO AFRIČANIA ZARÁBAJÚCI DOLÁR ZA DEŇ ZA VYRÁBANIE ... EHM, ŠITIE TRIČIEK.</p>
     </text-area>
     <text-area points="929,1507 1255,1507 1255,1564 929,1565" bgcolor="#f3ff9d" type="commentary">
       <p>"DOBRE, ANDA. ALE <emphasis>POSNAŽ SA</emphasis> VIACEJ CVIČIŤ, <emphasis>PROSÍM".</emphasis></p>
     </text-area>
     <text-area points="115,1646 120,1626 138,1612 159,1607 199,1607 216,1612 234,1624 240,1640 239,1657 230,1671 212,1681 176,1685 145,1681 127,1673 118,1659">
       <p><emphasis>TO</emphasis> ASI DÁVA ZMYSEL.</p>
     </text-area>
     <text-area points="662,1705 665,1689 682,1676 703,1673 734,1674 758,1679 771,1694 774,1710 762,1727 741,1735 692,1734 671,1725 664,1714">
       <p><emphasis>PEKNE,</emphasis> ANDA.</p>
     </text-area>
     <text-area points="701,1812 704,1796 718,1784 745,1779 772,1781 791,1789 800,1803 800,1821 795,1833 775,1844 749,1845 723,1842 709,1835 701,1821">
       <p>VĎAKA, SERŽANT.</p>
     </text-area>
     <text-area points="1104,1840 1106,1820 1114,1802 1137,1790 1156,1785 1206,1785 1237,1796 1252,1817 1253,1844 1242,1862 1225,1874 1204,1879 1163,1880 1133,1874 1116,1862 1106,1850">
       <p>TERAZ POĎME NÁJSŤ TÚ NOVÚ CHATRČ.</p>
     </text-area>
   </text-layer>
   <frame points="33,52 1294,51 1293,907 718,905 686,877 632,860 560,860 520,864 478,882 453,910 443,910 439,917 439,931 444,940 425,958 403,959 374,947 373,937 376,930 388,921 391,910 34,907"/>
   <frame points="112,906 455,911 478,883 523,865 577,859 636,862 681,876 719,904 725,909 744,913 741,1328 471,1329 452,1344 423,1358 398,1375 385,1378 376,1388 356,1390 339,1396 314,1406 303,1398 308,1375 322,1370 334,1355 342,1350 348,1340 357,1338 361,1326 194,1327 187,1348 172,1348 159,1334 159,1327 114,1327 115,1264 100,1251 91,1227 89,1207 90,1155 96,1127 84,1114 83,1091 91,1077 115,1061"/>
   <frame points="759,909 1101,911 1127,904 1173,906 1203,914 1231,930 1254,971 1263,1005 1266,1065 1253,1108 1237,1135 1247,1134 1247,1164 1236,1187 1220,1206 1203,1208 1202,1327 756,1330"/>
   <frame points="60,1342 1264,1342 1268,1573 54,1579"/>
   <frame points="54,1587 1266,1590 1266,1950 55,1949"/>
  </page>
  <page>
   <image href="08.jpg"/>
   <text-layer lang="en">
     <text-area points="333,880 337,864 347,854 369,847 389,847 409,854 420,862 425,877 423,893 413,905 399,910 377,914 352,909 339,899 334,889">
       <p>BLOODY <emphasis>HELL.</emphasis></p>
     </text-area>
     <text-area points="266,1184 269,1165 283,1148 309,1136 343,1134 374,1135 400,1143 417,1157 426,1174 423,1199 410,1218 377,1231 341,1233 304,1229 282,1219 268,1202">
       <p>THIS IS NUTS! I'M <emphasis>CALLING</emphasis> THEM. THIS IS NUTS.</p>
     </text-area>
     <text-area points="586,836 593,812 620,790 657,778 717,775 780,784 813,805 824,823 825,853 813,873 780,892 741,899 681,901 633,892 600,873 588,852">
       <p>OK, I JUST CALLED IN THREE <emphasis>SQUADS</emphasis> OF FAHRENHEIT VETERANS AND THEIR NOOB APPRENTICES FOR BACKUP.</p>
     </text-area>
     <text-area points="741,1153 746,1135 761,1123 785,1115 829,1117 854,1126 865,1137 870,1158 860,1178 837,1190 811,1192 781,1190 758,1184 743,1167">
       <p>THEY'LL BE HERE IN AN HOUR.</p>
     </text-area>
     <text-area points="1080,1146 1083,1125 1098,1108 1126,1096 1180,1097 1209,1110 1223,1126 1227,1147 1220,1173 1203,1188 1166,1197 1125,1195 1098,1185 1082,1165">
       <p>SARGE, THIS ISN'T A <emphasis>MISSION</emphasis> ANYMORE ...</p>
     </text-area>
     <text-area points="868,1298 1018,1297 1017,1334 868,1334" bgcolor="#fbe2e8" type="commentary">
       <p>" ... IT'S <emphasis>WAR!"</emphasis></p>
     </text-area>
     <text-area points="925,1367 1234,1368 1235,1456 925,1455" bgcolor="#d3dbdd" type="commentary">
       <p>"YEAH! AND I'VE NEGOTIATED A <emphasis>BONUS</emphasis> FOR US IF WE MAKE IT - A MILLION GOLD AND <emphasis>THREE</emphasis> MISSIONS' WORTH OF CASH!"</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="333,880 337,864 347,854 369,847 389,847 409,854 420,862 425,877 423,893 413,905 399,910 377,914 352,909 339,899 334,889">
       <p>DO <emphasis>PEKLA.</emphasis></p>
     </text-area>
     <text-area points="266,1184 269,1165 283,1148 309,1136 343,1134 374,1135 400,1143 417,1157 426,1174 423,1199 410,1218 377,1231 341,1233 304,1229 282,1219 268,1202">
       <p>TOTO JE V RITI! <emphasis>VOLÁM</emphasis> ICH. TOTO JE V RITI.</p>
     </text-area>
     <text-area points="586,836 593,812 620,790 657,778 717,775 780,784 813,805 824,823 825,853 813,873 780,892 741,899 681,901 633,892 600,873 588,852">
       <p>OK, PRÁVE SOM PRIVOLALA TRI <emphasis>DRUŽSTVÁ</emphasis> VETERÁNOV FAHRENHEITU A ICH UČŇOV DO ZÁLOHY.</p>
     </text-area>
     <text-area points="741,1153 746,1135 761,1123 785,1115 829,1117 854,1126 865,1137 870,1158 860,1178 837,1190 811,1192 781,1190 758,1184 743,1167">
       <p>BUDÚ TU ASI ZA HODINU.</p>
     </text-area>
     <text-area points="1080,1146 1083,1125 1098,1108 1126,1096 1180,1097 1209,1110 1223,1126 1227,1147 1220,1173 1203,1188 1166,1197 1125,1195 1098,1185 1082,1165">
       <p>SERŽANT, TOTO UŽ NIE JE <emphasis>MISIA</emphasis> ...</p>
     </text-area>
     <text-area points="868,1298 1018,1297 1017,1334 868,1334" bgcolor="#fbe2e8" type="commentary">
       <p>" ... JE TO <emphasis>VOJNA!"</emphasis></p>
     </text-area>
     <text-area points="925,1367 1234,1368 1235,1456 925,1455" bgcolor="#d3dbdd" type="commentary">
       <p>"JASNE! A VYJEDNALA SOM PRE NÁS <emphasis>BONUS,</emphasis> AK SA NÁM TO PODARÍ - MILIÓN ZLATÝCH A PENIAZE V HODNOTE <emphasis>TROCH</emphasis> SPLNENÝCH MISIÍ!"</p>
     </text-area>
   </text-layer>
   <frame points="43,56 1287,54 1293,827 833,826 814,800 799,789 779,779 754,774 728,772 666,771 622,783 600,799 585,814 582,827 39,826"/>
   <frame points="116,829 562,830 563,1218 418,1218 406,1227 387,1234 368,1237 326,1238 298,1232 280,1224 272,1218 117,1218"/>
   <frame points="574,829 584,829 585,816 591,806 609,790 637,778 644,776 628,732 633,733 665,772 674,759 681,771 713,770 747,772 779,780 794,769 795,784 800,790 853,769 854,772 816,800 825,814 831,827 875,828 876,1114 884,1112 876,1121 877,1217 857,1218 859,1228 855,1226 847,1219 575,1219 576,905 564,908 565,903 574,899"/>
   <frame points="885,830 1209,831 1207,1101 1221,1114 1229,1129 1232,1150 1228,1169 1218,1183 1207,1191 1207,1217 887,1217"/>
   <frame points="37,1224 273,1220 302,1235 329,1240 378,1238 408,1231 423,1219 1286,1219 1289,1967 40,1959"/>
  </page>
  <page>
   <image href="09.jpg"/>
   <text-layer lang="en">
     <text-area points="488,329 493,315 506,303 524,299 553,297 580,305 593,321 594,334 587,350 573,358 542,362 509,358 495,349 488,339">
       <p><strong>GO! GO! GO!</strong></p>
     </text-area>
     <text-area points="950,370 1209,370 1208,493 950,493" bgcolor="#f3ff9d" type="commentary">
       <p>GAMEWAR. <emphasis>HUNDREDS</emphasis> OF FAHRENHEITS CONVERGING ON THIS SHARD, SQUARING OFF AGAINST THE RANKED <emphasis>MERCENARIES</emphasis> GUARDING THE COTTAGE.</p></text-area>
     <text-area points="960,1012 1196,1011 1196,1099 960,1100" bgcolor="#f3ff9d" type="commentary">
       <p>THE VOICE CHAT WAS LIKE A <emphasis>WIND-TUNNEL</emphasis> FROM ALL THE UNMUTED, BREATHING <emphasis>VOICES.</emphasis></p>
     </text-area>
     <text-area points="90,1451 418,1451 418,1521 91,1521" bgcolor="#f3ff9d" type="commentary">
       <p>HUNDREDS OF <emphasis>GIRLS</emphasis> IN HUNDREDS OF BEDROOMS LIKE ANDA'S, ALL OVER THE <emphasis>WORLD.</emphasis></p></text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="488,329 493,315 506,303 524,299 553,297 580,305 593,321 594,334 587,350 573,358 542,362 509,358 495,349 488,339">
       <p><strong>POME! POME! POME!</strong></p>
     </text-area>
     <text-area points="950,370 1209,370 1208,493 950,493" bgcolor="#f3ff9d" type="commentary">
       <p>VOJNA. <emphasis>STOVKY</emphasis> Z KLANU FAHRENHEIT ZBIEHAJÚCICH SA NA TOMTO KÚSKU ZEME, STOJACICH OPROTI ZORADENÝM <emphasis>ŽOLDNIEROM</emphasis> BRÁNIACICH CHATRČ.</p></text-area>
     <text-area points="960,1012 1196,1011 1196,1099 960,1100" bgcolor="#f3ff9d" type="commentary">
       <p>HLASOVÝ HOVOR BOL AKO <emphasis>VETERNÝ TUNEL</emphasis> TVORENÝ VŠETKÝMI NEZTLMENÝMI DÝCHAJÚCIMI <emphasis>HLASMI.</emphasis></p>
     </text-area>
     <text-area points="90,1451 418,1451 418,1521 91,1521" bgcolor="#f3ff9d" type="commentary">
       <p>STOVKY <emphasis>DIEVČAT</emphasis> V STOVKÁCH DETSKÝCH IZIEB AKO TÁ ANDINA, PO CELOM <emphasis>SVETE.</emphasis></p>
     </text-area>
   </text-layer>
   <frame points="57,75 200,74 214,60 234,50 254,50 254,55 234,67 228,73 324,74 429,49 588,50 585,55 526,73 719,72 761,60 772,62 770,67 763,73 1265,73 1269,535 819,566 364,602 57,620 55,174 44,172 37,154 40,132 56,123"/>
   <frame points="34,634 317,616 346,606 350,611 351,613 726,588 726,584 718,584 714,580 716,573 730,572 735,565 737,559 750,557 753,561 755,552 759,546 770,542 775,544 782,539 791,540 795,545 806,546 805,551 816,552 819,558 819,566 816,572 816,579 1292,547 1295,1177 863,1139 323,1089 60,1070 60,1057 68,1048 78,1043 57,1041 47,1045 40,1039 32,1020 54,999 66,999 77,995 61,977 49,976 39,963 53,950 37,950 33,942"/>
   <frame points="56,1076 1267,1183 1269,1562 1199,1557 757,1558 53,1560"/>
   <frame points="114,1560 1202,1557 1203,1946 115,1942"/>
  </page>
  <page>
   <image href="10.jpg"/>
   <text-layer lang="en">
     <text-area points="138,179 315,179 315,285 138,287" bgcolor="#f3ff9d" type="commentary">
       <p>THE FAHRENHEIT'S GREATER NUMBERS AND DISCIPLINE WERE OVERWHELMING.</p>
     </text-area>
     <text-area points="749,177 969,176 969,235 749,235" bgcolor="#f3ff9d" type="commentary">
       <p>EVERY MERC WAS EVENTUALLY RUN OFF.</p>
     </text-area>
     <text-area points="142,741 313,741 313,779 143,780" bgcolor="#f3ff9d" type="commentary">
       <p>OR <emphasis>BUTCHERED.</emphasis></p>
     </text-area>
     <text-area points="372,785 378,760 399,741 433,730 483,732 517,742 533,758 539,781 537,803 527,820 506,834 478,841 427,840 401,831 381,817 374,799">
       <p>OK, I PAID OFF ALL THE SQUADS. THEY'RE HEADING BACK TO BASE.</p>
     </text-area>
     <text-area points="573,798 579,779 596,765 627,754 676,753 712,761 733,776 740,794 739,813 727,831 701,844 663,847 627,847 594,836 577,820">
       <p>MAN, THAT WAS <emphasis>BUGFUCK</emphasis> NUTSO! BUT WE <emphasis>MADE IT!</emphasis></p>
     </text-area>
     <text-area points="421,1472 427,1451 444,1436 468,1431 497,1431 520,1439 535,1452 540,1472 536,1492 521,1506 498,1512 466,1515 438,1506 425,1491">
       <p>NOW WE TAKE THE COTTAGE.</p>
     </text-area>
     <text-area points="295,1781 299,1760 319,1745 346,1738 393,1739 415,1745 432,1761 437,1781 430,1804 404,1821 363,1824 332,1822 308,1812 296,1796">
       <p>RIGHT. BUT LET ME FIRST <emphasis>SCRY</emphasis> THE -</p>
     </text-area>
     <text-area points="749,1470 754,1446 775,1428 808,1422 851,1425 875,1436 887,1456 888,1481 879,1499 862,1511 837,1517 792,1517 764,1504 751,1487">
       <p>I'LL BE GLAD WHEN WE'RE DONE WITH THIS.</p>
     </text-area>
     <text-area points="993,1774 998,1760 1019,1752 1043,1754 1058,1763 1061,1776 1054,1792 1034,1798 1010,1797 995,1785">
       <p>HEY!</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="138,179 315,179 315,285 138,287" bgcolor="#f3ff9d" type="commentary">
       <p>OBROVSKÉ POČTY KLANU FAHRENHEIT A ICH DISCIPLÍNA BOLI OHROMUJÚCE.</p>
     </text-area>
     <text-area points="749,177 969,176 969,235 749,235" bgcolor="#f3ff9d" type="commentary">
       <p>KAŽDÝ ŽOLDNIER MUSEL NAPOKON UTIECŤ.</p>
     </text-area>
     <text-area points="142,741 313,741 313,779 143,780" bgcolor="#f3ff9d" type="commentary">
       <p>ALEBO <emphasis>BOL ZABITÝ.</emphasis></p>
     </text-area>
     <text-area points="372,785 378,760 399,741 433,730 483,732 517,742 533,758 539,781 537,803 527,820 506,834 478,841 427,840 401,831 381,817 374,799">
       <p>OK, ZAPLATILA SOM NAŠIM A UŽ SÚ NA CESTE SPÄŤ NA ZÁKLADŇU.</p>
     </text-area>
     <text-area points="573,798 579,779 596,765 627,754 676,753 712,761 733,776 740,794 739,813 727,831 701,844 663,847 627,847 594,836 577,820">
       <p>ČLOVEČE, TO BOLO <emphasis>SAKRA</emphasis> BRUTÁLNE! ALE <emphasis>DOKÁZALI SME TO!</emphasis></p>
     </text-area>
     <text-area points="421,1472 427,1451 444,1436 468,1431 497,1431 520,1439 535,1452 540,1472 536,1492 521,1506 498,1512 466,1515 438,1506 425,1491">
       <p>TERAZ MÔŽME DOBYŤ CHATRČ.</p>
     </text-area>
     <text-area points="295,1781 299,1760 319,1745 346,1738 393,1739 415,1745 432,1761 437,1781 430,1804 404,1821 363,1824 332,1822 308,1812 296,1796">
       <p>JASNE. ALE NECHAJ MA NAJSKÔR <emphasis>PREHLIADNUŤ</emphasis> -</p>
     </text-area>
     <text-area points="749,1470 754,1446 775,1428 808,1422 851,1425 875,1436 887,1456 888,1481 879,1499 862,1511 837,1517 792,1517 764,1504 751,1487">
       <p>BUDEM RADA, KEĎ TO UŽ BUDEME MAŤ ZA SEBOU.</p>
     </text-area>
     <text-area points="993,1774 998,1760 1019,1752 1043,1754 1058,1763 1061,1776 1054,1792 1034,1798 1010,1797 995,1785">
       <p>HEJ!</p>
     </text-area>
   </text-layer>
   <frame points="119,155 611,155 611,719 116,716"/>
   <frame points="724,155 1213,157 1212,718 723,718"/>
   <frame points="41,720 1293,721 1292,1399 43,1402"/>
   <frame points="116,1404 652,1404 653,1839 114,1836"/>
   <frame points="722,1406 1209,1403 1208,1839 720,1837"/>
  </page>
  <page>
   <image href="11.jpg"/>
   <text-layer lang="en">
     <text-area points="499,793 506,774 528,763 559,761 586,768 600,781 600,803 591,817 571,826 536,826 516,821 502,809">
       <p>SHIT! I'M <emphasis>DEAD.</emphasis></p>
     </text-area>
     <text-area points="425,1146 431,1117 446,1095 478,1077 530,1070 582,1073 621,1087 643,1111 652,1138 650,1167 638,1192 613,1211 580,1220 537,1223 497,1221 458,1208 433,1183 427,1163">
       <p>TEACH YOU TO GO <emphasis>RUSHING</emphasis> INTO THINGS. IF YOU'D JUST LET ME SCRY THE COTTAGE, I WOULD HAVE DETECTED THE <emphasis>DOOR-CURSE.</emphasis></p></text-area>
     <text-area points="712,808 717,780 737,758 768,745 802,739 844,740 891,749 920,772 928,792 930,818 920,845 898,864 854,876 818,877 773,873 741,862 719,839 712,815">
       <p>WELL, LOOKS LIKE IT'S <emphasis>CLEAR</emphasis> NOW. JUST <emphasis>MILLIONS</emphasis> OF SHIRTS AND <emphasis>THOUSANDS</emphasis> OF NOOBS TO KILL.</p>
     </text-area>
     <text-area points="307,1317 313,1294 329,1279 356,1272 386,1273 410,1284 423,1304 422,1330 408,1350 384,1359 351,1360 327,1353 312,1338">
       <p>HERE WE GO AGAIN. *YAWN*</p>
     </text-area>
     <text-area points="817,1280 826,1272 1001,1272 1012,1280 1012,1326 1000,1335 825,1334 816,1324" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; wait, please, don't -</p>
     </text-area>
     <text-area points="938,1774 948,1763 1177,1765 1187,1773 1187,1851 1177,1859 949,1860 937,1850" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; there are many here to kill, take me last. I need to talk to you.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="499,793 506,774 528,763 559,761 586,768 600,781 600,803 591,817 571,826 536,826 516,821 502,809">
       <p>SAKRA! SOM <emphasis>MŔTVA.</emphasis></p>
     </text-area>
     <text-area points="425,1146 431,1117 446,1095 478,1077 530,1070 582,1073 621,1087 643,1111 652,1138 650,1167 638,1192 613,1211 580,1220 537,1223 497,1221 458,1208 433,1183 427,1163">
       <p>TO ŤA ODNAUČÍ <emphasis>PONÁHĽAŤ SA.</emphasis> KEBY SI MA LEN NECHALA PREHLIADNUŤ TÚ CHATRČ, ZISTILA BY SOM <emphasis>KLIATBU NA DVERÁCH.</emphasis></p></text-area>
     <text-area points="712,808 717,780 737,758 768,745 802,739 844,740 891,749 920,772 928,792 930,818 920,845 898,864 854,876 818,877 773,873 741,862 719,839 712,815">
       <p>HMM, VYZERÁ TO UŽ <emphasis>BEZPEČNÉ.</emphasis> IBA <emphasis>MILIÓNY</emphasis> KOŠIEL A <emphasis>TISÍCKY</emphasis> AMATÉROV NA ZABITIE.</p>
     </text-area>
     <text-area points="307,1317 313,1294 329,1279 356,1272 386,1273 410,1284 423,1304 422,1330 408,1350 384,1359 351,1360 327,1353 312,1338">
       <p>IDEME NA TO. *ÁÁCH*</p>
     </text-area>
     <text-area points="817,1280 826,1272 1001,1272 1012,1280 1012,1326 1000,1335 825,1334 816,1324" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; počkaj, prosím, nerob to -</p>
     </text-area>
     <text-area points="938,1774 948,1763 1177,1765 1187,1773 1187,1851 1177,1859 949,1860 937,1850" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; je tu veľa iných, ktorých môžeš zabiť, mňa zabi posledného. Potrebujem sa s tebou porozprávať.</p>
     </text-area>
   </text-layer>
   <frame points="56,102 498,103 495,720 60,714"/>
   <frame points="524,101 1270,101 1270,715 508,714 508,571 518,563 518,535 511,529 511,488 503,457 519,454 519,442 514,437 511,411 519,408 518,396 510,388 510,378 520,375 517,364 504,354 505,326 516,328 520,303 505,295 511,283 518,270 516,250 507,242 509,232 518,231 519,221 508,213 511,199 504,193 502,181 516,175 506,169 510,160 507,145 511,137 505,127 514,118 516,109"/>
   <frame points="118,714 672,716 673,1237 116,1233"/>
   <frame points="687,717 1208,717 1207,1237 688,1236"/>
   <frame points="110,1244 778,1244 781,1881 105,1881"/>
   <frame points="790,1252 1207,1250 1210,1885 784,1882"/>
  </page>
  <page>
   <image href="12.jpg"/>
   <text-layer lang="en" bgcolor="#11161a">
     <text-area points="282,180 287,174 435,174 441,180 441,224 434,230 290,230 283,225" type="code" inverted="True">
       <p>&gt; talk, then</p>
     </text-area>
     <text-area points="168,541 176,531 454,531 462,539 461,629 453,641 177,640 169,633" type="code" inverted="True">
       <p>&gt; my name is raymond, and I live in tijuana. I am a labor organizer in the factories here.</p>
     </text-area>
     <text-area points="860,202 1156,202 1156,264 859,263" type="code" inverted="True">
       <p>&gt; do you know who these people are that you're killing?</p>
     </text-area>
     <text-area points="826,277 897,276 897,315 827,315" type="code" inverted="True">
       <p>&gt; no</p>
     </text-area>
     <text-area points="858,345 1156,345 1156,574 857,574" type="code" inverted="True">
       <p>&gt; they're working for less then a dollar a day. the shirts they make are traded for gold and the gold is sold on ebay. they're mostly young girls supporting their families. they're the lucky ones: unlucky ones work as prostitutes.</p>
     </text-area>
     <text-area points="141,729 472,729 472,887 141,887" type="code" inverted="True">
       <p>&gt; the bosses used to use bots, but the game has countermeasures against them. hiring children to click the mouse is cheaper than hiring programmers to circumvent the rules.</p>
     </text-area>
     <text-area points="142,892 470,892 470,1029 143,1029" type="code" inverted="True">
       <p>&gt; I've been trying to unionize them because they've got a very high rate of injury. they have to play for 18-hour shifts with only one short toilet break.</p>
     </text-area>
     <text-area points="546,890 554,880 737,879 746,890 746,995 737,1003 556,1003 547,993" type="code" inverted="True">
       <p>&gt; some of them can't hold it in and they soil themselves where they sit.</p>
     </text-area>
     <text-area points="631,1057 643,1046 874,1046 884,1060 883,1172 874,1185 643,1183 629,1175" type="code" inverted="True">
       <p>&gt; look, it's none of my lookout, is it? the world's like that. I'm just a kid, there's nothing I can do about it.</p>
     </text-area>
     <text-area points="120,1266 130,1257 271,1257 281,1268 281,1408 270,1419 131,1419 121,1411" type="code" inverted="True">
       <p>&gt; when you kill them, they don't get paid. they lose their day's wages.</p>
     </text-area>
     <text-area points="149,1734 156,1726 384,1726 392,1735 394,1804 386,1812 162,1813 149,1806" type="code" inverted="True">
       <p>&gt; do you know who is paying you to do these killings?</p>
     </text-area>
     <text-area points="833,1273 1002,1274 1001,1313 834,1311" type="code" inverted="True">
       <p>&gt; not a clue</p>
     </text-area>
     <text-area points="871,1339 1155,1339 1155,1388 871,1388" type="code" inverted="True">
       <p>&gt; I've been trying to find that out myself.</p>
     </text-area>
     <text-area points="871,1415 933,1415 933,1445 871,1445" type="code" inverted="True">
       <p>&gt; ...</p>
     </text-area>
     <text-area points="870,1477 1156,1477 1156,1525 871,1525" type="code" inverted="True">
       <p>&gt; ah. I see. I am the only one remaining.</p>
     </text-area>
     <text-area points="870,1560 1156,1560 1156,1605 871,1605" type="code" inverted="True">
       <p>&gt; go ahead. I will see you again, I'm sure.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk" bgcolor="#11161a">
     <text-area points="282,180 287,174 435,174 441,180 441,224 434,230 290,230 283,225" type="code" inverted="True">
       <p>&gt; hovor, teda</p>
     </text-area>
     <text-area points="168,541 176,531 454,531 462,539 461,629 453,641 177,640 169,633" type="code" inverted="True">
       <p>&gt; moje meno je Raymond, a žijem v Tijuana. Som organizátor práce v tunajších továrňach.</p>
     </text-area>
     <text-area points="860,202 1156,202 1156,264 859,263" type="code" inverted="True">
       <p>&gt; vieš, kto sú títo ľudia, ktorých zabíjaš?</p>
     </text-area>
     <text-area points="826,277 897,276 897,315 827,315" type="code" inverted="True">
       <p>&gt; nie</p>
     </text-area>
     <text-area points="858,345 1156,345 1156,574 857,574" type="code" inverted="True">
       <p>&gt; oni pracujú za menej ako jeden dolár na deň. Košele, ktoré vyrobia, sa predávajú za zlato a to sa potom predáva na ebay-i. Sú to vačšinou mladé dievčatá podporujúce svoje rodiny. To sú tie štastnejšie: tie menej štastné pracujú ako prostitútky.</p>
     </text-area>
     <text-area points="141,729 472,729 472,887 141,887" type="code" inverted="True">
       <p>&gt; bosovia najskôr používali automatické skripty, ale hra má proti tomu protiopatrenia. Najímanie detí na klikanie myšou je lacnejšie než najímanie programátorov na obídenie pravidiel.</p>
     </text-area>
     <text-area points="142,892 470,892 470,1029 143,1029" type="code" inverted="True">
       <p>&gt; pokúšam sa ich zjednotiť pretože majú veľkú mieru zranení. Musia hrať v 18-hodinových smenách len s jednou prestávkou na záchod.</p>
     </text-area>
     <text-area points="546,890 554,880 737,879 746,890 746,995 737,1003 556,1003 547,993" type="code" inverted="True">
       <p>&gt; niektoré z nich to nevydržia a pustia to zo seba tam, kde práve sedia.</p>
     </text-area>
     <text-area points="631,1057 643,1046 874,1046 884,1060 883,1172 874,1185 643,1183 629,1175" type="code" inverted="True">
       <p>&gt; pozri, to nie je moja vec, že? Svet je proste taký. Ja som len decko, nedokážem s tým nič spraviť.</p>
     </text-area>
     <text-area points="120,1266 130,1257 271,1257 281,1268 281,1408 270,1419 131,1419 121,1411" type="code" inverted="True">
       <p>&gt; keď ich zabiješ, nedostanú zaplatené. Stratia plat za celý deň.</p>
     </text-area>
     <text-area points="149,1734 156,1726 384,1726 392,1735 394,1804 386,1812 162,1813 149,1806" type="code" inverted="True">
       <p>&gt; vieš, kto ti platí za ich zabíjanie?</p>
     </text-area>
     <text-area points="833,1273 1002,1274 1001,1313 834,1311" type="code" inverted="True">
       <p>&gt; nemám potuchy</p>
     </text-area>
     <text-area points="871,1339 1155,1339 1155,1388 871,1388" type="code" inverted="True">
       <p>&gt; snažil som sa to zistiť aj ja sám.</p>
     </text-area>
     <text-area points="871,1415 933,1415 933,1445 871,1445" type="code" inverted="True">
       <p>&gt; ...</p>
     </text-area>
     <text-area points="870,1477 1156,1477 1156,1525 871,1525" type="code" inverted="True">
       <p>&gt; ach. Jasne. Zostal som už iba ja.</p>
     </text-area>
     <text-area points="870,1560 1156,1560 1156,1605 871,1605" type="code" inverted="True">
       <p>&gt; pokračuj. Uvidíme sa znova, som si istý.</p>
     </text-area>
   </text-layer>
   <frame points="107,156 760,157 763,665 166,665 110,659"/>
   <frame points="810,192 824,180 1156,181 1172,193 1173,619 1166,632 1154,639 823,638 815,632 809,621"/>
   <frame points="126,724 136,715 147,712 472,713 482,719 486,730 484,1171 480,1181 470,1186 139,1186 130,1180 126,1171"/>
   <frame points="518,680 1201,681 1202,1211 521,1213"/>
   <frame points="107,1225 769,1227 772,1845 107,1844"/>
   <frame points="814,1278 818,1266 831,1259 1158,1260 1168,1266 1173,1280 1173,1793 1169,1809 1158,1818 828,1818 818,1810 812,1796"/>
  </page>
  <page>
   <image href="13.jpg"/>
   <text-layer lang="en">
     <text-area points="820,164 824,151 842,142 870,142 890,148 899,163 894,177 880,185 851,187 830,182 822,173">
       <p>LUCY?</p>
     </text-area>
     <text-area points="725,323 731,294 749,275 777,261 823,257 862,263 888,274 907,296 913,324 907,353 888,376 854,389 804,391 763,382 737,362 727,339">
       <p>YEAH, HANG ON. I'M ALMOST BACK THERE. I <emphasis>RESPAWNED</emphasis> IN THE <emphasis>ASS END</emphasis> OF NOWHERE.</p>
     </text-area>
     <text-area points="771,530 775,503 787,486 813,471 848,466 889,469 912,479 929,495 938,522 936,549 925,571 907,586 875,595 832,595 800,586 780,568 771,545">
       <p>LUCY, DO YOU KNOW WHO'S IN THE COTTAGE? THOSE NOOBS THAT WE KILL?</p>
     </text-area>
     <text-area points="141,741 147,713 169,692 200,682 241,683 270,693 286,710 295,731 293,760 285,776 269,792 237,802 200,802 166,792 147,769">
       <p>WHAT? HELL, NO. NOOBS. SOMEONE'S <emphasis>BUTLER.</emphasis> I DUNNO.</p>
     </text-area>
     <text-area points="358,716 365,687 387,663 426,653 470,654 502,663 523,680 532,704 532,730 526,750 504,770 478,777 443,780 405,776 378,762 362,741">
       <p><emphasis>GIRLS.</emphasis> LITTLE GIRLS IN MEXICO. GETTING PAID A DOLLAR A DAY TO CRAFT SHIRTS.</p>
     </text-area>
     <text-area points="500,818 508,796 520,783 549,773 586,770 632,774 662,785 676,806 678,828 669,847 652,860 616,867 565,868 532,861 509,844 501,829">
       <p>EXCEPT THEY DON'T GET <emphasis>ANYTHING</emphasis> WHEN WE KILL THEM.</p>
     </text-area>
     <text-area points="568,1105 573,1081 590,1062 621,1048 668,1042 712,1046 744,1053 768,1068 780,1091 778,1123 765,1142 730,1160 690,1165 642,1163 602,1155 576,1134 569,1116">
       <p>OH, FOR <emphasis>CHRISSAKES,</emphasis> IS THAT WHAT ONE OF THEM TOLD YOU? AND YOU <emphasis>BELIEVED</emphasis> IT?</p>
     </text-area>
     <text-area points="151,1392 156,1372 173,1358 200,1352 232,1353 256,1361 270,1375 274,1393 269,1412 251,1427 226,1432 189,1431 163,1421 151,1405">
       <p>YOU DON'T THINK IT'S <emphasis>TRUE?</emphasis></p>
     </text-area>
     <text-area points="466,1444 474,1418 493,1402 521,1393 579,1393 607,1400 627,1413 637,1434 637,1457 627,1474 606,1488 585,1494 543,1497 513,1493 487,1483 473,1469 468,1455">
       <p>NAW, I DON'T. NOW KEEP YOUR PANTIES ON, I'M ALMOST -</p>
     </text-area>
     <text-area points="468,1655 472,1637 490,1624 519,1618 552,1620 578,1631 586,1653 583,1671 571,1685 546,1691 502,1691 480,1681 469,1666">
       <p>I'VE GOT TO GO, LUCY.</p>
     </text-area>
     <text-area points="710,1354 713,1336 727,1323 752,1312 796,1310 831,1317 849,1329 858,1351 853,1372 838,1385 816,1394 762,1396 737,1390 717,1375 710,1362">
       <p>WHAT, <emphasis>NOW?</emphasis> SHIT, JUST HANG -</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="820,164 824,151 842,142 870,142 890,148 899,163 894,177 880,185 851,187 830,182 822,173">
       <p>LUCY?</p>
     </text-area>
     <text-area points="725,323 731,294 749,275 777,261 823,257 862,263 888,274 907,296 913,324 907,353 888,376 854,389 804,391 763,382 737,362 727,339">
       <p>ÁNO, POČKAJ. UŽ SOM SKORO SPÄŤ. <emphasis>OŽIVILO MA</emphasis> V PREKLIATEJ <emphasis>DIERE</emphasis> NIEKDE V RITI ĎALEKO.</p>
     </text-area>
     <text-area points="771,530 775,503 787,486 813,471 848,466 889,469 912,479 929,495 938,522 936,549 925,571 907,586 875,595 832,595 800,586 780,568 771,545">
       <p>LUCY, VIEŠ KTO JE V TÝCH CHATRČIACH? TÍ AMATÉRI, KTORÝCH ZABÍJAME?</p>
     </text-area>
     <text-area points="141,741 147,713 169,692 200,682 241,683 270,693 286,710 295,731 293,760 285,776 269,792 237,802 200,802 166,792 147,769">
       <p>ČO? DO PEKLA, NIE. AMATÉRI. NIEKOHO <emphasis>SLUHOVIA.</emphasis> NEVIEM.</p>
     </text-area>
     <text-area points="358,716 365,687 387,663 426,653 470,654 502,663 523,680 532,704 532,730 526,750 504,770 478,777 443,780 405,776 378,762 362,741">
       <p><emphasis>DIEVČATÁ.</emphasis> MALÉ DIEVČATÁ V MEXIKU. DOSTÁVAJÚ JEDEN DOLÁR NA DEŇ ZA VYRÁBANIE KOŠIEL.</p>
     </text-area>
     <text-area points="500,818 508,796 520,783 549,773 586,770 632,774 662,785 676,806 678,828 669,847 652,860 616,867 565,868 532,861 509,844 501,829">
       <p>AŽ NA TO, ŽE NEDOSTANÚ <emphasis>NIČ,</emphasis> KEĎ ICH ZABIJEME.</p>
     </text-area>
     <text-area points="568,1105 573,1081 590,1062 621,1048 668,1042 712,1046 744,1053 768,1068 780,1091 778,1123 765,1142 730,1160 690,1165 642,1163 602,1155 576,1134 569,1116">
       <p>ÁCH, PRE <emphasis>KRISTAPÁNA,</emphasis> TO TI JEDEN Z NICH POVEDAL? A TY SI MU <emphasis>UVERILA?</emphasis></p>
     </text-area>
     <text-area points="151,1392 156,1372 173,1358 200,1352 232,1353 256,1361 270,1375 274,1393 269,1412 251,1427 226,1432 189,1431 163,1421 151,1405">
       <p>NEMYSLÍŠ SI, ŽE JE TO <emphasis>PRAVDA?</emphasis></p>
     </text-area>
     <text-area points="466,1444 474,1418 493,1402 521,1393 579,1393 607,1400 627,1413 637,1434 637,1457 627,1474 606,1488 585,1494 543,1497 513,1493 487,1483 473,1469 468,1455">
       <p>NIE, NEMYSLÍM. TERAZ SA PRIPRAV , UŽ SOM TAKMER -</p>
     </text-area>
     <text-area points="468,1655 472,1637 490,1624 519,1618 552,1620 578,1631 586,1653 583,1671 571,1685 546,1691 502,1691 480,1681 469,1666">
       <p>MUSÍM UŽ ÍSŤ, LUCY.</p>
     </text-area>
     <text-area points="710,1354 713,1336 727,1323 752,1312 796,1310 831,1317 849,1329 858,1351 853,1372 838,1385 816,1394 762,1396 737,1390 717,1375 710,1362">
       <p>ČO, <emphasis>TERAZ?</emphasis> SAKRA, POČKAJ -</p>
     </text-area>
   </text-layer>
   <frame points="111,128 737,127 737,279 730,287 725,297 721,310 720,329 722,338 725,351 730,361 734,366 736,385 737,616 111,615"/>
   <frame points="706,395 734,367 725,353 721,334 720,312 730,289 740,276 759,263 769,260 755,209 760,208 786,256 791,243 795,244 799,253 841,252 864,257 876,262 885,253 887,256 888,268 892,270 903,266 908,240 859,191 835,189 819,178 816,166 817,152 831,140 848,137 878,137 894,143 904,155 904,171 896,185 880,190 884,197 907,224 912,212 930,198 985,163 993,166 1023,151 1031,153 1039,158 1057,156 1079,151 1095,158 1109,166 1205,134 1204,617 756,616 752,381 744,377 710,398"/>
   <frame points="32,615 1241,617 1293,616 1292,1296 36,1296"/>
   <frame points="108,1434 147,1410 145,1396 146,1376 159,1359 188,1348 237,1347 263,1357 279,1372 279,1393 307,1354 462,1433 465,1421 477,1405 497,1393 504,1392 493,1354 502,1352 522,1384 528,1376 533,1380 536,1386 581,1388 604,1393 612,1386 617,1386 617,1398 620,1401 651,1387 655,1393 635,1412 642,1422 644,1442 643,1460 636,1475 623,1487 604,1494 612,1512 629,1521 630,1546 595,1545 566,1553 549,1568 529,1590 516,1611 545,1612 568,1616 582,1627 593,1644 592,1669 583,1683 567,1693 547,1699 505,1698 502,1812 108,1810"/>
   <frame points="676,1300 739,1300 731,1272 736,1272 753,1299 1202,1300 1201,1813 861,1812 671,1813"/>
  </page>
  <page>
   <image href="14.jpg"/>
   <text-layer lang="en">
     <text-area points="238,143 242,121 255,104 278,91 323,85 368,91 392,105 406,131 406,158 391,184 365,197 328,203 293,200 263,190 245,173">
       <p>GOSH, YOU'RE <emphasis>DIRTY.</emphasis> HOW DID YOU GET TO BE SUCH A <emphasis>MUCKY PUPPY?</emphasis></p>
     </text-area>
     <text-area points="85,530 88,516 105,505 129,499 162,501 187,511 195,528 191,544 174,553 143,559 109,555 90,544">
       <p>MUM, <strong>OWWWW</strong>!</p>
     </text-area>
     <text-area points="439,127 443,109 458,92 486,83 535,83 564,94 578,116 578,146 566,161 544,172 509,176 470,172 446,155 439,138">
       <p>YOU ARE FILTHY. WHAT <emphasis>IS</emphasis> THIS MESS?</p>
     </text-area>
     <text-area points="654,141 662,114 680,95 715,84 748,82 799,89 825,103 837,122 840,151 831,175 808,191 769,201 718,200 682,189 660,169">
       <p>LILLIAN, <emphasis>LEAVE OFF.</emphasis> IT'S A SKIN CONDITION. <emphasis>ACANTHOSIS NIGRICANS.</emphasis></p>
     </text-area>
     <text-area points="888,144 894,127 911,114 938,110 971,115 987,127 993,147 986,171 969,185 932,189 900,179 889,162">
       <p>SAW IT IN A TV SPECIAL.</p>
     </text-area>
     <text-area points="1075,491 1081,462 1098,439 1127,426 1161,422 1205,425 1240,439 1259,468 1263,491 1256,526 1235,548 1203,560 1166,561 1119,555 1088,534 1077,509">
       <p>OH, DARLING, I'M <emphasis>SORRY.</emphasis> WE'LL SEE THE <emphasis>DOCTOR</emphasis> ABOUT IT TOMORROW AFTER SCHOOL.</p>
     </text-area>
     <text-area points="504,668 510,646 530,633 555,629 583,636 597,649 601,668 597,689 582,704 556,709 530,706 511,693 505,679">
       <p>ARE YOU ALL RIGHT?</p>
     </text-area>
     <text-area points="843,650 851,628 878,615 902,612 936,617 955,628 964,649 958,669 940,683 903,688 868,683 850,672 844,659">
       <p>I'M <emphasis>FINE.</emphasis> GOING TO BED.</p>
     </text-area>
     <text-area points="107,1105 455,1032 465,1186 131,1265" text-rotation="12">
       <p>"A condition involving darkened, thickened skin. Found in the folds of skin at the base of the back of the neck, under the arms, inside the elbow and at the waistline. Often precedes a diagnosis of type-2 diabetes, especially in children. If found in children, immediate steps must be taken to prevent diabetes, including exercise and nutrition as a means of lowering insulin levels and increasing insulin-sensitivity.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="238,143 242,121 255,104 278,91 323,85 368,91 392,105 406,131 406,158 391,184 365,197 328,203 293,200 263,190 245,173">
       <p>JEŽIŠI, SI <emphasis>ŠPINAVÁ.</emphasis> AKO SI SA MOHLA TAKTO <emphasis>ZAPRASAČIŤ?</emphasis></p>
     </text-area>
     <text-area points="85,530 88,516 105,505 129,499 162,501 187,511 195,528 191,544 174,553 143,559 109,555 90,544">
       <p>MAMI, <strong>AÚÚÚ</strong>!</p>
     </text-area>
     <text-area points="439,127 443,109 458,92 486,83 535,83 564,94 578,116 578,146 566,161 544,172 509,176 470,172 446,155 439,138">
       <p>SI STRAŠNE ŠPINAVÁ. ČO TO <emphasis>JE?</emphasis></p>
     </text-area>
     <text-area points="654,141 662,114 680,95 715,84 748,82 799,89 825,103 837,122 840,151 831,175 808,191 769,201 718,200 682,189 660,169">
       <p>LILLIAN, <emphasis>NECHAJ JU.</emphasis> JE TO KOŽNÝ PROBLÉM. <emphasis>ACANTHOSIS NIGRICANS.</emphasis></p>
     </text-area>
     <text-area points="888,144 894,127 911,114 938,110 971,115 987,127 993,147 986,171 969,185 932,189 900,179 889,162">
       <p>VIDEL SOM TO V TV ŠPECIÁLI.</p>
     </text-area>
     <text-area points="1075,491 1081,462 1098,439 1127,426 1161,422 1205,425 1240,439 1259,468 1263,491 1256,526 1235,548 1203,560 1166,561 1119,555 1088,534 1077,509">
       <p>ACH, ZLATO, JE MI TO <emphasis>ĽÚTO.</emphasis> POJDEME S TÝM K <emphasis>DOKTOROVI</emphasis> ZAJTRA PO ŠKOLE.</p>
     </text-area>
     <text-area points="504,668 510,646 530,633 555,629 583,636 597,649 601,668 597,689 582,704 556,709 530,706 511,693 505,679">
       <p>SI V PORIADKU?</p>
     </text-area>
     <text-area points="843,650 851,628 878,615 902,612 936,617 955,628 964,649 958,669 940,683 903,688 868,683 850,672 844,659">
       <p>JE MI <emphasis>FAJN.</emphasis> IDEM DO POSTELE.</p>
     </text-area>
     <text-area points="107,1105 455,1032 465,1186 131,1265" text-rotation="12">
       <p>"Stav zahŕňajúci ztmavenú, zhrubnutú kožu. Nachádza sa v záhyboch kože na úpätí krku, pod ramenami, v lakti a v oblasti pása. Častokrát predchádza diagnóze diabetes typu 2, obzvlášť u detí. Ak objavené u detí, okamžité kroky musia byť podniknuté na zabránenie diabetes, vrátane cvičení a zmeny stravy za účelom zníženia hodnôt inzulínu a zvýšenia citlivosti na inzulín.</p>
     </text-area>
   </text-layer>
   <frame points="63,75 416,75 419,581 72,579 63,420"/>
   <frame points="416,68 638,67 641,602 419,601 419,580"/>
   <frame points="638,75 1277,74 1277,587 640,582"/>
   <frame points="65,597 419,597 419,601 640,602 641,598 1279,600 1281,849 64,845"/>
   <frame points="64,978 251,945 320,856 520,858 519,1354 64,1354"/>
   <frame points="535,858 1280,862 1283,1356 531,1356"/>
   <frame points="62,1590 359,1367 1283,1372 1282,1930 66,1934"/>
  </page>
  <page>
   <image href="15.jpg"/>
   <text-layer lang="en">
     <text-area points="150,423 451,423 451,498 151,499" bgcolor="#f3ff9d" type="commentary">
       <p>THE <emphasis>PC BAANG</emphasis> WAS FILLED WITH STINKY, SPOTTY BOYS, BEING <emphasis>LOUD</emphasis> AND <emphasis>OBNOXIOUS.</emphasis></p>
     </text-area>
     <text-area points="293,531 506,531 507,563 293,563" bgcolor="#f3ff9d" type="commentary">
       <p>BUT IT DIDN'T MATTER.</p>
     </text-area>
     <text-area points="571,119 737,120 737,174 571,175" bgcolor="#f3ff9d" type="commentary">
       <p>ANDA WAS BACK IN THE <emphasis>GAME.</emphasis></p>
     </text-area>
     <text-area points="665,277 668,255 683,239 710,226 759,225 786,230 808,242 821,260 822,282 813,302 790,318 769,324 722,324 691,317 673,302 666,289">
       <p><emphasis>JESUS</emphasis> ANDA, WHERE THE <emphasis>HELL</emphasis> HAVE YOU BEEN?</p>
     </text-area>
     <text-area points="884,174 889,156 904,140 933,131 977,127 1018,131 1051,141 1066,158 1069,179 1060,197 1041,208 1013,217 955,219 912,210 890,194">
       <p>SORRY, SARGE, MY DA TOOK ... ER, MY PC'S BEEN BROKEN.</p>
     </text-area>
     <text-area points="278,693 282,666 301,647 338,637 369,638 397,645 416,662 425,690 418,720 397,738 368,747 331,747 300,738 282,719">
       <p>WELL, I'VE GOT A <emphasis>BACKLOG</emphasis> OF MISSIONS, SO LET'S GO.</p>
     </text-area>
     <text-area points="451,747 455,719 477,695 507,682 548,679 589,687 613,701 626,721 630,743 627,772 610,796 584,809 549,813 511,812 480,801 455,776">
       <p>LISTEN ... I MET A GUY AFTER THE LAST CAMPAIGN. HE SAID HE WAS A <emphasis>UNION ORGANIZER.</emphasis></p>
     </text-area>
     <text-area points="136,1004 140,984 156,967 183,954 217,949 259,947 297,951 334,962 356,982 360,1004 355,1024 324,1049 274,1057 218,1057 177,1050 146,1031 136,1013">
       <p>OH, YOU MET <emphasis>RAYMOND,</emphasis> HUH? HE'S BEEN TURNING UP EVERYWHERE. WHAT A <emphasis>CREEP.</emphasis></p>
     </text-area>
     <text-area points="796,682 800,656 816,637 840,627 881,625 914,636 930,656 934,681 933,705 916,728 887,740 863,741 827,735 804,718 796,696">
       <p>SO YOU <emphasis>KNEW</emphasis> ABOUT THE NOOBS IN THE COTTAGES?</p>
     </text-area>
     <text-area points="958,726 960,703 974,687 1001,674 1048,669 1093,675 1119,691 1131,714 1131,737 1118,761 1089,777 1042,782 1002,777 971,760 959,740">
       <p>AND YOU'RE <emphasis>FINE</emphasis> WITH DEPRIVING LITTLE <emphasis>KIDS</emphasis> OF THEIR WAGES?</p>
     </text-area>
     <text-area points="1031,998 1034,977 1053,960 1090,950 1123,947 1162,952 1191,966 1204,985 1207,1005 1200,1025 1176,1044 1146,1052 1088,1052 1055,1043 1035,1026 1031,1010">
       <p>ANDA, LISTEN. YOU LOVE <emphasis>GAMING,</emphasis> RIGHT? IT'S <emphasis>IMPORTANT</emphasis> TO YOU?</p>
     </text-area>
     <text-area points="545,1268 550,1248 568,1234 599,1231 625,1238 639,1255 640,1278 633,1292 616,1303 596,1308 567,1304 549,1289">
       <p>YEAH, 'COURSE IT IS.</p>
     </text-area>
     <text-area points="701,1296 705,1268 725,1241 764,1225 811,1221 858,1225 894,1240 912,1261 921,1293 915,1325 897,1347 870,1360 830,1368 788,1368 755,1362 721,1345 703,1318">
       <p>RIGHT. AND WE'RE <emphasis>BAD-ASS,</emphasis> YOU AND ME, AND WE GOT THAT WAY THROUGH <emphasis>DISCIPLINE</emphasis> AND <emphasis>HARD WORK,</emphasis> RIGHT?</p>
     </text-area>
     <text-area points="897,1388 1017,1388 1017,1436 897,1436" bgcolor="#eee5e8" type="commentary">
       <p>YES, RIGHT, BUT -</p>
     </text-area>
     <text-area points="863,1557 865,1532 877,1514 896,1499 934,1488 976,1485 1021,1488 1057,1499 1081,1516 1093,1537 1094,1567 1086,1589 1068,1606 1035,1621 986,1627 935,1623 904,1616 878,1598 865,1576">
       <p>THAT'S WHAT MAKES US ALL <emphasis>FAHRENHEITS</emphasis> - WE'RE COMMITED TO EACH OTHER, TO <emphasis>TEAMWORK,</emphasis> AND TO <emphasis>FAIR PLAY.</emphasis></p>
     </text-area>
     <text-area points="996,1739 1003,1711 1023,1690 1051,1678 1087,1671 1136,1673 1176,1682 1198,1698 1211,1719 1213,1752 1201,1777 1177,1793 1145,1803 1103,1805 1063,1803 1028,1790 1003,1767">
       <p>BUT THESE PEOPLE IN MEXICO OR WHEREVER, THEY'RE EARNING THEIR LIVING BY <emphasis>EXPLOITING</emphasis> THE GAME.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="150,423 451,423 451,498 151,499" bgcolor="#f3ff9d" type="commentary">
       <p><emphasis>PC BAANG</emphasis> BOL ZAPLNENÝ SMRADĽAVÝMI, UHROVITÝMI CHALANMI, <emphasis>HLUČNÝMI</emphasis> A <emphasis>PROTIVNÝMI.</emphasis></p>
     </text-area>
     <text-area points="293,531 506,531 507,563 293,563" bgcolor="#f3ff9d" type="commentary">
       <p>ALE NA TOM NEZÁLEŽALO.</p>
     </text-area>
     <text-area points="571,119 737,120 737,174 571,175" bgcolor="#f3ff9d" type="commentary">
       <p>ANDA BOLA SPÄŤ V <emphasis>HRE.</emphasis></p>
     </text-area>
     <text-area points="665,277 668,255 683,239 710,226 759,225 786,230 808,242 821,260 822,282 813,302 790,318 769,324 722,324 691,317 673,302 666,289">
       <p><emphasis>JEŽIŠI</emphasis> ANDA, KDE SI <emphasis>DO PEKLA</emphasis> BOLA?</p>
     </text-area>
     <text-area points="884,174 889,156 904,140 933,131 977,127 1018,131 1051,141 1066,158 1069,179 1060,197 1041,208 1013,217 955,219 912,210 890,194">
       <p>PREPÁČ, SERŽANT, MÔJ OCO MI VZAL ... EÉ, MÔJ POČITAČ SA POKAZIL.</p>
     </text-area>
     <text-area points="278,693 282,666 301,647 338,637 369,638 397,645 416,662 425,690 418,720 397,738 368,747 331,747 300,738 282,719">
       <p>HMM, MÁM <emphasis>HROMADU</emphasis> MISIÍ, POĎME NA TO.</p>
     </text-area>
     <text-area points="451,747 455,719 477,695 507,682 548,679 589,687 613,701 626,721 630,743 627,772 610,796 584,809 549,813 511,812 480,801 455,776">
       <p>POČUJ ... STRETLA SOM JEDNÉHO CHALANA PO POSLEDNEJ MISII. POVEDAL, ŽE JE <emphasis>ODBOROVÝ ORGANIZÁTOR.</emphasis></p>
     </text-area>
     <text-area points="136,1004 140,984 156,967 183,954 217,949 259,947 297,951 334,962 356,982 360,1004 355,1024 324,1049 274,1057 218,1057 177,1050 146,1031 136,1013">
       <p>ÁCH, STRETLA SI <emphasis>RAYMONDA,</emphasis> ŽE? OBJAVUJE SA TERAZ VŠADE. STRAŠNÝ <emphasis>PODLIEZAVEC.</emphasis></p>
     </text-area>
     <text-area points="796,682 800,656 816,637 840,627 881,625 914,636 930,656 934,681 933,705 916,728 887,740 863,741 827,735 804,718 796,696">
       <p>TAKŽE SI <emphasis>VEDELA</emphasis> O AMATÉROCH V CHATRČIACH?</p>
     </text-area>
     <text-area points="958,726 960,703 974,687 1001,674 1048,669 1093,675 1119,691 1131,714 1131,737 1118,761 1089,777 1042,782 1002,777 971,760 959,740">
       <p>A <emphasis>NEVADÍ TI,</emphasis> ŽE PRIPRAVUJEŠ MALÉ <emphasis>DETI</emphasis> O ICH PLAT?</p>
     </text-area>
     <text-area points="1031,998 1034,977 1053,960 1090,950 1123,947 1162,952 1191,966 1204,985 1207,1005 1200,1025 1176,1044 1146,1052 1088,1052 1055,1043 1035,1026 1031,1010">
       <p>ANDA, POČÚVAJ. MILUJEŠ <emphasis>HRANIE,</emphasis> ŽE? JE TO PRE TEBA <emphasis>DÔLEŽITÉ?</emphasis></p>
     </text-area>
     <text-area points="545,1268 550,1248 568,1234 599,1231 625,1238 639,1255 640,1278 633,1292 616,1303 596,1308 567,1304 549,1289">
       <p>JASNE, URČITE, ŽE JE.</p>
     </text-area>
     <text-area points="701,1296 705,1268 725,1241 764,1225 811,1221 858,1225 894,1240 912,1261 921,1293 915,1325 897,1347 870,1360 830,1368 788,1368 755,1362 721,1345 703,1318">
       <p>V PORIADKU. A MY SME <emphasis>SILNÝ TÍM,</emphasis> TY A JA, A DOPRACOVALI SME SA K TOMU <emphasis>DISCIPLÍNOU</emphasis> A <emphasis>TVRDOU PRÁCOU,</emphasis> ŽE?</p>
     </text-area>
     <text-area points="897,1388 1017,1388 1017,1436 897,1436" bgcolor="#eee5e8" type="commentary">
       <p>ÁNO, ALE -</p>
     </text-area>
     <text-area points="863,1557 865,1532 877,1514 896,1499 934,1488 976,1485 1021,1488 1057,1499 1081,1516 1093,1537 1094,1567 1086,1589 1068,1606 1035,1621 986,1627 935,1623 904,1616 878,1598 865,1576">
       <p>TO JE TO, ČO Z NÁS ROBÍ <emphasis>FAHRENHEITOV</emphasis> - SME ODDANÍ SAMI SEBE NAVZÁJOM, <emphasis>TÍMOVEJ PRÁCI,</emphasis> A <emphasis>FÉROVEJ HRE.</emphasis></p>
     </text-area>
     <text-area points="996,1739 1003,1711 1023,1690 1051,1678 1087,1671 1136,1673 1176,1682 1198,1698 1211,1719 1213,1752 1201,1777 1177,1793 1145,1803 1103,1805 1063,1803 1028,1790 1003,1767">
       <p>A TÍTO ĽUDIA V MEXIKU ALEBO KDE, ZARÁBAJÚ PENIAZE NA <emphasis>ZNEUŽÍVANÍ</emphasis> PRAVIDIEL HRY.</p>
     </text-area>
   </text-layer>
   <frame points="105,97 524,96 526,579 108,582"/>
   <frame points="541,94 707,91 712,95 733,96 744,90 756,90 773,101 942,121 1011,123 1032,126 1047,132 1055,134 1090,135 1194,151 1198,575 542,580"/>
   <frame points="45,594 639,590 642,1080 45,1085"/>
   <frame points="653,589 1262,586 1263,1076 654,1080 654,589"/>
   <frame points="30,1098 247,1094 1286,1087 1292,1886 35,1894"/>
  </page>
  <page>
   <image href="16.jpg"/>
   <text-layer lang="en">
     <text-area points="137,243 144,213 165,193 196,181 238,177 285,182 317,195 335,217 339,244 334,271 313,293 283,303 244,308 205,306 171,297 146,276 139,261">
       <p>THEY SPEND ALL DAY CRAFTING STUFF TO TURN INTO GOLD TO <emphasis>SELL OFF</emphasis> ON THE EXCHANGE.</p>
     </text-area>
     <text-area points="359,258 371,231 392,208 418,195 459,188 505,196 536,211 556,235 567,278 567,308 559,340 543,365 512,384 471,391 436,391 398,377 373,355 360,323 357,290">
       <p>THAT'S WHERE THE <emphasis>CRAPPY</emphasis> PLAYERS GET THEIR GOLD FROM! THAT'S HOW RICH NOOBS CAN BUY THEIR WAY INTO THE GAME THAT <emphasis>WE</emphasis> HAD TO PLAY HARD TO GET INTO.</p>
     </text-area>
     <text-area points="934,270 938,241 952,217 978,196 1010,186 1057,181 1113,186 1152,202 1174,226 1186,266 1184,295 1174,320 1151,343 1122,357 1084,362 1028,362 990,353 957,334 938,303">
       <p>IF WE KEEP BURNING THE FACTORIES DOWN, THEY'LL SHUT THEM DOWN AND THOSE KIDS'LL FIND SOMETHING <emphasis>ELSE</emphasis> TO DO FOR A LIVING AND THE GAME WILL BE <emphasis>BETTER.</emphasis></p>
     </text-area>
     <text-area points="872,598 875,575 889,553 918,540 950,534 988,534 1020,543 1042,558 1053,574 1058,598 1052,624 1035,643 1004,657 965,661 924,657 891,643 876,622">
       <p>THESE PEOPLE DON'T <emphasis>CARE</emphasis> ABOUT THE GAME. THEY'RE NOT PLAYERS, THEY'RE <emphasis>LEECHES.</emphasis></p>
     </text-area>
     <text-area points="134,774 137,756 148,742 165,737 181,735 206,738 219,746 229,768 227,788 218,802 197,812 169,812 145,804 136,787">
       <p>SO ARE YOU <emphasis>IN,</emphasis> ANDA?</p>
     </text-area>
     <text-area points="153,904 158,876 178,850 216,835 268,831 321,835 357,848 377,870 384,896 382,922 371,946 347,964 308,975 275,976 218,972 179,957 159,937">
       <p>ARE YOU HERE TO <emphasis>PLAY,</emphasis> OR ARE YOU SO WORRIED ABOUT THESE <emphasis>LEECHES</emphasis> ON THE OTHER SIDE OF THE WORLD THAT YOU WANT OUT?</p>
     </text-area>
     <text-area points="932,772 937,755 953,744 974,741 1001,746 1017,756 1021,775 1012,793 996,802 961,803 941,794 933,784">
       <p>I'M IN, SARGE.</p>
     </text-area>
     <text-area points="798,1104 801,1094 820,1083 848,1080 891,1082 913,1090 920,1104 915,1115 895,1125 857,1129 820,1125 801,1114">
       <p><strong>BOO-YAH!</strong></p>
     </text-area>
     <text-area points="1074,1121 1173,1121 1174,1168 1076,1169" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; hello</p>
     </text-area>
     <text-area points="151,1503 158,1488 184,1477 230,1477 251,1485 261,1497 260,1511 244,1524 220,1529 186,1528 159,1520">
       <p>RAYMOND!</p>
     </text-area>
     <text-area points="326,1530 334,1513 352,1501 388,1497 424,1500 444,1512 452,1531 445,1550 425,1562 385,1566 352,1562 334,1552">
       <p>OH, CHRIST, HE'S BACK.</p>
     </text-area>
     <text-area points="932,1256 938,1251 1051,1252 1057,1258 1058,1306 1050,1312 939,1314 933,1306" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; look at these ...</p>
     </text-area>
     <text-area points="946,1433 950,1409 965,1392 994,1380 1032,1377 1074,1380 1105,1395 1118,1417 1119,1445 1111,1463 1091,1477 1063,1485 1016,1487 982,1481 958,1466 947,1448">
       <p>COME ON, IT'S PROBABLY A BOOBY-TRAP. WE'VE GOT WORK TO DO.</p>
     </text-area>
   </text-layer>
   <text-layer lang="sk">
     <text-area points="137,243 144,213 165,193 196,181 238,177 285,182 317,195 335,217 339,244 334,271 313,293 283,303 244,308 205,306 171,297 146,276 139,261">
       <p>TRÁVIA CELÉ DNI VYRÁBANÍM VECÍ, ABY ICH ZAMENILI ZA ZLATO, KTORÉ <emphasis>PREDAJÚ</emphasis> V ZMENÁRNI.</p>
     </text-area>
     <text-area points="359,258 371,231 392,208 418,195 459,188 505,196 536,211 556,235 567,278 567,308 559,340 543,365 512,384 471,391 436,391 398,377 373,355 360,323 357,290">
       <p>TO JE TAM, KDE <emphasis>SLABÍ</emphasis> HRÁČI ZÍSKAVAJÚ SVOJE ZLATO! TAKTO SI BOHATÍ HRÁČI KÚPIA SPÔSOB AKO SA DOSTAŤ DO HRY, KDE <emphasis>MY</emphasis> MUSÍME TVRDO PRACOVAŤ, ABY SME SA DOSTALI.</p>
     </text-area>
     <text-area points="934,270 938,241 952,217 978,196 1010,186 1057,181 1113,186 1152,202 1174,226 1186,266 1184,295 1174,320 1151,343 1122,357 1084,362 1028,362 990,353 957,334 938,303">
       <p>KEĎ BUDEME POKRAČOVAŤ V NIČENÍ ICH TOVÁRNÍ, BUDÚ NÚTENÍ ICH ZAVRIEŤ A TIE DETI SI NÁJDU NIEČO <emphasis>INÉ</emphasis> NA PRÁCU A HRA BUDE <emphasis>LEPŠIA.</emphasis></p>
     </text-area>
     <text-area points="872,598 875,575 889,553 918,540 950,534 988,534 1020,543 1042,558 1053,574 1058,598 1052,624 1035,643 1004,657 965,661 924,657 891,643 876,622">
       <p>TÍMTO ĽUĎOM <emphasis>NEZÁLEŽÍ</emphasis> NA HRE. ONI NIE SÚ HRÁČI, ONI SÚ <emphasis>PIJAVICE.</emphasis></p>
     </text-area>
     <text-area points="134,774 137,756 148,742 165,737 181,735 206,738 219,746 229,768 227,788 218,802 197,812 169,812 145,804 136,787">
       <p>TAKŽE SI <emphasis>V HRE,</emphasis> ANDA?</p>
     </text-area>
     <text-area points="153,904 158,876 178,850 216,835 268,831 321,835 357,848 377,870 384,896 382,922 371,946 347,964 308,975 275,976 218,972 179,957 159,937">
       <p>SI TU, ABY SI <emphasis>HRALA,</emphasis> ALEBO SI TAK ZNEPOKOJENÁ TÝMITO <emphasis>PIJAVICAMI</emphasis> Z DRUHEJ STRANY SVETA, ŽE UŽ NECHCEŠ HRAŤ?</p>
     </text-area>
     <text-area points="932,772 937,755 953,744 974,741 1001,746 1017,756 1021,775 1012,793 996,802 961,803 941,794 933,784">
       <p>SOM V HRE, SERŽANT.</p>
     </text-area>
     <text-area points="798,1104 801,1094 820,1083 848,1080 891,1082 913,1090 920,1104 915,1115 895,1125 857,1129 820,1125 801,1114">
       <p><strong>BÚÚ-JÁÁ!</strong></p>
     </text-area>
     <text-area points="1074,1121 1173,1121 1174,1168 1076,1169" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; ahojte</p>
     </text-area>
     <text-area points="151,1503 158,1488 184,1477 230,1477 251,1485 261,1497 260,1511 244,1524 220,1529 186,1528 159,1520">
       <p>RAYMOND!</p>
     </text-area>
     <text-area points="326,1530 334,1513 352,1501 388,1497 424,1500 444,1512 452,1531 445,1550 425,1562 385,1566 352,1562 334,1552">
       <p>OCH, BOŽE, JE SPÄŤ.</p>
     </text-area>
     <text-area points="932,1256 938,1251 1051,1252 1057,1258 1058,1306 1050,1312 939,1314 933,1306" bgcolor="#11161a" type="code" inverted="True">
       <p>&gt; pozrite si tieto ...</p>
     </text-area>
     <text-area points="946,1433 950,1409 965,1392 994,1380 1032,1377 1074,1380 1105,1395 1118,1417 1119,1445 1111,1463 1091,1477 1063,1485 1016,1487 982,1481 958,1466 947,1448">
       <p>ALE CHOĎ, JE TO PRAVDEPODOBNE PASCA. MÁME PLNO PRÁCE.</p>
     </text-area>
   </text-layer>
   <frame points="110,163 585,160 595,693 113,699"/>
   <frame points="601,161 1203,156 1208,686 606,692"/>
   <frame points="109,710 765,705 770,1205 113,1213"/>
   <frame points="777,704 1209,699 1210,1201 783,1206"/>
   <frame points="116,1222 536,1220 545,1844 120,1848"/>
   <frame points="547,1218 1212,1213 1214,1841 555,1849"/>
