   <frame points="60,532 75,505 84,487 96,487 132,517 141,517 186,493 195,493 231,478 231,460 246,439 252,439 270,433 291,445 318,424 330,418 366,418 378,424 384,442 399,448 378,463 378,472 396,484 432,466 435,481 444,490 456,487 465,505 492,508 504,514 513,526 522,526 534,520 546,532 558,532 570,526 582,532 588,562 606,544 618,544 639,529 660,535 696,514 720,520 723,538 711,568 720,565 723,580 741,577 753,553 762,553 786,529 810,532 831,535 849,544 852,553 888,553 927,580 957,610 960,670 966,676 966,715 951,748 945,751 945,766 960,781 963,805 975,817 975,952 78,961 78,925 75,904 75,838 72,823 72,814 75,808 75,673 99,613 117,595 90,574"/>
   <frame points="78,964 444,964 444,1390 84,1390"/>
   <frame points="447,1024 444,1012 444,991 456,982 480,970 492,970 504,964 534,970 552,964 564,964 576,976 588,970 600,970 618,964 642,970 648,976 663,982 666,991 666,1003 672,1006 666,1033 672,1042 672,1060 666,1075 660,1084 651,1087 630,1087 627,1096 639,1099 660,1102 669,1108 660,1117 666,1132 666,1147 657,1153 639,1159 651,1168 657,1198 660,1201 657,1246 669,1243 666,1360 630,1378 618,1378 594,1372 582,1384 570,1390 552,1384 540,1378 528,1384 510,1384 486,1372 462,1372 450,1366 456,1354 450,1342 456,1324 444,1300 444,1192 447,1180 459,1171 453,1156 456,1144 465,1135 471,1120 495,1108 483,1093 468,1090 462,1081 447,1075 447,1057 445,1039"/>
   <frame points="660,964 669,955 675,958 684,955 699,955 705,961 729,958 738,955 747,958 789,958 807,955 813,961 831,958 840,955 846,958 879,958 894,958 903,955 912,958 927,958 936,955 957,955 969,952 975,955 975,967 972,976 978,982 972,988 972,1015 969,1021 975,1030 972,1039 975,1051 975,1393 663,1393 669,1060 672,1042 666,1033 669,1009 663,1000 663,982"/>
  <text-layer lang="sk"><text-area bgcolor="#a0c5df" points="88,110 98,97 190,102 302,104 416,106 568,102 690,98 708,124 703,166 508,176 407,181 290,182 150,185 100,186 90,148" type="commentary"><p> </p></text-area><text-area bgcolor="#a0c5df" points="98,106 694,106 694,173 96,173" type="commentary"><p>Z HUSTO ZARASTENEJ ZÁHADNEJ AFRICKEJ DŽUNGLE... PÔVODNÉHO DOMOVA VOODOO A ŠAMANOV... POCHÁDZA NAJPODIVNEJŠIA LEGENDA VŠETKÝCH LEGIEND...</p></text-area><text-area bgcolor="#eff6b0" points="175,279 183,205 683,205 662,240 643,261 625,278" type="heading"><p>S I L A</p></text-area><text-area bgcolor="#eff6b0" points="157,275 627,275 677,357 575,361 175,361 155,356 144,328" type="heading"><p>FIALOVÉHO</p></text-area><text-area bgcolor="#eff6b0" points="401,362 583,362 675,357 685,369 655,452 555,457 434,459 411,455 399,440 393,414 397,390" type="heading"><p>DRÁPU</p></text-area><text-area bgcolor="#ffffff" points="320,832 322,853 345,875 345,902 366,923 432,937 590,940 619,937 643,925 722,923 741,904 746,872 771,846 774,814 760,799 735,792 729,771 714,756 690,748 635,743 487,743 422,753 397,771 390,786 366,786 348,795 329,814"><p>PRE TEBA, MILÝ ČITATEĽ, OTVÁRAM TAJOMSTVÁ PRÍBEHU <emphasis>FIALOVÉHO DRÁPU</emphasis> ... O VECIACH PODIVNÝCH ... NEOBYČAJNÝCH A NEVYSVETLITEĽNÝCH ... O VECIACH A ZÁHADÁCH MIMO NÁŠHO POROZUMENIA! NAJSKÔR MI ALE DOVOĽ ROZPOVEDAŤ TI PRÍBEH O TOM, AKO SA FIALOVÝ DRÁP DOSTAL Z NAJHLBŠÍCH ÚTROB AFRICKEJ DŽUNGLE DO ... <emphasis>AMERIKY!</emphasis></p></text-area><text-area bgcolor="#d62444" points="268,973 441,973 440,1164 430,1168 416,1164 405,1166 392,1170 368,1170 359,1174 336,1168 304,1172 289,1174 283,1182 274,1177 256,1173 247,1170 241,1132 246,1127 246,1091 254,1086 255,1074 253,1062 250,1046 259,1036 255,996 260,992 258,981" type="commentary"><p>"PRÍBEH FIALOVÉHO DRÁPU, TAK AKO HO DNES POZNÁME, ZAČAL PRED ASI DESIATIMI ROKMI ... V ROKU 1943. MLADÝ DOKTOR JONATHAN WEIR, ČLEN LEKÁRSKEHO ODDIELU ARMÁDY SPOJENÝCH ŠTÁTOV AMERICKÝCH, STROSKOTAL V AFRICKEJ DŽUNGLI ..."</p></text-area><text-area bgcolor="#ffffff" points="458,1021 460,994 480,987 639,987 656,993 658,1021 642,1032 644,1038 661,1041 665,1056 656,1063 623,1077 598,1078 479,1078 460,1060 460,1039"><p>PRIŠIEL Z NEBIES. NIE JE V ŇOM UŽ VEĽA ŽIVOTA. NO JA HO DOKÁŽEM K ŽIVOTU ZNOVA PRIVIESŤ.</p></text-area><text-area bgcolor="#eff6b0" points="678,1013 680,988 672,972 686,968 703,969 896,969 957,969 957,1043 930,1047 915,1054 891,1056 821,1056 758,1057 718,1058 676,1057" type="commentary"><p>"HLBOKO V DŽUNGLI DOKTOR JONATHAN WEIR NAŠIEL SVOJHO ZÁCHRANCU ... A POMALY VĎAKA TRPEZLIVEJ STAROSTLIVOSTI SA Z NEHODY ZOTAVIL..."</p></text-area><text-area bgcolor="#ffffff" points="676,1063 750,1059 906,1059 938,1061 950,1078 966,1087 966,1115 946,1128 900,1135 886,1147 809,1149 705,1153 680,1147 675,1124"><p>KIEŽBY MAGICKÁ SILA MÔJHO FIALOVÉHO DRÁPU DOKÁZALA POMÔCŤ MÔJMU ĽUDU, TAK AKO POMOHLA TEBE SA ZOTAVIŤ, PRIATEĽ MÔJ PRICHÁDZAJÚCI Z NEBIES.</p></text-area></text-layer></page>
  <page>
   <image href="PC1_04.webp"/>
   <frame points="30,72 528,72 540,84 546,102 534,126 540,144 540,156 549,173 549,197 538,214 540,498 30,510"/>
   <frame points="546,66 930,66 936,492 546,498"/>
   <frame points="30,516 330,510 342,942 36,948"/>
   <frame points="342,510 630,504 630,558 636,564 636,570 636,582 642,594 642,606 636,618 648,636 648,648 642,660 630,666 630,936 348,936"/>
   <frame points="636,504 930,498 930,930 648,930 642,660 648,648 648,636 642,624 642,588"/>
   <frame points="36,954 480,948 480,1374 42,1380"/>
   <frame points="492,948 912,942 924,948 930,960 936,978 936,990 924,1020 930,1038 930,1062 924,1074 912,1086 894,1098 894,1104 918,1146 924,1164 930,1200 930,1266 924,1302 918,1320 936,1332 942,1344 936,1362 936,1380 546,1380 492,1362 486,1338 486,1296 492,1260 504,1224 528,1176 558,1146 630,1116 552,1116 504,1110 492,1104"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="42,84 308,84 330,94 327,121 318,133 330,143 327,176 300,193 230,201 173,202 146,216 62,212 42,206 39,183"><p>MOJI ĽUDIA TU ŽILI PO MNOHO A MNOHO ROKOV. A TAKMER VŽDY OCHOREJÚ POČAS LETA. NEBOL SOM SCHOPNÝ ZNIČIŤ ZLÉHO DUCHA, KTORÝ K NÁM TÚTO CHOROBU PRINÁŠA.</p></text-area><text-area bgcolor="#ffffff" points="340,88 354,79 520,79 535,97 531,116 518,128 528,143 524,162 540,171 543,187 540,200 527,209 456,210 382,210 344,207 331,194 339,171 341,146 343,117 344,100"><p>TVOJA MOC JE VEĽKÁ, STARÝ MUŽ. MOŽNO TO ALE NIE JE ZLÝ DUCH, KTORÝ TÚ CHOROBU PRINÁŠA. DOVOĽ MI NIEKOĽKÝCH TVOJICH ĽUDÍ VYŠETRIŤ.</p></text-area><text-area bgcolor="#ffffff" points="554,80 920,80 920,105 910,118 860,126 779,128 736,124 718,120 690,125 678,133 627,138 580,138 558,131 554,110"><p>MAL SOM PRAVDU, STARÝ MUŽ. TOTO JE MALÁRIA. ŽIADEN ZLÝ DUCH ALE MOSKYTY JU PRINÁŠAJÚ.</p></text-area><text-area bgcolor="#ffffff" points="40,522 321,522 321,580 308,587 181,593 81,594 44,595 41,579"><p>DOBRE SI SPRAVIL, ŽE SI PRINIESOL MOJE VECI Z VRAKU LIETADLA. TIETO LIEKY TAK POMÔŽU TVOJIM ĽUĎOM.</p></text-area><text-area bgcolor="#ffffff" points="103,599 312,599 323,612 309,635 285,648 229,654 169,658 126,657 104,644 94,618"><p>TVOJA MÁGIE JE VEĽMI SILNÁ, AK JE PRAVDA, ČO HOVORÍŠ!</p></text-area><text-area bgcolor="#ffffff" points="347,514 620,514 623,561 630,570 626,580 617,585 499,586 490,599 453,603 389,602 349,599"><p>MOSKYTY PRICHÁDZAJÚ Z TÝCHTO BAŽÍN. DAJ ICH TVOJIM ĽUĎOM VYSUŠIŤ POMOCOU ODVODŇOVACÍCH KANÁLOV. A ČOSKORO SA CHOROBA VYTRATÍ.</p></text-area><text-area bgcolor="#ffffff" points="409,611 491,611 502,593 629,593 639,595 632,608 620,616 625,619 643,633 643,655 619,666 545,667 495,667 440,674 409,665 397,640"><p>TVOJA MÁGIE JE ZVLÁSTNA A ODLIŠNÁ OD MOJEJ. ALE POMÁHA MOJIM ĽUĎOM!</p></text-area><text-area bgcolor="#ffffff" points="644,507 921,507 921,543 905,553 875,557 805,561 694,561 673,561 646,559" type="commentary"><p>"A TAK JONATHAN WEIR OPLATIL POMOC ĽUĎOM, KTORÍ MU ZACHRÁNILI ŽIVOT..."</p></text-area><text-area bgcolor="#ffffff" points="647,571 711,571 723,579 731,615 721,647 705,659 707,667 711,681 703,699 667,703 649,697"><p>MUSÍM SA VRÁTIŤ SPÄŤ K MOJIM ĽUĎOM, STARÝ MUŽ.</p></text-area><text-area bgcolor="#ffffff" points="735,585 745,569 923,569 925,729 911,745 873,752 809,745 782,738 769,718 739,711 723,686 727,649 735,614"><p>CHOĎ, PRIATEĽU, A POKRAČUJ V DOBRÝCH SKUTKOCH A V BOJI PROTI ZLU, KDEKOĽVEK LEN BUDEŠ! MÁM PRE TEBA DAR NA ROZLÚČKU... DAR, KTORÝ TI DÁ VÄČŠIU SILU, NEŽ MÁŠ TERAZ!</p></text-area><text-area bgcolor="#ffffff" points="45,959 454,959 470,986 463,1016 441,1041 415,1051 333,1050 217,1053 207,1057 196,1076 155,1078 90,1077 46,1070"><p>VO <emphasis>FIALOVOM DRÁPE</emphasis> JE ZVLÁŠTNA SILA... SILA, KTORÚ ŽIADEN ČLOVEK NEDOKÁŽE VYSVETLIŤ. POUŽÍVAJ JU... A V ROKOCH NASLEDUJÚCICH OBJAVÍŠ MAGICKÚ SILU, KTORÚ TI <emphasis>FIALOVÝ DRÁP POSKYTNE!</emphasis></p></text-area><text-area bgcolor="#fffffd" points="238,1080 244,1086 267,1091 432,1091 441,1085 461,1081 469,1073 469,1067 464,1061 459,1059 442,1059 262,1059 252,1061 239,1074"><p>BUDEM HO POUŽÍVAŤ, STARÝ MUŽ!</p></text-area><text-area bgcolor="#ffffff" points="497,953 919,953 929,989 921,1009 915,1017 926,1045 907,1081 863,1100 780,1105 680,1108 577,1109 521,1108 499,1099"><p>A TERAZ, MILÝ ČITATEĽ, POZNÁŠ TAJOMSTVO FIALOVÉHO DRÁPU! JA, DOKTOR JONATHAN WEIR, SOM SA STAL <emphasis>INÝM ČLOVEKOM...</emphasis> MOJI SUSEDIA MA POZNAJÚ AKO TOHO MILÉHO DOKTORA JONATHANA WEIRA. A SVET ZLA MA POZNÁ AKO <emphasis>DESIVÉHO FIALOVÉHO DRÁPA!</emphasis> A  TERAZ... SI MYSLÍM PRIPRAVENÝ NAHLIADNUŤ DO UTAJENÝCH STRÁNOK MOJICH PRÍBEHOV...</p></text-area></text-layer></page>
  <page>
   <title>A Kingdom of the Dead</title>
   <image href="PC1_05.webp"/>
   <frame points="66,57 144,57 156,63 204,57 282,57 300,51 312,57 348,57 366,51 396,57 972,57 972,477 366,477 366,483 294,492 252,492 249,504 240,498 225,492 216,498 189,492 183,501 168,501 162,492 141,498 147,489 135,489 123,501 102,507 102,501 96,495 87,501 72,483 66,477 75,465 72,453 78,438 63,417 78,411 78,387 66,381 66,339 78,333 72,321 72,297 66,255 72,243 66,219 72,189 60,171 78,147 60,129 66,99"/>
   <frame points="48,597 48,579 60,543 78,519 108,501 138,495 168,501 264,501 306,489 366,483 462,483 510,489 564,489 570,921 72,927 72,651 54,627"/>
   <frame points="576,483 642,483 708,477 804,477 882,483 972,483 972,921 582,927 576,561 570,543 570,531 576,513"/>
   <frame points="72,939 360,939 366,1365 72,1365"/>
   <frame points="372,939 660,933 660,1365 378,1365"/>
   <frame points="672,933 972,927 966,1365 672,1365 666,1029 666,1011 660,987 666,969 660,957"/>
  <text-layer lang="en"/><text-layer lang="sk"><text-area points="80,71 136,69 154,82 244,78 365,77 366,102 361,134 367,151 357,173 359,191 372,206 380,223 362,235 358,254 375,269 381,298 363,331 357,354 359,399 358,475 203,486 98,479 89,421 92,325 89,220 89,149 77,127" bgcolor="#fefda3" type="commentary"><p>OD POČIATKU ČASOV EXISTOVALI MUŽI S NEBEZPEČNÝMI PLÁNMI... NA OVLÁDNUTIE SVETA S NEKONTROLOVATEĽNOU SILOU. OBROVSKÉ ARMÁDY OZBROJENÝCH MUŽOV IM MALI NAPOMÁHAŤ V ICH PLÁNOCH! ALE HROZNÝ PLÁN DOKTORA GOOLA BOL DIABOLSKÝ AKO ŽIADEN INÝ. JEHO PLÁN NA OVLÁDNUTIE SVETA ZAHRŇOVAL OBROVSKÉ ARMÁDY NEMŔTVYCH... HORDY KREATÚR, KTORÉ BOLI RAZ ŽIVÝMI ĽUĎMI... NA VYKONANIE TÚŽBY JEDINÉHO MUŽA NA OVLÁDNUTIE SVETA.</p><p> </p><p><strong>KRÁĽOVSTVO MŔTVYCH!!</strong></p></text-area><text-area points="654,100 676,72 929,71 935,80 919,97 876,105 864,114 769,116 696,114"><p>MOJE!... MOJE!... A ĎALŠIE LÉGIE PRICHÁDZAJÚ!</p></text-area><text-area bgcolor="#ffffff" points="248,579 238,550 246,518 277,500 337,490 482,490 528,498 556,519 560,554 516,584 462,597 355,602 280,596"><p>V MOJEJ TAJOMNEJ KNIHE TENTO PRÍBEH VYČNIEVA NAD VŠETKÝMI! TENTO STRAŠIDELNÝ PRÍBEH NEZAČÍNA NIKDE INDE NEŽ V PRVEJ METROPOLITNEJ BANKE!</p></text-area><text-area bgcolor="#ffffff" points="297,672 301,688 312,697 317,704 337,704 354,707 356,709 372,709 379,710 418,710 421,709 430,709 441,702 445,702 468,678 471,677 472,667 469,660 456,649 452,648 449,644 422,638 370,638 333,645 314,654"><p>OKAMŽITE VYPLAŤTE TENTO ŠEK, PROSÍM!</p></text-area><text-area bgcolor="#ffffff" points="578,541 588,515 604,501 665,490 696,487 818,487 890,493 922,502 938,517 932,539 900,553 803,558 703,559 682,571 650,575 616,574 588,560"><p>ALE PÁN BRADLEY BOL PREDSA ZABITÝ PRED DVOMA MESIACMI PRI AUTOMOBILOVEJ NEHODE! TENTO ŠEK ... JE ... DATOVANÝ NA DNES!</p></text-area><text-area bgcolor="#ffffff" points="87,945 287,945 282,963 259,976 241,987 153,990 107,985 83,971 83,957"><p><emphasis>JA</emphasis> SOM TOM BRADLEY! A SOM NAŽIVE!</p></text-area><text-area bgcolor="#ffffff" points="384,942 629,942 647,956 641,970 610,981 537,985 515,990 488,991 440,995 401,992 379,981 379,957"><p>VRÁTIM SA HNEĎ SPÄŤ...! MUSÍM SA PORADIŤ S RIADITEĽOM... MUSÍM...</p></text-area><text-area bgcolor="#ffffff" points="673,937 963,937 962,1005 931,1010 893,1012 839,1012 793,1020 784,1030 711,1028 687,1021 676,997 677,962 671,948" type="commentary"><p>RIADITEĽ SA VRÁTIL SPOLU S POKLADNÍKOM. POCHYBOVAL O POKLADNÍKOVOM DUŠEVNOM ZDRAVÍ. ČO ALE UVIDEL, HO DONÚTILO POCHYBOVAŤ O TOM SVOJOM.</p></text-area><text-area bgcolor="#ffffff" points="685,1068 685,1047 703,1037 939,1037 956,1037 961,1057 960,1075 951,1080 917,1079 882,1081 857,1083 848,1093 845,1101 773,1105 765,1117 745,1122 695,1123 681,1110 685,1077"><p>VYZERÁ ROVNAKO AKO TOM BRADLEY... AKO JE TO LEN MOŽNÉ? MUSÍME ZAVOLAŤ POLÍCIU.</p></text-area><text-area bgcolor="#ffffff" points="855,1096 861,1089 871,1087 942,1087 953,1090 951,1101 939,1108 890,1109 866,1107 858,1103"><p>ÁNO, PANE!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_06.webp"/>
   <frame points="36,156 54,108 72,90 102,90 132,102 324,102 330,114 330,132 330,156 330,168 330,528 30,534 30,240 36,228 36,216 48,204 36,168"/>
   <frame points="330,96 624,96 630,522 336,528"/>
   <frame points="624,96 930,96 930,510 636,522 630,186 624,174 624,150"/>
   <frame points="30,540 528,534 534,966 30,978"/>
   <frame points="540,534 930,522 930,960 540,966"/>
   <frame points="30,984 474,978 474,1410 30,1416"/>
   <frame points="480,972 930,966 930,1404 486,1410"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="157,110 319,110 321,135 323,155 309,173 279,183 219,187 165,180 152,161 151,152 146,129"><p>"POLÍCIA PRIŠLA. ČO ALE S TÝM MOHLI SPRAVIŤ?"</p></text-area><text-area bgcolor="#ffffff" points="40,247 73,241 106,227 125,210 152,210 168,229 159,248 152,256 149,278 126,296 94,303 57,299 41,289"><p>VYZERÁ AKO TOM BRADLEY, ALE...</p></text-area><text-area bgcolor="#ffffff" points="162,254 171,243 175,230 199,224 285,224 293,224 315,229 317,317 287,323 205,322 171,315 169,291 159,273"><p>MUSÍ TO BYŤ ON! TÁ TVÁR! PODPIS NA ŠEKU! SÚ JEHO!</p></text-area><text-area bgcolor="#ffffff" points="342,132 353,123 369,120 417,120 437,135 432,161 406,169 362,167 341,161"><p>JA SOM TOM BRADLEY.</p></text-area><text-area bgcolor="#ffffff" points="435,167 445,147 448,132 480,122 575,122 605,137 605,153 612,182 597,201 585,208 575,219 533,220 477,218 444,209 429,190"><p>VEZMEME HO DO DOMU BRADLEYOVCOV. MOŽNO NÁM TO JEHO RODINA VYSVETLÍ.</p></text-area><text-area bgcolor="#e1b765" points="632,104 922,104 923,175 870,179 821,179 696,177 647,180 638,165 635,126" type="commentary"><p>"V DOME BRADLEYOVCOV BOL MUŽ, KTORÝ O SEBE TVRDIL, ŽE JE TOM BRADLEY, KONFRONTOVANÝ SO SVOJOU MATKOU A SESTROU."</p></text-area><text-area bgcolor="#ffffff" points="650,190 784,190 789,205 774,217 706,217 665,218 641,213 641,199"><p>ALICA! MATKA!</p></text-area><text-area bgcolor="#ffffff" points="793,207 795,195 812,190 902,190 913,210 899,235 887,243 871,241 842,243 818,230 797,225"><p>NIE! JE TO MÔJ BRAT TOM?</p></text-area><text-area bgcolor="#e43459" points="41,552 145,548 237,545 359,544 360,556 358,566 350,573 361,589 350,590 351,598 339,596 336,600 323,597 312,610 283,601 260,606 228,608 210,611 186,610 125,608 110,612 105,609 94,610 72,611 55,613 42,616 44,602 38,592"><p> </p></text-area><text-area bgcolor="#e43459" points="38,550 357,550 358,567 348,571 354,586 344,591 336,599 324,597 311,609 286,601 257,606 230,608 208,609 173,609 120,609 103,606 60,611 42,600 38,591" type="commentary"><p>"PODIVNOSŤ, KTORÁ OBKLOPOVALA TOMA BRADLEYHO SA ZVÄČŠOVALA KAŽDÝM DŇOM..."</p></text-area><text-area bgcolor="#ffffff" points="42,642 57,632 76,620 290,620 299,633 313,650 324,662 324,674 311,678 284,695 257,702 191,703 177,719 105,724 68,720 55,715 51,698 46,660"><p>MOHLO SA PRIHODIŤ TOMOVI NIEČO HORŠIE AKO JEHO VLASTNÁ SMRŤ? SOM ZVEDAVÁ, ČO NA TO POVIE DOKTOR JONATHAN WEIR.</p></text-area><text-area bgcolor="#ffffff" points="568,534 855,534 858,545 820,553 781,555 774,567 729,573 716,577 582,580 552,574 551,551 557,541"><p>KIEŽBY DOKTOR WIER DOKÁZAL PRÍSŤ NA KOREŇ TEJTO ZÁHADY.</p></text-area><text-area bgcolor="#ffffff" points="47,987 464,987 465,1016 444,1027 323,1027 217,1028 223,1045 215,1059 191,1068 125,1069 61,1065 36,1060 38,996"><p>...VEĽMI MA TO ZNEPOKOJUJE! VIDELA SOM HO V JEHO TRUHLE... POCHOVANÉHO V RODINNEJ HROBKE. NO TERAZ JE NAŽIVE... A PREDSA NIE JE ŽIVÝ.</p></text-area><text-area bgcolor="#ffffff" points="199,1073 219,1064 237,1047 243,1036 447,1036 454,1048 450,1056 463,1082 455,1104 426,1115 361,1121 305,1123 236,1122 193,1111 181,1092 187,1080"><p>ZAŽIL SOM UŽ OVEĽA PODIVNEJŠIE VECI, PANI BRADLEYOVÁ. NAJSKÔR PRESKÚMAME VŠETKY FAKTY.</p></text-area><text-area bgcolor="#e43459" points="503,979 921,979 919,997 870,1004 799,1008 763,1012 721,1016 684,1018 629,1016 576,1021 536,1018 503,1016 491,1006 490,983" type="commentary"><p>"A TAK SA DOKTOR WEIR ROZHODOL NAJSKÔR DÔKLADNE VYŠETRIŤ TOMA BRADLEYHO..."</p></text-area><text-area bgcolor="#ffffff" points="495,1067 506,1046 533,1036 573,1028 699,1028 707,1028 735,1036 775,1049 780,1068 756,1081 710,1088 639,1091 594,1093 565,1093 539,1094 506,1088"><p>JE TO LEN RUTINNÁ PREHLIADKA, TOM. DOKTOR WEIR ŤA CHCE LEN ZBEŽNE VYŠETRIŤ.</p></text-area></text-layer></page>
  <page>
   <image href="PC1_07.webp"/>
   <frame points="78,110 372,104 378,530 78,542"/>
   <frame points="378,104 672,104 672,242 678,266 678,284 672,302 672,524 384,530"/>
   <frame points="678,104 978,98 984,518 684,524"/>
   <frame points="78,548 522,536 528,968 78,974"/>
   <frame points="534,536 978,524 984,962 540,968"/>
   <frame points="84,986 528,980 534,1010 534,1016 528,1028 534,1412 84,1418"/>
   <frame points="540,980 978,974 984,1406 546,1412"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="86,116 332,116 335,128 322,148 294,158 276,159 267,172 239,178 190,177 124,173 98,172 88,164"><p>PREPÁČTE, PÁN BRADLEY! UKĹZLA MI RUKA. VYČISTÍM TO BAVLNOU.</p></text-area><text-area bgcolor="#ffffff" points="389,114 638,114 652,129 651,150 638,163 615,171 525,173 524,185 504,191 452,194 404,187 390,182"><p>TO NEBOLA NÁHODA, ŽE JE TAK PÁN WEIR? V TEJ SKÚMAVKE MÁTE KVAPKU JEHO KRVI.</p></text-area><text-area bgcolor="#ffffff" points="446,200 506,200 533,187 614,187 631,201 652,215 663,230 660,247 671,271 670,290 659,301 654,323 640,333 611,327 586,298 462,298 432,289 431,263 432,249 432,227"><p>JE TO TAK, SLEČNA BRADLEYOVÁ. MUSÍM PRESKÚMAŤ JEHO KRV, ABY SOM POROZUMEL TOMU, ČO SA STALO. MÔŽETE ÍSŤ SO MNOU DO MÔJHO LABORATÓRIA.</p></text-area><text-area bgcolor="#f7f699" points="684,110 966,110 966,146 899,147 866,146 841,153 770,153 698,156 686,154" type="commentary"><p>V LABORATÓRIU DOKTORA JONATHANA WEIRA.</p></text-area><text-area bgcolor="#ffffff" points="688,198 694,176 712,166 948,166 963,174 952,194 936,203 900,204 816,211 743,212 700,208"><p><emphasis>TO NIE JE KRV.</emphasis> JE TO NEJAKÁ ŽIVÁ RÁDIOAKTÍVNA TEKUTINA!</p></text-area><text-area bgcolor="#ffffff" points="88,553 274,553 278,566 259,582 219,591 147,591 103,589 88,581"><p>ACH, DOKTOR... ČO TO ZNAMENÁ?</p></text-area><text-area bgcolor="#ffffff" points="308,547 512,547 511,579 476,593 427,603 357,608 316,605 288,591 285,568 296,556"><p>NEVIEM TO S URČITOSŤOU, ALE MYSLÍM, ŽE VÁŠ BRAT JE <emphasis>MŔTVY!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="551,565 585,553 647,553 664,556 669,569 656,580 623,587 582,586 548,577"><p>NEMOŽNÉ!</p></text-area><text-area bgcolor="#ffffff" points="688,539 966,539 972,557 957,581 917,601 833,603 730,607 684,595 670,577 676,553"><p>KVAPALINA V JEHO TELE JE ŽIVÁ, ALE ON JE LEN JEJ NOSIČOM. <emphasis>JEHO TELO JE MŔTVE!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="121,991 261,991 278,1002 268,1021 244,1033 216,1037 130,1039 100,1029 102,1005"><p>NEZVYČAJNÝ ČAS PRE PACIENTA!</p></text-area><text-area bgcolor="#ffffff" points="292,990 482,990 492,999 520,1006 525,1019 515,1031 506,1037 516,1049 516,1061 489,1069 401,1074 305,1072 274,1061 270,1029 281,1005 283,995"><p>JA NIKOHO NEOČAKÁVAM. MYSLÍM, ŽE BUDE LEPŠIE AK ODÍDETE DO VEDĽAJŠEJ IZBY, SLEČNA.</p></text-area><text-area bgcolor="#ffffff" points="552,984 840,984 850,993 841,1003 821,1007 805,1021 756,1026 670,1029 660,1040 626,1047 578,1045 550,1038 548,1005"><p>VOLÁM SA DOKTOR GOOL. RÁD BY SOM SA S VAMI POROZPRÁVAL, DOKTOR WEIR.</p></text-area></text-layer></page>
  <page>
   <image href="PC1_08.webp"/>
   <frame points="36,61 540,61 540,487 36,493"/>
   <frame points="552,61 942,61 942,481 546,487"/>
   <frame points="36,499 336,499 336,535 342,547 342,559 366,571 366,583 348,601 336,601 342,931 36,937"/>
   <frame points="354,499 366,493 612,493 624,505 630,517 630,535 618,553 612,559 624,571 630,583 624,607 606,625 576,637 558,643 582,649 606,667 624,691 624,727 618,757 630,787 636,931 342,937 342,781 354,739 396,721 396,703 390,691 390,655 378,649 366,607 372,577 342,559 342,547 342,529"/>
   <frame points="636,493 942,493 936,925 642,931"/>
   <frame points="42,943 354,943 366,949 366,961 360,973 372,979 372,997 360,1009 360,1369 36,1369"/>
   <frame points="372,937 936,937 930,1375 372,1369"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="49,72 240,72 253,87 245,118 226,138 190,152 186,172 155,182 67,176 47,160"><p>MÁM LEN JEDNU VEC. PRIŠIEL SOM PO SKÚMAVKU S KRVOU, KTORÚ STE VZALI MÔJMU PACIENTOVI TOMOVI BRADLEYMU.</p></text-area><text-area bgcolor="#ffffff" points="268,70 519,70 528,86 520,113 503,127 478,136 475,148 404,154 306,153 261,143 252,120 260,95 260,82"><p>SAMOZREJME PÁN DOKTOR. KEBY SOM TO BOL BÝVAL VEDEL, HNEĎ BY SOM S TÝM ŠIEL ZA VAMI.</p></text-area><text-area bgcolor="#ffffff" points="559,69 721,69 749,83 753,97 764,111 762,124 731,136 688,138 682,147 616,148 576,146 567,131 558,122"><p>MOŽNO MI BUDETE VEDIEŤ NIEČO POVEDAŤ O POVAHE JEHO CHOROBY?</p></text-area><text-area bgcolor="#ffffff" points="768,70 930,70 931,145 880,151 874,164 830,165 789,164 759,156 758,132 767,121 768,103 758,87"><p>TO VÁS NEMUSÍ ZAUJÍMAŤ! AK DO TOHO BUDETE STRKAŤ NOS, TAK TO OĽUTUJETE!</p></text-area><text-area bgcolor="#ffffff" points="46,507 122,507 132,525 124,542 102,552 57,550 46,543"><p>A KEĎ NA TOM TRVÁM?</p></text-area><text-area bgcolor="#ffffff" points="139,507 272,507 303,521 306,533 330,545 334,560 349,569 354,581 338,593 299,599 218,602 154,601 122,594 114,572 126,544 135,529 134,515"><p>TO BY BOLA TRAGÉDIA, KEBY VAŠA LEKÁRSKA KARIÉRA MUSELA SKONČIŤ TAK PREDČASNE!</p></text-area><text-area bgcolor="#ffffff" points="355,504 610,504 622,527 615,546 594,557 567,561 424,561 372,563 352,552 346,530"><p>ROZUMIEM VÁM, PÁN GOOL. NEBUDEM SA UŽ ZAUJÍMAŤ O VÁŠHO PACIENTA.</p></text-area><text-area bgcolor="#ffffff" points="412,567 588,567 615,575 616,598 596,621 549,632 542,643 485,649 454,648 442,641 406,629 387,608 388,587 396,577"><p>DOBRE ROBÍTE. PAMÄTAJTE, ŽE SOM SOM HNEĎ VEDEL O TOM, ŽE STE MU VZALI JEHO KVAPKU KRVI!</p></text-area><text-area bgcolor="#fffda8" points="648,501 929,501 926,573 892,574 860,577 850,587 816,589 760,591 736,590 680,590 657,589 648,575"><p>SLEČNA BRADLEYOVÁ NEVEDELA NIČ O MOJOM VNÚTORNOM ROZHODNUTÍ A VYRÚTILA SA NA MŇA SO STRAŠNOU ZLOBOU POTOM, ČO VYPOČULA NÁS ROZHOVOR S DOKTOROM GOOLOM ...</p></text-area><text-area bgcolor="#ffffff" points="650,603 832,603 840,611 837,625 826,631 828,647 812,661 776,665 716,665 668,662 650,646"><p>TO NEMÔŽETE MYSLIEŤ VÁŽNE, DOKTOR WEIR! TO STE TAKÝ <emphasis>ZBABELEC?</emphasis></p></text-area><text-area bgcolor="#ffffff" points="45,948 355,948 361,956 348,973 352,978 363,981 368,989 362,1000 310,1006 192,1009 84,1006 45,998"><p>POSTARÁM SA O TO SAMA! NÁJDEM TOHTO DOKTORA GOOLA A VYTIAHNEM Z NEHO PRAVDU, KEĎ VY NIE STE RIADNYM MUŽOM!</p></text-area><text-area bgcolor="#ffffff" points="99,1037 104,1025 118,1015 336,1015 341,1026 323,1045 283,1054 216,1059 129,1057 104,1049"><p>NIE, SLEČNA BRADLEYOVÁ! TOTO JE PRÍLIŠ NEBEZPEČNÉ...</p></text-area><text-area bgcolor="#fa676f" points="380,945 832,945 838,945 832,970 827,985 803,986 789,993 757,997 688,1000 627,1001 487,999 430,998 384,995 378,982"><p>"JE TO PRAVDA. TOTO BOLO NAD SILY DOKTORA JONATHANA WEIRA! DOKTOR BY SA DO TOHO NEPUSTIL, ALE BOL TU NIEKTO INÝ..."</p></text-area><text-area bgcolor="#ffffff" points="388,1065 400,1039 420,1021 466,1012 640,1012 648,1012 672,1019 679,1038 642,1069 647,1087 603,1111 496,1111 423,1104 395,1087"><p>NADIŠIEL ČAS PRE PRÍCHOD MOCNEJŠEJ MYSLE A BYTOSTI... PRE SILU POCHÁDZAJÚCU Z <emphasis>FIALOVÉHO DRÁPU!</emphasis></p></text-area></text-layer></page>
  <page>
   <image href="PC1_09.webp"/>
   <frame points="66,62 402,62 414,104 432,110 468,98 480,140 474,152 492,158 480,188 504,212 498,260 510,284 498,302 510,320 504,332 510,350 504,374 504,398 480,404 504,428 474,440 504,470 498,476 450,470 444,482 426,488 402,488 384,482 372,488 342,482 324,494 318,494 294,482 264,488 228,488 210,494 198,488 198,476 102,488 90,482 114,458 72,464 66,452 84,434 120,416 78,416 90,392 54,380 60,362"/>
   <frame points="510,62 960,62 960,482 510,488"/>
   <frame points="60,500 360,494 366,926 60,926"/>
   <frame points="366,494 654,494 666,512 660,530 654,536 654,926 372,926 366,494"/>
   <frame points="666,494 954,488 954,920 666,920"/>
   <frame points="54,932 504,932 504,1370 54,1370"/>
   <frame points="510,932 954,926 954,1370 510,1370"/>
  <text-layer lang="sk"><text-area bgcolor="#ff8494" points="74,74 263,74 261,97 253,102 110,101 77,99 73,94"><p><emphasis>FIALOVÝ DRÁP!</emphasis></p></text-area><text-area bgcolor="#fefeff" points="518,106 521,123 531,133 541,135 541,142 546,150 578,154 647,154 652,147 701,146 751,133 771,113 777,101 779,84 774,75 768,74 531,74 518,85"><p>ČO ZA LEKÁRA JE TENTO DOKTOR GOOL? MÁ PACIENTOV, KTORÍ SÚ UŽ PO SMRTI?</p></text-area><text-area bgcolor="#ffffff" points="75,507 283,507 289,518 260,528 215,532 204,544 140,548 100,543 91,533 69,524"><p>UNIESLI SLEČNU BRADLEYOVÚ!</p></text-area><text-area bgcolor="#ffffff" points="278,568 297,556 335,556 343,569 342,585 330,595 304,598 278,591"><p>POMÓC!</p><p>POMÓC!</p></text-area><text-area bgcolor="#ffffff" points="231,706 327,676 327,720 243,744 228,740" text-rotation="16" type="sign"><p>SANATÓRIUM DOKTORA GOOLA</p></text-area><text-area bgcolor="#ffffff" points="374,503 648,503 658,515 639,536 627,565 602,579 512,583 434,580 388,576 373,569"><p>MYSLÍ SI, ŽE NEPOZNÁM SILU FIALOVÉHO DRÁPU, BLÁZON. NEVIE, ŽE VIEM O VŠETKOM, ČO ZISTIA <emphasis>MOJI SLUŽOBNÍCI!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="671,496 932,496 941,512 933,530 919,540 898,541 883,554 840,554 705,557 669,552"><p>PRIVEĎTE MI HO SEM! URČITE OCENÍ, KEĎ NA VLASTNÉ OČI UVIDÍ, AKO FUNGUJE MÔJ VYNÁLEZ!</p></text-area><text-area bgcolor="#ffffff" points="89,943 289,943 301,957 289,978 255,988 195,991 117,993 79,987 65,969 73,955"><p>NEMŔTVI! NADO MNOU NEMÁTE ŽIADNU MOC!</p></text-area><text-area bgcolor="#d1ebeb" points="522,939 946,939 946,997 923,1000 902,1006 883,1009 840,1011 787,1011 679,1012 621,1010 578,1013 566,1018 554,1017 542,1015 524,1019 518,1011" type="commentary"><p>"NIKDY MA NEZASTAVILA ŽIADNA ŽIJÚCA BYTOSŤ, A ANI MA NEDOKÁŽE ZASTAVIŤ ŽIADEN NEMŔTVY A ZABRÁNIŤ MI DOSTAŤ SA DO AREÁLU SANATÓRIA DOKTORA GOOLA..."</p></text-area></text-layer></page>
  <page>
   <image href="PC1_10.webp"/>
   <frame points="48,82 528,82 528,508 48,514"/>
   <frame points="534,82 948,82 948,502 534,508"/>
   <frame points="48,520 282,520 294,532 300,544 300,562 294,580 282,610 288,946 48,946"/>
   <frame points="293,530 298,519 522,520 528,526 522,538 504,550 492,556 486,568 462,586 492,616 498,634 498,658 492,742 486,766 522,790 534,808 534,946 294,946 294,862 288,844 294,814 312,802 306,778 318,754 360,730 360,688 360,658 372,622 402,574 330,574 300,568 297,544"/>
   <frame points="534,514 942,508 942,946 540,946"/>
   <frame points="42,952 534,952 540,1390 42,1384"/>
   <frame points="540,952 942,952 936,1390 540,1390"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="74,90 452,90 456,106 414,118 350,118 338,133 238,135 95,132 63,126 64,106"><p>STOVKY NEMŔTVYCH! DOKTOR GOOL VYBUDOVAL HRÔZOSTRAŠNÚ ARMÁDU!</p></text-area><text-area bgcolor="#ffffff" points="544,92 695,92 706,113 695,133 706,155 698,175 670,189 609,191 543,178"><p>ZNOVA SA STRETÁVAME, DOKTOR WEIR! ALEBO VÁS MAM NAZÝVAŤ FIALOVÝM DRÁPOM?</p></text-area><text-area bgcolor="#ffffff" points="724,93 935,93 936,125 921,148 875,163 791,163 753,162 722,150 714,119"><p>ÁNO, DOKTOR GOOL... STRETÁVAME SA ZNOVA... A TENTORAZ UŽ ASI AJ <emphasis>NAPOSLEDY!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="54,526 278,526 293,545 289,577 261,619 220,637 128,639 71,633 55,625"><p>POĎTE SO MNOU A UKÁŽEM VÁM ZÁHADY ŽIVÝCH NEMŔTVYCH! MAL BY STE SA K NÁM PRIPOJIŤ! <emphasis>JA NIE SOM OBYČAJNÝ LEKÁR ŽIVÝCH!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="299,524 521,524 517,539 492,548 480,551 478,563 418,564 336,565 300,559"><p>DO MÔJHO LABORATÓRIA! K MÔJMU NOVÉMU PACIENTOVI!</p></text-area><text-area bgcolor="#ffffff" points="566,534 580,520 860,520 861,530 837,540 766,542 699,548 584,546"><p>AKO VIDÍM, VŠETKO UŽ JE PRIPRAVENÉ.</p></text-area><text-area bgcolor="#ffffff" points="74,963 313,963 322,977 306,989 291,998 176,1001 89,1000 62,991 64,976"><p>POZRITE SA NA TO, VY SMRTEĽNÝ BLÁZON. A POCHOPÍTE.</p></text-area><text-area bgcolor="#ffffff" points="558,962 746,962 748,971 740,978 716,981 673,983 669,997 638,1001 594,1002 560,998 549,989 550,973"><p>VIETE, O ČOM JE MOJA TEKUTINA?</p></text-area><text-area bgcolor="#ffffff" points="761,963 921,963 930,979 919,999 891,1016 846,1023 778,1023 740,1013 730,998 747,981"><p>ÁNO, JE TO ŽIVÁ RÁDIOAKTÍVNA LÁTKA. NIE JE TO KRV!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_11.webp"/>
   <frame points="42,80 480,80 486,512 36,512"/>
   <frame points="486,80 942,80 942,506 492,512"/>
   <frame points="36,518 336,518 342,950 36,950"/>
   <frame points="348,518 630,518 636,950 354,950"/>
   <frame points="642,512 936,512 936,944 648,944"/>
   <frame points="36,956 480,956 480,1388 30,1382 36,956"/>
   <frame points="486,956 936,956 930,1394 486,1388 486,956"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="51,93 446,93 464,114 464,140 441,162 387,169 251,166 238,184 134,190 85,184 64,168 50,151"><p>A TO JE LEN ZAČIATOK! JE TO TAKISTO ŽIJÚCI ZÁZNAM SVOJEJ VLASTNEJ MINULOSTI. ANI KVAPKA NEUNIKNE. ATÓMOVÉ IMPULZY VŠETKO ZAZNAMENÁVAJÚ NA MOJOM FÚZIOVOM MERAČI TEKUTÍN.</p></text-area><text-area bgcolor="#ffffff" points="499,92 758,92 764,100 758,113 740,122 736,136 712,146 635,148 596,148 596,162 576,168 533,165 507,155 498,145"><p>TEN MI ZÁROVEŇ AJ PREZRADIL, ŽE STE VZALI KRV Z TELA PÁNA BRADLEYHO.</p></text-area><text-area bgcolor="#ffffff" points="766,113 773,99 785,91 910,91 922,109 914,128 895,142 867,148 833,152 797,148 767,140"><p>A PREZRADIL VÁM MOJU IDENTITU?</p></text-area><text-area bgcolor="#ffffff" points="46,525 327,525 330,563 307,574 260,580 230,582 225,593 192,599 107,597 64,596 47,587"><p>ÁNO. PREZRADIL MI VAŠE TAJOMSTVO. ZABÚDATE NA TO, ŽE KDEKOĽVEK JE MOJA TEKUTINA, ODTIAĽ SA KU MNE DOSTANÚ INFORMÁCIE.</p></text-area><text-area bgcolor="#ffffff" points="105,625 118,609 132,604 220,604 236,593 242,587 310,587 324,599 314,617 318,635 306,655 274,664 238,667 166,666 130,659 106,650"><p>KEĎ STE ALE ODIŠLI SO SKÚMAVKOU, AKO STE SA POTOM MOHLI O MNE DOZVEDIEŤ VIAC?</p></text-area><text-area bgcolor="#ffffff" points="358,523 621,523 622,585 610,606 572,619 558,623 547,639 463,641 393,635 372,617 359,605"><p>ZABÚDATE NA TO, ŽE MOJA TEKUTINA TIEŽ VSIAKLA DO BAVLNY, KTOROU STE PÁNU BRADLEYMU VYČISTILI RUKU. CELÝ TEN ČAS LEŽALA NA VAŠOM STOLE!</p></text-area><text-area bgcolor="#ffffff" points="650,521 916,521 924,533 921,553 902,575 916,585 918,601 902,617 853,619 844,633 818,641 764,642 708,643 687,639 678,630 650,623"><p>ALE DOSŤ BOLO REČÍ. AKÝM NÁDHERNÝM DOPLNKOM BUDE JEJ TELO V MOJEJ ARMÁDE. TOTO VŠETKO SÚ ĽUDSKÉ NOSIČE MOJEJ ZÁZRAČNEJ TEKUTINY... VŠETCI SÚ SLUŽOBNÍCI MOJICH PLÁNOV!</p></text-area><text-area bgcolor="#ffffff" points="52,965 180,965 188,976 179,987 155,991 103,993 66,993 46,985"><p>AKÝCH PLÁNOV?</p></text-area><text-area bgcolor="#ffffff" points="212,965 462,965 467,977 467,1006 452,1027 415,1042 360,1051 296,1054 228,1047 199,1035 191,1007 201,981"><p>VYTVÁRAM <emphasis>KRÁĽOVSTVO MŔTVYCH</emphasis>. A S ICH POMOCOU SI PODMANÍM <emphasis>CELÝ SVET ŽIVÝCH!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="507,965 782,965 788,983 773,1006 764,1017 758,1033 725,1047 654,1053 561,1053 519,1051 505,1037 510,1020 501,991"><p>A TERAZ JU POLOŽÍM NA DRENÁŽNU PLATŇU. UVIDÍTE, AKO BUDE JEJ BEZCENNÁ KRV VYMENENÁ ZA NESMRTEĽNÚ TEKUTINU!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_12.webp"/>
   <frame points="42,88 594,88 588,514 36,514"/>
   <frame points="600,88 942,88 942,514 600,514"/>
   <frame points="36,526 336,526 330,952 36,952"/>
   <frame points="348,520 630,520 630,958 342,958"/>
   <frame points="636,520 936,520 936,958 636,958 636,838 630,820 630,802 636,784 636,754 636,598 630,580 630,562 636,544"/>
   <frame points="36,964 630,964 630,1000 642,1012 648,1024 648,1036 642,1054 636,1060 648,1078 648,1090 642,1102 630,1114 624,1396 30,1396"/>
   <frame points="630,994 636,970 648,958 684,958 918,958 936,976 936,1006 930,1042 936,1054 924,1078 930,1102 924,1120 924,1162 930,1180 930,1192 918,1222 930,1270 924,1288 930,1324 930,1354 924,1378 894,1396 726,1396 684,1402 630,1396 624,1378 624,1348 636,1312 630,1294 642,1282 654,1288 654,1234 642,1222 654,1186 648,1162 648,1078 654,1060 648,1036 648,1024 642,1018 636,1006"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="74,119 87,112 393,112 386,231 354,249 311,254 89,256 85,204" type="commentary"><p>"BOLO TO VTEDY, KEĎ SOM ÚPLNE POCHOPIL BLÁZNOVSTVO DOKTORA GOOLA. MÔJ ROZHOVOR S NÍM BOL NA KONCI. BOLO TREBA VYKONAŤ SKUTKY NA ZASTAVENIE ZLA. ALICA BRADLEYOVÁ BOLA LEN NIEKOĽKO SEKÚND VZDIALENÁ OD HROZNÉHO OSUDU, KTORÝ UŽ POSTIHOL JEJ BRATA..."</p></text-area><text-area bgcolor="#faf7a6" points="630,124 629,109 814,109 821,124 805,130 638,130"><p>"ZAÚTOČIL SOM..."</p></text-area><text-area bgcolor="#ffffff" points="623,163 635,150 645,146 729,146 747,150 756,163 741,178 681,181 637,173"><p><emphasis>CHYŤTE HO!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="842,149 853,137 867,131 907,131 923,140 923,156 909,168 879,174 855,174 837,164"><p>NIKDY VIAC!</p></text-area><text-area bgcolor="#ffffff" points="65,533 265,533 271,541 265,560 240,570 218,573 211,585 189,590 119,588 97,578 65,572 51,563 50,545"><p>KEĎ ZAÚTOČÍ FIALOVÝ DRÁP, VŠETKO ZLO BUDE ZLIKVIDOVANÉ!</p></text-area><text-area bgcolor="#ffffff" points="52,624 55,611 73,599 117,599 130,607 133,627 121,641 94,648 71,644 57,638"><p>SME STRATENÍ!</p></text-area><text-area bgcolor="#ffffff" points="357,530 572,530 593,540 592,554 564,568 492,569 373,569 357,561"><p>TEKUTINA... TEKUTINA... TÁ TEKUTINA MUSÍ ZOSTAŤ!</p></text-area><text-area bgcolor="#ffffff" points="665,529 902,529 917,543 916,559 900,569 855,573 847,583 773,588 769,597 755,605 725,611 698,617 656,610 637,589 643,555"><p>JA ZOMRIEM TAKISTO, KEĎŽE SOM SVOJE TELO NAPLNIL RÁDIOAKTÍVNOU LÁTKOU A PRIDAL SA TAK K MOJIM LÉGIÁM!</p></text-area><text-area bgcolor="#ffffff" points="749,640 755,617 783,601 891,601 925,607 929,620 923,633 901,646 887,650 884,665 861,680 815,683 772,677 754,660"><p>TY BLÁZON, VERIL SI VO SVOJE VLASTNÉ DIVOKÉ PREDSTAVY!</p></text-area><text-area bgcolor="#f5b6c1" points="43,971 349,971 347,999 347,1005 368,1006 371,1013 365,1032 353,1032 359,1047 350,1052 356,1062 353,1069 351,1083 343,1094 343,1105 347,1111 343,1117 342,1138 341,1149 288,1147 267,1148 218,1152 209,1155 191,1153 106,1156 79,1158 42,1161" type="commentary"><p>ŽIVOT BOL MILOSRDNÝ K ALICI BRADLEYOVEJ. TO, ŽE BOLA V BEZVEDOMÍ, JU UCHRÁNILO PRED VEDMOSŤOU O HRÔZOSTRAŠNÝCH POSLEDNÝCH CHVÍĽACH V SANATÓRIU. NEDOZVEDELA SA ANI NIČ O STRAŠNÝCH PLÁNOCH DOKTORA GOOLA, ANI O SMRTEĽNEJ POMSTE FIALOVÉHO DRÁPA...</p></text-area><text-area bgcolor="#ffffff" points="51,1242 59,1218 74,1197 127,1174 153,1174 258,1174 303,1182 329,1204 333,1226 301,1264 275,1282 187,1290 101,1288 64,1279 53,1262"><p>SOM RADA, ŽE SME SA ZBAVILI DOKTORA GOOLA. BUDE TO TAK LEPŠIE PRE TOMA A AJ MOJU MATKU, ŽE TÁ HRÔZA JE PREČ.</p></text-area><text-area bgcolor="#ffffff" points="394,1060 413,1024 438,1000 472,987 599,987 619,994 622,1004 637,1024 637,1049 626,1068 641,1086 630,1106 609,1110 583,1120 550,1120 537,1123 450,1126 419,1110 400,1090"><p>SNAŽTE SA NA TO ZABUDNÚŤ, AKO NA ZLÚ NOČNÚ MORU Z INÉHO SVETA! DIABOLSKÝ PLÁN DOKTORA GOOLA NA OVLÁDNUTIE CELÉHO SVETA HO NAČISTO POHLTIL.</p></text-area><text-area bgcolor="#faff8b" points="678,1004 928,1004 922,1038 926,1054 913,1075 920,1104 914,1124 919,1141 915,1169 923,1177 918,1196 913,1210 905,1212 677,1214" type="commentary"><p>"A TAK SA SKONČIL JEDEN Z NAJHRÔZOSTRAŠNENJŠÍCH PRÍBEHOV Z MOJEJ KNIHY TAJOMSTIEV. ROZPOVIEM TI, MÔJ ČITATEĽ, AJ ĎALŠIE PRÍBEHY V NADCHÁDZAJÚCICH DŇOCH O HRÔZACH A ZLE, O ZVLÁŠTNOSTIACH A O NEZNÁME, O TAJOMSTVÁCH HROBKY A POUČENÍ."</p></text-area></text-layer></page>
  <page>
   <title>The Devil is a Dame</title>
   <image href="PC1_13.webp"/>
   <frame points="84,76 612,76 612,148 588,160 576,172 576,196 588,220 612,232 612,316 582,313 531,310 495,313 465,319 444,334 435,355 435,379 84,376"/>
