   <frame points="612,64 978,64 972,694 636,694 642,670 648,658 648,604 648,592 618,544 618,418 648,406 666,388 672,370 666,346 642,328 612,316 612,232 588,220 576,196 576,172 594,154 612,148"/>
   <frame points="402,814 402,778 408,766 414,742 420,730 432,736 438,730 432,712 444,700 456,706 468,712 474,706 474,700 552,700 618,700 636,700 810,694 828,688 834,700 846,688 864,694 888,694 894,694 900,688 918,694 936,694 936,706 948,712 966,706 972,712 966,730 972,748 966,772 972,820 960,814 948,826 948,838 966,844 954,862 960,880 948,892 936,880 930,898 894,898 852,892 774,898 696,910 672,904 630,904 606,910 576,922 564,916 558,904 534,898 528,916 522,922 462,922 456,928 444,922 420,916 420,904 414,898 396,904 396,880 402,874 396,862 396,832"/>
   <frame points="72,946 372,946 372,1378 72,1378"/>
   <frame points="378,946 666,946 666,1378 378,1378"/>
   <frame points="672,940 972,940 972,1378 672,1378"/>
  <text-layer lang="sk"><text-area bgcolor="#e7eceb" points="86,78 448,78 448,207 83,207"><p><strong>FIALOVÝ DRÁP</strong> v príbehu</p></text-area><text-area bgcolor="#e7eceb" points="84,205 449,205 449,322 426,361 82,361" type="heading"><p>"DIABLOM JE ŽENA!"</p></text-area><text-area bgcolor="#ffffff" points="580,185 580,196 584,204 595,215 623,227 647,230 655,232 717,232 768,224 797,212 809,200 813,192 811,177 793,160 754,145 736,144 726,143 681,143 622,150 601,159 585,175"><p>NEMRHAJ ČASOM NA KLADENIE OTÁZOK, LUG, ZAČNI STRIEĽAŤ!</p></text-area><text-area bgcolor="#ffffff" points="442,354 442,377 445,384 459,398 470,405 484,407 486,410 623,410 645,402 665,378 665,363 662,355 646,336 628,326 597,319 566,319 504,319 487,319 463,328 447,344"><p>PREČO SI SEM LEN MUSEL PRÍSŤ STRKAŤ TEN SVOJ NOS, POLIŠ? PREČO? PREČO?</p></text-area><text-area bgcolor="#ffffff" points="195,429 194,427 186,419 185,419 181,415 178,415 176,415 154,415 151,415 146,415 144,416 141,419 137,420 132,425 131,425 126,431 126,433 123,437 123,444 126,449 132,453 163,453 167,450 176,450 182,445 185,445 189,441 190,441 195,435"><p>ACH!</p></text-area><text-area bgcolor="#ffffff" points="429,889 427,745 457,719 477,719 485,707 920,707 941,721 960,731 964,747 941,814 915,879 557,879 513,892" type="commentary"><p>VRAŽDY... PREPADNUTIA BÁNK... BOLI LEN ČASŤOU VLNY ZLOČINNOSTI, KTORÁ ZASIAHLA METROPOLIS A ZANECHALA POLÍCIU V NEMOHÚCNOSTI! NAJLEPŠIE MOZGY MESTA, ŠTÁTU A NÁRODNÝCH AGENTÚR BOJUJÚCICH PROTI ZLOČINU ZLYHÁVALI AŽ DOKIAĽ SA NEOBJAVIL <emphasis>DOKTOR JONATHAN WEIR,</emphasis> MAJITEĽ <emphasis>FIALOVÉHO DRÁPU</emphasis> A NEPOSTAVIL SA PROTI EXOTICKEJ KRÁSKE GANGSTROV BRIME STONE A NEZISTIL, ŽE <emphasis>DIABLOM JE ŽENA!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="82,950 359,950 361,991 346,1022 323,1044 255,1050 229,1048 221,1062 162,1068 108,1066 92,1062 90,1053 81,1044"><p>PRESTAŇ SA HRAŤ S TÝM REVOLVEROM, BRIMA, AKOBY TO BOLA MAČKA ALEBO ČO! ODVTEDY, ČO SI MI HO DALA, VŠETKO, ČO ROBÍM, JE LEN ZABÍJANIE. UŽ S TÝM KONČÍM!</p></text-area><text-area bgcolor="#ffffff" points="385,950 651,950 651,988 639,993 524,993 523,1015 507,1025 481,1026 443,1023 434,1013 404,1010 385,1000"><p>TAKŽE TY MÁŠ NEJAKÉ SVEDOMIE, LUG? TÝM PÁDOM ŤA UŽ NEPOTREBUJEM!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_14.webp"/>
   <frame points="24,71 924,71 924,503 24,503"/>
   <frame points="24,515 345,512 354,524 357,533 357,542 351,551 336,563 324,566 315,566 315,602 321,608 321,617 318,626 321,944 24,944"/>
   <frame points="345,512 621,509 618,944 330,944 327,566 342,560 351,551 357,542 357,530 351,521"/>
   <frame points="630,509 924,506 924,941 627,941"/>
   <frame points="24,983 36,962 48,956 123,956 210,953 453,953 462,965 465,977 462,992 450,1004 417,1016 432,1025 438,1037 447,1046 423,1067 444,1067 450,1076 450,1088 456,1094 429,1112 429,1133 441,1148 417,1154 417,1169 444,1184 441,1193 444,1202 423,1205 447,1235 450,1247 438,1250 456,1268 441,1286 429,1286 441,1301 432,1313 411,1310 405,1322 396,1322 402,1337 372,1337 357,1349 354,1364 339,1373 315,1376 303,1370 309,1358 291,1352 273,1361 255,1361 246,1379 222,1379 189,1376 189,1367 156,1355 135,1376 114,1358 90,1367 69,1352 75,1322 87,1307 39,1316 27,1310 39,1298 21,1286 24,1274 57,1253 45,1244 51,1232 30,1229 33,1205 54,1199 63,1187 54,1175 57,1166 81,1154 93,1148 72,1106 39,1079 39,1058 72,1073 105,1085 87,1043 84,1028 72,1019 42,1016 24,1004 21,992"/>
   <frame points="474,953 918,947 918,1385 474,1385"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="26,88 209,88 209,361 27,361" type="commentary"><p>SILY DOBRA A ZLA VEDÚ PROTI SEBE NEUSTÁLE BOJ. DEŇ ZA DŇOM, HODINU ZA HODINOU. STENA, DO KTOREJ NARAZILO AUTO, OBKLOPOVALA DOM DOKTORA JONATHANA WIERA.</p></text-area><text-area bgcolor="#ffffff" points="293,95 303,85 535,85 547,97 529,110 503,115 364,113 309,109"><p>KDE TO... KDE TO SOM?</p></text-area><text-area bgcolor="#ffffff" points="546,131 552,112 561,101 577,85 754,85 759,101 776,107 783,121 770,147 756,161 753,176 731,184 674,185 639,182 623,172 569,167 551,156"><p>V MOJOM DOME. LUG GARRISON, VÁŠ VODIČ, JE MŔTVY. OČIVIDNE BOL ZASTRELENÝ UŽ PRED NÁRAZOM!</p></text-area><text-area bgcolor="#ffffff" points="38,522 343,522 352,536 343,555 319,560 258,564 221,559 212,546 43,546 33,536"><p>ČO S TÝM HODLÁTE UROBIŤ, DOKTOR WEIR?</p></text-area><text-area bgcolor="#ffffff" points="31,574 44,553 204,553 211,563 235,572 267,574 271,587 299,597 315,614 305,629 283,633 259,633 247,648 212,653 164,649 154,636 103,626 81,601 44,595"><p>TAK VY POZNÁTE MOJE MENO. SOM POCTENÝ. NAPRIEK TOMU ZAVOLÁM POLÍCIU.</p></text-area><text-area bgcolor="#ffffff" points="359,519 613,519 611,554 579,559 433,559 425,580 423,598 409,609 382,613 357,607 352,589 349,559 359,537"><p>DOTKNETE SA TOHO TELEFÓNU A JE PO VÁS. PRIDAJTE SA KU MNE A BUDETE NAVŽDY BOHATÝ!</p></text-area><text-area bgcolor="#ffffff" points="433,580 452,565 572,565 589,573 589,581 606,594 603,616 579,630 526,630 473,629 445,625 436,612 435,599"><p>LUG GARRISON NEŽIL PRÍLIŠ DLHO, NIE JE TAK?</p></text-area><text-area bgcolor="#ffffff" points="646,515 883,515 887,531 865,551 820,561 787,563 765,574 732,575 692,575 672,562 651,558 638,541 639,528"><p>BOL PRÍLIŠ MÄKKÝ A ZBABELÝ. ZOMRIETE AKO ON, DOKTOR WEIR!</p></text-area><text-area bgcolor="#ffffff" points="31,992 35,976 49,963 119,963 135,981 126,1004 77,1010 39,1008"><p>DAJTE MI TÚ ZBRAŇ!</p></text-area><text-area bgcolor="#ffffff" points="155,995 160,976 173,962 447,962 457,978 443,998 401,1005 327,1010 224,1010 175,1006"><p>FIALOVÝ DRÁP! VY STE MAJITEĽ FIALOVÉHO DRÁPU!</p></text-area><text-area bgcolor="#ffffff" points="497,962 831,962 845,976 829,999 774,1008 669,1012 564,1012 505,1005 491,983"><p>BUDEM S VAMI BOJOVAŤ NESKÔR, FIALOVÝ DRÁP! BUDEME BOJOVAŤ A ZNIČÍM VÁS!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_15.webp"/>
   <frame points="66,86 522,86 522,110 516,128 516,152 522,170 522,518 60,524"/>
   <frame points="534,92 546,86 966,86 966,512 540,512 534,176 516,158 516,128 522,110"/>
   <frame points="66,530 360,524 366,962 60,962"/>
   <frame points="372,956 372,530 660,530 660,956"/>
   <frame points="666,518 966,518 966,956 666,956"/>
   <frame points="60,968 510,968 510,1400 60,1400"/>
   <frame points="516,986 528,968 936,962 942,974 942,986 924,1004 828,1010 864,1034 876,1052 876,1082 924,1142 936,1184 942,1220 942,1274 942,1292 924,1334 918,1364 930,1394 930,1400 516,1400"/>
  <text-layer lang="sk"><text-area bgcolor="#f5b6c1" points="74,94 511,94 511,116 445,116 367,115 252,116 215,122 209,131 152,130 105,130 77,130 73,122" type="commentary"><p>NA NÁVRH DOKTORA WEIRA JE V KANCELÁRII STAROSTU JONESA USPORIADANÁ PORADA.</p></text-area><text-area bgcolor="#ffffff" points="73,136 213,136 231,125 305,125 319,140 307,166 269,176 179,174 102,169 76,165"><p>VŠETCI STE POČULI PRÍBEH DOKTORA WEIRA. ČO SI O TOM MYSLÍTE?</p></text-area><text-area bgcolor="#ffffff" points="309,177 321,158 327,142 327,128 339,126 485,126 503,138 502,161 489,176 385,174 386,192 378,208 346,212 315,208 306,194"><p>BOSORKA, KTORÁ VELÍ CELÉMU PODSVETIU? TO JE ÚPLNE ABSURDNÉ, PÁN STAROSTA!</p></text-area><text-area bgcolor="#ffffff" points="546,97 951,97 957,114 944,142 915,155 869,160 769,159 757,174 595,176 544,167 520,145 527,116"><p>NAOZAJ, PÁN MATTHEWS? POVIEM VÁM EŠTE NIEČO INÉ. TÁTO ZBRAŇ JE STRÁŽCOM BRIMY STONE, DÉMONOM, KTORÝ JU OCHRAŇUJE... POSKYTNUTÝ SAMOTNÝM SATANOM!</p></text-area><text-area bgcolor="#ffffff" points="81,535 331,535 337,548 309,560 212,561 133,562 79,559 73,544"><p>TAKÉ NIEČO SOM EŠTE NEPOČUL!</p></text-area><text-area bgcolor="#ffffff" points="157,569 339,569 353,579 342,597 315,601 302,613 224,617 178,616 154,606 149,587"><p>TÁ ZBRAŇ SA HÝBE! POZRITE!</p></text-area><text-area bgcolor="#ffffff" points="375,583 389,564 427,547 585,547 617,554 633,570 619,589 542,591 465,593 452,609 406,613 381,604"><p>JONES, MATTHEWS, K ZEMI! K ZEMI! VŠETCI K ZEMI!</p></text-area><text-area bgcolor="#ffffff" points="79,976 319,976 313,995 259,1003 233,1004 227,1015 151,1015 93,1016 73,1003"><p>NABUDÚCE, PÁNI, MOJA ZBRAŇ UŽ NEMINIE!</p></text-area><text-area bgcolor="#ffffff" points="533,974 930,974 931,990 905,996 806,998 674,1002 674,1019 653,1034 573,1035 534,1031 520,1005 524,988"><p>ZDÁ SA MI TO, ALEBO SKUTOČNE CÍTIM PACH SÍRY?</p></text-area></text-layer></page>
  <page>
   <image href="PC1_16.webp"/>
   <frame points="48,78 948,78 948,504 42,510"/>
   <frame points="42,516 336,516 336,948 42,948"/>
   <frame points="342,510 636,510 636,948 342,948"/>
   <frame points="642,510 942,510 942,948 642,948"/>
   <frame points="36,954 384,954 396,978 396,1002 396,1014 384,1038 390,1050 390,1062 384,1074 360,1104 384,1098 396,1104 384,1122 402,1128 390,1146 390,1170 372,1182 402,1200 396,1212 402,1248 396,1266 408,1302 396,1320 402,1350 384,1356 378,1368 378,1380 366,1386 30,1386 30,1326 48,1302 30,1296 36,1278 24,1260 60,1218 30,1200 36,1188 60,1182 36,1164 36,1146 42,1128 60,1128 54,1110 48,1092 36,1086"/>
   <frame points="402,954 942,954 936,1392 408,1386"/>
  <text-layer lang="sk"><text-area bgcolor="#f5f183" points="53,84 432,84 434,98 421,109 409,112 387,126 368,132 361,147 274,150 200,148 146,148 135,142 133,125 88,123 54,124" type="commentary"><p>BRIMA STONE BOLA TERAZ K NEZASTAVENIU A METROPOLIS SA TAK STAL SEMENIŠŤOM ZLOČINU A KORUPCIE!</p></text-area><text-area bgcolor="#ffffff" points="51,522 312,522 322,534 315,554 328,566 320,578 288,584 128,584 118,598 88,606 57,602 49,590"><p>SME NAHRANÍ, WEIR, CELÉ POLICAJNÉ ODDELENIE VRÁTANE MŇA. TÁTO BRIMA STONE JE SAMOTNÝM DIABLOM.</p></text-area><text-area bgcolor="#ffffff" points="142,605 151,592 284,592 299,602 319,618 324,638 312,660 290,674 245,680 241,690 186,691 160,684 122,677 102,656 106,633 120,614"><p>NIKTO NEBUDE V BEZPEČÍ, AK NÁM NEPOMÔŽETE. METROPILIS SA STANE MESTOM DUCHOV!</p></text-area><text-area bgcolor="#ffffff" points="354,521 624,521 624,669 608,693 558,706 516,714 440,710 390,702 351,690"><p>PRICHÁDZAJÚ ZA MNOU A ŽIADAJÚ O POMOC... ČO JA ALE DOKÁŽEM UROBIŤ? ANI SILA FIALOVÉHO DRÁPU NIE JE NIČ PLATNÁ, DOKIAĽ SA ZNOVA NESTRETNEM S BRIMOU STONE ZOČI VOČI! ONA SA ALE OBJAVÍ, OKRADNE, ZABIJE A VZÁPÄTÍ ZMIZNE POD RÚŠKOM NOCI!</p></text-area><text-area bgcolor="#ffffff" points="662,518 920,518 929,532 917,544 730,546 725,564 682,566 661,558 652,543"><p>LUC GARRISON VRACAJÚCI SA ZO ZÁHROBIA!</p></text-area><text-area bgcolor="#ffffff" points="755,570 770,554 922,554 935,559 935,628 904,638 858,642 848,652 792,658 757,659 736,648 707,637 696,612 708,584 726,571"><p>ÁNO SOM TO JA, PRETOŽE NEBUDE PRE MŇA POKOJA, DOKIAĽ ZBRAŇ BRIMY STONE NEBUDE UMLČANÁ <emphasis>NATRVALO!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="47,963 376,963 387,990 384,1026 368,1040 378,1056 371,1074 340,1085 276,1086 274,1104 245,1109 66,1106 58,1087 44,1080"><p>AK ČLOVEK STLAČÍ KOHÚTIK JEJ ZBRANE A VEZME TÝM NIEKOMU ŽIVOT, NAVŽDY JEJ BUDE PATRIŤ JEHO TELO A DUŠA. ZAKAŽDÝM, KEĎ TERAZ NÁBOJ TRAFÍ SRDCE ĎAĽŠEJ OBETE, CÍTIM TO JA SÁM. LEN FIALOVÝ DRÁP MI MÔŽE POMÔCŤ ZNIČIŤ TO ZLO!</p></text-area><text-area bgcolor="#ffffff" points="427,964 710,964 721,983 703,1011 668,1027 601,1033 548,1031 477,1033 433,1029 413,1011 414,979"><p>VEZMEM VÁS TERAZ DO KOMNATY HRÔZY, Z KTOREJ SA EŠTE ŽIADEN ČLOVEK NIKDY NEVRÁTIL!</p></text-area><text-area bgcolor="#fdfffe" points="735,1002 735,1012 750,1027 753,1027 756,1030 760,1030 767,1033 799,1033 802,1032 815,1032 826,1029 833,1029 835,1027 842,1025 853,1014 855,1006 855,997 853,992 845,983 831,975 823,975 820,973 814,973 812,971 798,971 776,971 760,973 750,979 741,988 738,998"><p>SOM PRIPRAVENÝ, POĎME.</p></text-area></text-layer></page>
  <page>
   <image href="PC1_19.webp"/>
   <frame points="36,57 606,57 612,489 36,495"/>
   <frame points="606,57 930,57 936,477 612,483"/>
   <frame points="42,549 60,525 96,513 126,513 162,531 174,543 174,561 216,537 264,531 318,549 330,561 330,585 348,597 354,651 360,669 360,699 396,693 396,927 30,933 24,915 42,891 48,867 42,837 54,807 72,789 66,759 84,747 102,759 114,783 132,789 138,801 180,771 162,729 138,717 126,669 132,633 90,615 60,609 36,585 36,567"/>
   <frame points="396,495 936,483 936,921 402,927"/>
   <frame points="30,939 480,933 480,1365 24,1365"/>
   <frame points="486,933 936,927 936,1365 492,1365"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="62,70 445,70 453,81 439,95 278,99 260,114 174,112 110,110 72,108 53,100 54,85"><p>TAK TOTO JE JEJ SKRÝŠA. V KANÁLI SPOLU SO ZVYŠKOM POTKANOV.</p></text-area><text-area bgcolor="#ffffa8" points="620,69 920,69 921,104 904,120 890,113 826,113 797,114 741,112 688,117 631,116 621,118 620,90" type="commentary"><p>KILOMETER ZA KILOMETROM SLEDOVAL FIALOVÝ DRÁP MŔTVEHO MUŽA!</p></text-area><text-area bgcolor="#fdfdfd" points="50,560 49,567 50,577 54,585 66,597 76,601 116,601 129,598 133,595 137,595 145,590 160,574 164,564 164,553 156,543 152,541 148,536 143,534 141,531 136,531 129,527 84,527 80,530 69,535 56,549"><p>TAM JE, POZRITE SA!</p></text-area><text-area bgcolor="#ffffff" points="430,517 442,503 573,503 580,510 609,515 623,523 618,540 580,548 498,552 436,552 410,546 406,534 412,521"><p>NECH ŽIJE BRIMA, KRÁĽOVNÁ NEMŔTVYCH!</p></text-area><text-area bgcolor="#ffffff" points="52,945 331,945 344,963 317,989 245,995 240,1014 184,1030 99,1032 64,1024 65,1001 45,986 40,962"><p>ONA NIE JE ŽIADNA KRÁĽOVNÁ, JE TO LEN OBYČAJNÁ ŽENA ... S DIABLOM V TELE! PO NEJ!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_20.webp"/>
   <frame points="42,84 486,84 492,522 42,528"/>
   <frame points="492,84 942,84 948,516 498,522"/>
   <frame points="42,534 330,528 342,966 42,966"/>
   <frame points="336,528 630,528 630,960 342,966"/>
   <frame points="636,528 942,522 948,906 642,906"/>
   <frame points="42,972 342,972 348,1404 48,1404"/>
   <frame points="390,1404 384,1278 378,1104 402,1110 420,1152 426,1044 408,972 414,960 456,960 462,978 468,1062 498,984 510,990 534,984 534,1062 552,990 564,990 570,1002 588,996 600,1008 600,1092 606,1044 630,1062 630,1200 636,1230 636,1344 612,1344 606,1380 606,1404"/>
   <frame points="642,912 948,912 948,1404 642,1404"/>
  <text-layer lang="sk"><text-area bgcolor="#f1f07a" points="50,94 476,94 475,152 439,156 376,153 314,157 219,164 201,172 143,175 96,174 49,175" type="commentary"><p>PIJAVICE, ŽABY, BIELE HROBOVÉ PAVÚKY A VŠETOK ZVYŠOK TEJ CHAMRADE PADAL MŔTVY POD SILOU FIALOVÉHO DRÁPU!</p></text-area><text-area bgcolor="#ffffff" points="503,107 518,96 798,96 810,101 825,114 817,139 791,156 710,162 695,175 623,184 605,197 529,193 505,171"><p>ZBRAŇ! ZBRAŇ! TY, KTORÝ BERIEŠ ŽIVOT A DÁVAŠ HO SMRTI, POMÔŽ MI... OCHRÁŇ MA PRED FIALOVÝM DRÁPOM!</p></text-area><text-area bgcolor="#ffffff" points="51,541 297,541 302,547 323,559 321,574 297,593 243,604 171,609 88,607 51,601"><p>ACH, SATAN PÁN, ZACHRÁNIL SI MA! TERAZ TI MUSÍ SLÚŽIŤ AJ FIALOVÝ DRÁP.</p></text-area><text-area bgcolor="#ffffff" points="349,537 607,537 613,552 607,564 617,576 616,595 585,604 459,607 385,607 363,604 350,594"><p>MÝLIŠ SA! <emphasis>NEEXISTUJE</emphasis> SILA, KTORÁ BY PRINÚTILA FIALOVÉHO DRÁPA SLÚŽIŤ ZLU!</p></text-area><text-area bgcolor="#ffffff" points="654,534 873,534 921,544 925,562 909,576 831,580 736,579 746,591 746,607 718,619 665,623 645,612 646,593 652,577 645,555"><p>TY, MAJITEĽ FIALOVÉHO DRÁPU, VYSTREL NÁBOJ DO MÔJHO SRDCA!</p></text-area><text-area bgcolor="#ffffff" points="650,666 654,671 658,673 660,676 705,676 705,675 711,670 715,669 723,661 723,650 716,643 711,643 669,643 663,646 654,655 650,662"><p>NIE, NIE!</p></text-area><text-area bgcolor="#ffffff" points="53,981 331,981 330,1019 268,1023 161,1027 150,1044 101,1047 63,1041 61,1028 54,1018"><p>NEPOČÚVAJ HO. CHCE ŤA PREKLIAŤ, TAK AKO JE PREKLIATY ON SÁM!</p></text-area><text-area bgcolor="#ffffff" points="174,1031 299,1031 311,1042 331,1054 331,1070 309,1090 276,1097 195,1096 157,1089 149,1073 161,1057 165,1048"><p>LEN TY MI VIEŠ DAŤ MIER, PO KTOROM TÚŽIM!</p></text-area><text-area bgcolor="#ffffff" points="648,922 908,922 928,936 925,967 935,983 935,1009 907,1049 743,1054 676,1052 650,1041"><p>DVAKRÁT ZABITÝ ROVNAKOU ZBRAŇOU! ZOMREL SI LEPŠIE, AKO SI ŽIL, LUG GARRISON, KEĎŽE PROSTREDNÍCTVOM TEBA SA SVET ZBAVIL DIABLA, KTORÝM BOLA ŽENA!</p></text-area><text-area bgcolor="#234d43" points="859,1372 928,1372 928,1393 857,1393" type="commentary"><p>KONIEC.</p></text-area></text-layer></page>
  <page>
   <title>The Purple Claw</title>
   <image href="PC1_21.webp"/>
   <frame points="60,78 168,66 456,66 468,174 432,258 360,258 348,306 342,342 342,354 348,366 336,402 336,450 342,486 348,504 330,528 336,540 336,564 336,588 336,594 330,606 330,630 336,660 330,666 324,666 318,690 288,690 264,696 258,690 246,696 228,690 162,696 150,702 114,690 78,702 72,696 60,690 60,684 48,672 60,654 60,618 48,606 72,582 60,570 54,504 60,492 54,414 60,402 54,378 66,360 66,342 54,306 60,282 54,264 90,240 108,246 114,252 174,252 150,222 174,156 138,126 72,126"/>
   <frame points="342,303 357,303 372,294 420,288 426,270 438,252 474,246 498,252 504,246 516,216 540,198 570,180 606,180 630,156 648,156 660,168 684,156 672,132 738,84 768,90 786,120 840,90 870,78 888,84 894,96 912,78 954,78 942,924 279,921 171,855 117,831 117,819 144,813 153,801 234,747 294,690 318,684 324,666 336,654 330,606 351,582 351,504 363,477 393,456 402,447 420,441 405,435 405,423 417,399 447,375 441,360 429,369 417,363 408,375 396,378 384,375 369,384 363,375 354,366 339,366 330,360 333,348 333,336 336,324"/>
   <frame points="42,930 51,921 111,921 183,927 216,921 261,924 327,921 357,924 372,921 462,921 465,927 480,927 489,957 486,969 486,1365 39,1362"/>
   <frame points="492,930 942,927 939,1365 492,1362"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="70,82 162,68 451,68 464,157 178,157 140,125 74,125" type="heading"><p>FIALOVÝ</p></text-area><text-area bgcolor="#ffffff" points="152,222 178,158 464,158 429,255 332,252 279,252 176,252" type="heading"><p>DRÁP</p></text-area><text-area bgcolor="#ed718c" points="79,276 334,276 326,357 332,369 321,435 331,497 318,527 323,591 315,600 324,646 312,654 308,674 266,669 170,674 92,679 77,656 85,594 83,562" type="commentary"><p>OBROVSKÁ HRÔZA NAPLNILA STAROBYLÉ MESTO ZOCALO, KEĎ JEDNA OBEŤ ZA DRUHOU UMIERALA POD ŠĽAHOM BIČA A LIETAJÚCEJ DÝKY. STARŠÍ OBYVATELIA MESTA SI UŽ MEDZI SEBOU ŠEPKALI MENO VRAHA, KTORÝM MAL BYŤ DON CARLO ... TO BOLO ALE NEMOŽNÉ, KEDŽE V TOM ČASE BOL UŽ STOVKY ROKOV MŔTVY. NEMOŽNÉ BY TO BOLO PRE KAŽDÉHO OKREM DOKTORA JONATHANA WEIRA, MAJITEĽA</p><p><emphasis>FIALOVÉHO DRÁPU!</emphasis></p></text-area><text-area bgcolor="#c55760" points="50,934 61,931 451,931 473,945 472,974 274,982 235,995 153,995 87,997 52,995 51,956"><p>HNEĎ AKO DOKTOR WEIR PRICHÁDZA DO MESTA ZOCALO NA KRÁTKU DOVOLENKU, DOZVEDÁ SA O CHLADNOM A LSTIVOM VRAHOVI!</p></text-area><text-area bgcolor="#ffffff" points="49,1017 61,1007 245,1007 251,1021 240,1043 215,1051 128,1051 124,1063 112,1071 68,1069 49,1059"><p>PREPÁČTE, SEŇORITA. VIETE KOĽKO JE UŽ HODÍN?</p></text-area><text-area bgcolor="#ffffff" points="250,1047 258,1021 266,1010 272,997 288,991 451,991 465,1014 459,1045 446,1065 412,1067 360,1069 361,1083 344,1092 308,1088 280,1075 256,1065"><p>SAMOZREJME! NEPOČUJETE SNÁĎ HODINY NA KOSTOLNEJ VEŽI? PRÁVE ODBÍJA POLNOC.</p></text-area><text-area bgcolor="#ffffff" points="506,937 588,937 592,945 582,955 557,961 524,961 503,955"><p>NIE... NIE!</p></text-area><text-area bgcolor="#ffffff" points="618,971 616,951 626,936 920,936 933,944 934,985 915,995 851,997 846,1009 832,1014 645,1012 627,1006 614,993"><p>NEBRÁNTE SA, SEŇORITA, PRETOŽE DNES PATRÍTE MEDZI NAJŠTASTNEJŠIE ŽENY SVETA. POZNÁTE PRESNÚ HODINU SVOJEJ SMRTI!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_22.webp"/>
   <frame points="36,59 486,59 486,395 36,395"/>
   <frame points="492,83 510,59 732,53 762,65 774,83 768,107 798,101 846,119 870,137 912,113 936,119 942,143 924,173 942,179 942,215 924,263 918,275 912,293 912,335 936,347 936,353 924,377 930,395 552,395 552,377 594,335 582,317 564,293 570,275 582,257 606,251 618,251 636,269 642,275 642,305 654,311 684,305 684,287 690,257 684,233 672,239 648,233 630,215 546,215 498,197 486,167 498,131 492,113"/>
   <frame points="36,401 480,401 486,425 492,437 492,449 486,461 486,749 42,755"/>
   <frame points="492,401 942,401 942,749 492,749"/>
   <frame points="48,779 42,761 54,755 120,761 144,755 234,749 246,755 300,755 342,755 354,761 372,755 942,755 942,1019 720,1019 708,1019 498,1013 486,1019 42,1019 42,977 48,965 36,923 36,875 42,869 36,851 48,845 36,815 42,809 36,791"/>
   <frame points="42,1025 492,1025 486,1043 486,1055 492,1067 492,1361 48,1367"/>
   <frame points="492,1025 504,1013 714,1013 726,1019 942,1019 942,1361 498,1361 492,1073 486,1061 486,1037"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="47,68 234,68 241,84 233,116 207,125 196,128 179,139 172,153 151,158 58,158 52,140 46,135"><p>VYVINULI STE ALE NEJAKÚ SNAHU NA ZASTAVENIE TÝCHTO VRÁŽD? NA DOLAPENIE VRAHA?</p></text-area><text-area bgcolor="#ffffff" points="268,67 423,67 446,76 451,84 466,97 471,110 454,120 394,123 330,122 271,122 255,114 253,83"><p>MYSLÍTE DOLAPENIE VETRA? ŽE DOKÁŽEME CHYTIŤ DUCHA?</p></text-area><text-area bgcolor="#ffffff" points="515,69 733,69 757,79 763,102 745,126 703,148 696,173 675,185 672,203 553,205 507,194 497,162 511,127 503,109 504,88"><p>SEŇOR GARCIA, HOVORÍTE O DUCHOVI? TAKŽE SI MYSLÍTE, ŽE VRAHOM JE NECHVALNE ZNÁMY DON CARLO? MAL BY SOM SA DNES V NOCI POPRECHÁDZAŤ ULICAMI A ZISTIŤ, AKÁ JE SKUTOČNOSŤ.</p></text-area><text-area bgcolor="#ffffff" points="47,413 472,413 478,420 477,426 486,442 480,456 466,465 243,473 58,474 47,466"><p>PO ZÁPADE SLNKA NIKDY NEVYCHÁDZAME VON OSAMOTE, VŽDY LEN PO DVOCH. NAPRIEK TOMU STÁLE ÚTOČÍ. AKO VÁŠ HOSTITEĽ VÁM, SEŇOR WEIR, NEMÔŽEM DOVOLIŤ TAKTO SA VYSTAVIŤ NEBEZPEČENSTVU!</p></text-area><text-area bgcolor="#ffffff" points="247,479 469,479 470,498 443,517 375,521 278,516 245,515 236,498"><p>NAPRIEK TOMU TAM PREDSALEN PÔJDEM ... A OSAMOTE!</p></text-area><text-area bgcolor="#ffffff" points="500,409 920,409 929,428 919,464 789,468 653,469 623,471 613,487 620,498 617,512 584,516 551,513 535,504 530,493 507,489 500,480"><p><emphasis>FIALOVÝ DRÁP,</emphasis> MOJA OCHRANA PROTI VŠETKÉMU ZLU A SYMBOL, KTORÉHO SA VŠETCI ZLOČINCI BOJA A NENÁVIDIA HO. ČI SI DIABLOM ALEBO ČLOVEKOM, DON CARLO, PRISAHÁM, ŽE ŤA VYPÁTRAM!</p></text-area><text-area bgcolor="#ffffff" points="59,769 367,769 411,793 410,819 399,833 391,845 386,869 391,893 397,926 389,977 355,985 253,989 139,993 58,990 54,931 56,868 55,830 56,782" type="commentary"><p>NIEKOĽKO HODÍN PO ZOTMENÍ SA JONATHAN WEIR VYBRAL DO TMAVEJ NOCI. NÁHLE, POČAS TOHO AKO SA POMALY PRECHÁDZAL NAJTEMNEJŠÍMI ULICAMI MESTA, STUHOL. BEŽNÉ UCHO BY ŽIADEN ZVUK NEZACHYTILO. NO PRE JEHO NADPRIRODZENÝ SLUCH BOL TENTO JEDEN VZDYCH PRENIKAJÚCIM VÝKRIKOM NESKUTOČNE HROZIVÝM AKOBY VYCHÁDZAJÚCIM Z HRDLA UPCHATÉHO PRACHOM Z TISÍCOK HROBOV.</p></text-area><text-area bgcolor="#ffffff" points="51,1031 195,1031 209,1044 201,1064 170,1073 89,1075 61,1075 51,1067"><p>VIETE KOĽKO JE HODÍN, SEŇOR?</p></text-area><text-area bgcolor="#ffffff" points="235,1032 458,1032 475,1045 462,1064 429,1073 285,1073 236,1067 222,1054 224,1041"><p>ÁNO, DON CARLO. PRÁVE ODBÍJA <emphasis>HODINA VAŠEJ ZÁHUBY!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="501,1021 710,1021 725,1037 719,1059 702,1073 653,1070 571,1072 511,1071 491,1064 489,1040"><p>JE TO TEN FIALOVÝ DRÁP, ČO MI TRHÁ SRDCE OHNIVÝMI KONČEKAMI PRSTOV!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_23.webp"/>
   <frame points="36,77 552,77 552,509 36,509"/>
   <frame points="558,83 948,83 942,509 558,509"/>
   <frame points="48,521 54,515 192,515 312,515 402,515 408,521 420,515 438,527 432,545 438,551 438,557 444,569 438,593 450,593 456,605 450,617 444,635 456,641 456,947 42,947 42,659 42,623 48,611 48,587 42,575"/>
   <frame points="462,515 942,515 942,947 468,947"/>
   <frame points="42,953 510,953 516,1385 42,1385"/>
   <frame points="522,953 936,953 936,1385 522,1385"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="136,85 338,85 347,102 332,126 321,132 327,146 311,175 283,188 167,182 108,176 91,160 99,121 115,100"><p>TAK SEŇOR GARCIA MAL PRAVDU! JE TO DON CARLO! STRETNEME SA ZNOVA A NABUDÚCE MI UŽ NEUNIKNE.</p></text-area><text-area bgcolor="#c55760" points="567,90 726,90 728,112 705,116 680,116 639,118 603,118 576,119 569,109" type="commentary"><p>NA DRUHÝ DEŇ!</p></text-area><text-area bgcolor="#ffffff" points="565,133 571,128 759,128 772,140 764,164 733,186 686,190 658,190 656,202 601,204 587,192 566,181"><p>ČLOVEK BY NEMAL NEUSTÁLE POKÚŠAŤ SVOJ OSUD! DÁVAJTE SI POZOR, SEŇOR WEIR!</p></text-area><text-area bgcolor="#ffffff" points="756,110 771,91 901,91 907,106 929,115 936,124 921,137 853,140 843,148 817,154 787,151 777,140 771,130 765,122"><p>JA VIEM. ALE JE TO RIZIKO, KTORÉ MUSÍM PODSTÚPIŤ.</p></text-area><text-area bgcolor="#ffffff" points="55,525 401,525 415,550 421,602 431,641 385,646 281,656 207,660 129,662 61,664 60,620 58,578 55,557" type="commentary"><p>ODBILA POLNOC, JE SKORO RÁNO A DOKTOR JONATHAN WEIR ZNOVA AKO FIALOVÝ DRÁP PRECHÁDZA ULICAMI MESTA A HĽADÁ ČASOMERAČA SAMOTNEJ SMRTI. VIE, ŽE BUĎ ON ALEBO DON CARLO PREŽIJE TÚTO NOC. <emphasis>ALE NIE OBAJA.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="657,621 671,599 694,588 775,588 802,597 812,612 805,626 775,633 765,650 753,657 747,675 723,681 685,682 670,672 669,647 660,635"><p>NENIČTE SI SVOJE POSLEDNÉ CHVÍLE KRIKOM, SEŇOR!</p></text-area><text-area bgcolor="#ffffff" points="70,987 69,974 84,962 228,962 234,977 258,979 269,991 258,1005 200,1013 183,1021 105,1025 69,1018 57,1008"><p>NADIŠLA <emphasis>VAŠA</emphasis> POSLEDNÁ HODINA, DON CARLO. NIE JEHO!</p></text-area><text-area bgcolor="#ffffff" points="531,963 700,963 705,977 682,996 643,1004 634,1017 569,1021 541,1017 530,1007"><p>MNE NEUTEČIETE, DON CARLO. MUSÍTE ZOMRIEŤ!</p></text-area><text-area bgcolor="#ffffff" points="710,963 901,963 915,972 915,993 894,1001 841,1002 835,1015 811,1022 775,1017 759,1009 710,1003 700,992 709,977"><p>NAOZAJ ALE CHCETE RISKOVAŤ VAŠU DUŠU NA ZÁCHRANU TEJ MOJEJ?</p></text-area></text-layer></page>
  <page>
   <image href="PC1_24.webp"/>
   <frame points="42,72 942,72 942,336 42,330"/>
   <frame points="42,336 486,336 486,696 42,696"/>
   <frame points="492,336 942,336 942,696 492,696"/>
   <frame points="42,702 936,702 936,954 42,954"/>
   <frame points="42,960 480,960 480,1380 36,1380"/>
   <frame points="486,960 936,960 936,1380 486,1380"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="243,81 421,81 426,94 438,104 433,123 418,136 366,141 356,150 319,155 260,152 230,142 224,113 232,96"><p>DÁVAM VÁM POSLEDNÚ ŠANCU. NEVSTUPUJTE A NAĎALEJ ZOSTANETE <emphasis>V BEZPEČÍ!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="648,82 921,82 924,93 920,104 885,110 864,112 855,120 776,129 764,138 727,141 668,143 638,132 630,105 634,94"><p>TÚ ISTÚ ŠANCU, KTORÚ DÁVATE VŠETKÝM SVOJIM OBETIAM? TO NIE, ĎAKUJEM!</p></text-area><text-area bgcolor="#ffffff" points="50,347 461,347 468,353 465,364 443,370 298,373 288,384 235,389 140,389 75,390 50,379"><p>CHOĎTE BLIŽŠIE, POZRITE SA HLBOKO DO JEHO OČÍ A POVEDZTE MI, ČO VIDÍTE.</p></text-area><text-area bgcolor="#ffffff" points="502,360 513,349 600,349 614,362 629,369 626,383 603,392 542,395 508,389 504,379 505,369"><p>STE TO VY ... DON CARLO!</p></text-area><text-area bgcolor="#ffffff" points="649,347 884,347 902,359 896,377 869,391 758,390 677,386 646,380 636,361"><p>A PRIPRAVENÝ DO HROBU. ODVAŽUJETE SA POKRAČOVAŤ?</p></text-area><text-area bgcolor="#ffffff" points="48,893 68,882 214,882 238,892 240,912 218,927 191,930 173,939 124,940 82,942 50,929"><p>JA ČI SA ODVAŽUJEM? ODVAŽUJETE SA MA <emphasis>VY</emphasis> ZASTAVIŤ?</p></text-area><text-area bgcolor="#ffffff" points="48,968 462,968 474,977 472,989 457,995 441,998 433,1005 348,1009 244,1010 151,1008 92,1008 52,1003 48,993"><p>JE TO STRAŠNÉ! TO MONŠTRUM ZA MASKOU BY MALO BYŤ SAMO ZBIČOVANÉ!</p></text-area><text-area bgcolor="#ffffff" points="103,1027 117,1015 392,1015 406,1028 399,1040 372,1045 287,1048 279,1063 172,1062 157,1051 108,1042"><p>TO NEDOKÁŽETE SPRAVIŤ, DOKÁŽETE HO ALE ODHALIŤ!</p></text-area><text-area bgcolor="#ffffff" points="500,1013 504,993 525,979 584,979 614,993 621,1023 605,1046 556,1055 522,1052 503,1037"><p>STE TO ZNOVA VY, DON CARLO...</p></text-area><text-area bgcolor="#ffffff" points="622,993 642,969 885,969 900,990 890,1021 851,1032 842,1044 738,1047 715,1034 654,1029 629,1022"><p>ÁNO, JA. UKÁZAL SOM VÁM KONIEC MÔJHO ŽIVOTA. A TERAZ VÁM UKÁŽEM AJ JEHO ZAČIATOK!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_25.webp"/>
   <frame points="66,72 414,72 414,498 66,498"/>
   <frame points="420,72 966,72 966,498 420,498"/>
   <frame points="66,510 540,510 540,942 60,942"/>
   <frame points="546,510 966,504 966,942 546,942"/>
   <frame points="60,948 396,948 408,966 432,984 432,1008 408,1032 390,1038 402,1044 426,1044 426,1164 438,1176 438,1212 414,1236 426,1254 432,1302 408,1320 384,1314 354,1332 354,1380 120,1380 102,1356 84,1362 54,1338 66,1260 78,1212 72,1158 84,1068 66,1062 60,1050"/>
   <frame points="438,948 966,942 966,1380 438,1380 438,948"/>
  <text-layer lang="sk"><text-area bgcolor="#ffe5ee" points="75,84 409,84 408,173 382,176 313,175 268,176 215,174 170,176 138,180 105,181 78,178 80,142 76,108" type="commentary"><p>"ZAČÍNAL SOM AKO STRÁŽCA MUČIARNE A KÝM SOM ZOMREL, VYPRACOVAL SOM SA NA MIESTODRŽITEĽA, ABSOLÚTNEHO VLÁDCU. ŠPLHAL SOM NAHOR. NAHOR CEZ UTRPENIE, KLAMSTVO A VRAŽDY!"</p></text-area><text-area bgcolor="#fffecd" points="431,85 958,85 958,148 901,147 886,143 793,145 763,151 671,149 664,155 581,155 567,151 510,151 467,155 438,156 430,157" type="commentary"><p>"MIESTODRŽITEĽ DON FRANCISCO SA OBÁVAL DONA MIGUELA, SVOJHO RIVALA, A DAL HO DOVIESŤ KU MNE. ALE ZLATO, VEĽA ZLATA, ZO MŇA SPRAVILO MIGUELOVHO PRIATEĽA!"</p></text-area><text-area bgcolor="#ffffff" points="449,217 461,183 485,173 494,171 590,171 616,183 630,207 616,235 591,251 544,255 514,253 485,252 457,241"><p>MOJI NEPRIATELIA MA SEM DOSTALI, CARLO. POMÔŽ MI A STANEŠ SA BOHATÝM!</p></text-area><text-area bgcolor="#c0d7a9" points="73,517 492,517 491,539 485,574 430,576 373,580 320,581 245,584 213,586 167,584 112,580 97,575 87,557 73,550" type="commentary"><p>"MOJIM PRIČINENÍM TAK DON FRANCISCO ZOMREL A DON MIGUEL SA STAL NOVÝM MIESTODRŽITEĽOM. NO POTOM NA MŇA ZABUDOL!"</p></text-area><text-area bgcolor="#ffffff" points="566,516 777,516 783,526 765,541 745,545 741,557 660,562 593,561 561,554 557,529"><p>POŽADUJEM ODMENU, KTORÚ STE MI SĽÚBIL!</p></text-area><text-area bgcolor="#ffffff" points="792,515 945,515 957,526 957,572 947,584 954,593 948,604 922,612 848,613 837,620 808,628 767,627 747,621 741,599 753,575 767,558 767,546 783,537"><p>OKAMŽITE ODÍĎTE, LEBO ZAVOLÁM STRÁŽE A NECHÁM VÁS ZABIŤ AKO ZBABELÉ PSISKO, KTORÝM STE!</p></text-area><text-area bgcolor="#ffffff" points="69,957 246,957 249,970 235,989 203,1001 201,1011 178,1019 145,1026 139,1041 120,1052 86,1056 72,1054 68,1032"><p>NIE ... NIE! DÁM VÁM VŠETKO, ČO CHCETE ... NECHAJTE MÁ ODÍSŤ!</p></text-area><text-area bgcolor="#ffffff" points="259,958 391,958 399,972 415,982 423,999 408,1022 379,1031 307,1033 261,1035 232,1032 223,1016 232,996 247,985 254,972"><p>PRÍLIŠ NESKORO, DON MIGUEL. AJ ZBABELÉ PSISKO MÁ OSTRÉ PAZÚRE.</p></text-area><text-area bgcolor="#ffffff" points="455,956 631,956 637,965 624,981 621,989 570,997 483,996 452,992 447,975"><p>NECH ŽIJE DON CARLO, NÁŠ NOVÝ VLÁDCA!</p></text-area><text-area bgcolor="#f5cd6e" points="647,954 947,954 954,979 928,980 901,986 849,992 811,992 769,994 714,994 705,991 685,988 655,985 643,980" type="commentary"><p>"... A TAK SOM SA STAL NOVÝM MIESTODRŽITEĽOM."</p></text-area></text-layer></page>
  <page>
   <image href="PC1_26.webp"/>
   <frame points="54,54 612,48 618,60 654,60 702,90 702,60 738,48 864,48 870,84 930,84 930,114 876,126 876,132 924,132 930,180 930,228 936,240 936,348 36,360 36,174 42,168 54,192 66,150 78,150 90,186 102,138 78,138 54,126 48,84 48,66"/>
   <frame points="36,366 474,360 474,384 486,402 486,420 474,426 480,720 36,726"/>
   <frame points="480,360 930,354 936,714 486,720"/>
   <frame points="42,738 930,726 930,960 42,966"/>
   <frame points="42,978 480,972 486,1350 48,1356"/>
   <frame points="492,972 936,966 942,1350 498,1356"/>
  <text-layer lang="sk"><text-area bgcolor="#d097a0" points="64,62 577,62 569,83 580,92 582,104 563,114 462,114 445,119 373,122 328,124 280,120 220,122 169,120 124,119 80,118 63,106" type="commentary"><p>"JE TO ONA, DONNA ISABEL, ŽENA DONA MIGUELA, KTOREJ SOM SĽÚBIL, ŽE DARUJEM SVOJU DUŠU DIABLOVI, AK JU NEDOKÁŽEM PRE SEBA ZÍSKAŤ!"</p></text-area><text-area bgcolor="#ffffff" points="42,372 461,372 462,388 475,402 473,416 453,424 374,430 288,432 280,445 240,450 122,452 58,452 44,442"><p>HOVORÍŠ MI O LÁSKE? TY, KTORÝ SI ZABIL MÔJHO MUŽA? ACH, URČITE PRÍDE TEN DEŇ, KEĎ ODVISNEŠ ZA VŠETKY SVOJE ZLOČINY, KTORÉ TAK NEZOSTANÚ NEPOTRESTANÉ!</p></text-area><text-area bgcolor="#fbff8e" points="485,365 923,365 921,393 905,407 797,412 703,423 592,427 490,425" type="commentary"><p>"POTOM, SKÔR NEŽ SOM JU STIHOL ZASTAVIŤ, SA ZABILA. JEDINÁ ŽENA, KTORÚ SOM KEDY MILOVAL, UPREDNOSTNILA SMRŤ PREDO MNOU!"</p></text-area><text-area bgcolor="#d097a0" points="70,740 526,740 534,802 510,809 452,814 331,819 200,821 181,830 132,831 84,835 76,800 70,780 63,760" type="commentary"><p>"POKRAČOVAL SOM VO VŠETKOM NAĎALEJ. V ZABÍJANÍ A DRANCOVANÍ AŽ KÝM SOM SA NESTAL NAJBOHATŠÍM A NAJMOCNEJŠÍM MUŽOM V KRAJINE ... A ZÁROVEŇ AJ NAJNENÁVIDENEJŠÍM."</p></text-area><text-area bgcolor="#ffffff" points="49,984 474,984 475,1024 435,1027 381,1030 329,1034 298,1040 233,1040 182,1042 142,1047 128,1054 103,1046 51,1048" type="commentary"><p>"A  MYSLEL SOM SI, ŽE TRIUMF JE MÔJ, KEĎŽE SOM ZOMREL PRIRODZENOU SMRŤOU SO VŠETKÝMI POCTAMI A NESKONČIL NA ŠIBENICI!"</p></text-area><text-area bgcolor="#fffba0" points="503,980 927,980 930,994 892,997 816,999 706,1002 659,1003 542,1002 504,1004" type="commentary"><p>NO DUCH DONNY ISABEL MI MOJU RADOSŤ PREKAZIL ...</p></text-area><text-area bgcolor="#ffffff" points="502,1009 928,1009 922,1026 890,1046 884,1068 853,1082 695,1088 574,1090 510,1085 502,1076"><p>MÝLIL SI SA DON CARLO. NEBUDEŠ MAŤ ŽIADEN ODPOČINOK. BUDEŠ MUSIEŤ AJ NAĎALEJ ZABÍJAŤ, AŽ DOKÝM TVOJ KRK NEOKÚSI NAPNUTIE ŠIBENIČNÉHO LANA!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_27.webp"/>
   <frame points="75,72 366,72 375,78 378,90 387,96 387,111 384,117 381,123 375,129 378,150 375,159 381,168 381,177 372,195 372,579 72,579"/>
   <frame points="381,72 672,75 672,117 678,135 678,147 675,156 672,168 672,579 381,579 381,123 384,114 384,96 381,90"/>
   <frame points="684,75 975,72 972,579 678,579"/>
   <frame points="72,588 516,588 516,972 69,972"/>
   <frame points="528,588 972,588 969,972 525,972"/>
   <frame points="66,981 516,981 516,1377 66,1377"/>
   <frame points="516,981 882,981 894,1005 948,975 960,981 918,1017 954,1011 960,1017 936,1041 960,1047 960,1053 882,1131 936,1119 978,1119 978,1131 924,1155 882,1161 894,1167 948,1167 972,1179 972,1185 930,1197 966,1239 960,1251 864,1221 906,1251 930,1263 960,1299 960,1311 906,1293 942,1347 948,1353 954,1371 948,1383 924,1359 924,1389 906,1389 870,1353 846,1371 816,1359 816,1377 804,1377 774,1341 780,1377 612,1377 618,1365 582,1377 540,1377 546,1365 570,1347 534,1353 528,1341 552,1323 582,1317 558,1311 570,1305 522,1299 528,1287 606,1275 522,1233 516,1221 534,1215 612,1239 516,1167 522,1149 540,1149 570,1161 528,1107 540,1089 516,1065"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="83,80 363,80 369,94 381,100 381,113 359,122 222,122 104,122 82,118"><p>VEZMI SLUČKU A UPEVNI JU PEVNE OKOLO MÔJHO KRKU. PROSÍM!</p></text-area><text-area bgcolor="#ffffff" points="135,148 140,135 154,128 352,128 368,136 367,158 374,173 366,193 330,200 277,200 276,214 255,224 203,227 182,213 141,206 125,184 125,162"><p>NA TO, ABY SOM OBESIL MUŽA MŔTVEHO UŽ STOVKY ROKOV, BUDEM POTREBOVAŤ VŠETKY SCHOPNOSTI FIALOVÉHO DRÁPU!</p></text-area><text-area bgcolor="#ffffff" points="389,80 635,80 648,92 645,108 666,122 670,147 655,171 635,180 477,178 470,194 421,198 401,188 399,178 387,169"><p>PONÁHĽAJ SA ... PONÁHĽAJ SA KÝM KOHÚT NEZAKIKIRÍKA. INAK SOM STRATENÝ A BUDEM MUSIEŤ NAVŽDY BLÚDIŤ ULICAMI MESTA A S MOJOU DÝKOU PRELIEVAŤ KRV!</p></text-area><text-area bgcolor="#ffffff" points="689,79 943,79 946,108 931,138 913,148 900,158 743,164 702,160 689,148"><p>TO LANO ... STAL SA Z NEHO BIČ! NEBUDEM MAŤ NIKDY KĽUD? ŽIADEN POKOJ? ŽIADNE ODPUSTENIE?</p></text-area><text-area bgcolor="#ffffff" points="79,595 467,595 483,607 503,621 508,641 487,666 445,675 308,673 237,674 235,689 212,700 145,697 91,689 78,681"><p>POČULA SI HO, DONNA ISABEL! MÁ NAVŽDY BLÚDIŤ ULICAMI A ZABÍJAŤ NA VEKY VEKOV ĎAĽŠIE A ĎAĽŠIE EŠTE NENARODENÉ OBETE? ALEBO BUDE TOMU UŽ KONIEC ... TERAZ A NAVŽDY?!</p></text-area><text-area bgcolor="#ffffff" points="535,597 963,597 965,614 943,625 917,626 913,637 873,646 723,642 719,654 591,655 551,652 543,637 534,633"><p>NECH JE TOMU TEDA KONIEC, MAJITEĽ FIALOVÉHO DRÁPU. TIEŽ MA TO UŽ UNAVUJE A NEVLÁDZEM UŽ ĎALEJ.</p></text-area><text-area bgcolor="#ffffff" points="91,993 326,993 335,1001 321,1011 279,1013 178,1014 101,1010 83,1005"><p>SI PRIPRAVENÝ, DON CARLO?</p></text-area><text-area bgcolor="#ffffff" points="315,1023 326,1011 355,1004 364,991 461,991 465,1003 493,1010 507,1025 491,1042 453,1049 377,1050 335,1050 317,1039"><p>ÁNO, PONÁHĽAJ SA. ZOSTÁVA UŽ MÁLO ČASU.</p></text-area><text-area bgcolor="#ffffff" points="532,994 875,994 877,1011 866,1018 858,1036 831,1041 821,1051 761,1054 654,1051 583,1055 529,1056 529,1026 531,1007" type="commentary"><p>HNEĎ AKO WEIR POLOŽIL SLUČKU NA KRK DONOVI CARLOVI, ŽIARIVÉ A OSLNIVÉ SVETLO HO OSLEPILO!</p></text-area></text-layer></page>
  <page>
   <image href="PC1_28.webp"/>
   <frame points="54,90 546,84 558,96 564,510 60,522"/>
   <frame points="564,84 954,84 954,162 942,174 924,180 924,204 900,228 858,234 840,246 810,252 804,270 834,282 906,300 918,312 936,432 930,444 936,498 612,510 606,498 594,498 576,468 576,444 594,426 606,396 612,372 636,360 630,330 624,312 624,294 642,270 642,264 624,204 624,180 576,180 564,162"/>
   <frame points="60,528 444,516 450,528 462,540 462,564 450,582 462,600 462,624 450,642 456,948 66,954"/>
   <frame points="456,516 960,504 966,942 462,948 456,624 462,612 462,588 456,576"/>
   <frame points="66,966 510,954 516,1392 72,1392"/>
   <frame points="516,954 924,948 936,960 942,972 942,984 954,1002 954,1020 942,1032 834,1032 828,1134 852,1134 870,1146 876,1164 876,1188 870,1194 924,1224 936,1236 942,1260 966,1296 972,1392 528,1392 522,1386 528,1374 528,1350 546,1326 570,1260 624,1224 624,1212 618,1194 642,1164 678,1164 666,1146 666,1128 648,1116 648,1092 636,1080 642,1056 534,1050 516,1032"/>
  <text-layer lang="sk"><text-area bgcolor="#ffffff" points="63,95 136,95 148,110 141,134 123,152 87,156 62,148"><p>KDE ... KDE TO SOM?</p></text-area><text-area bgcolor="#ffffff" points="164,96 539,96 549,104 545,126 513,136 447,142 438,151 311,153 202,152 183,142 177,136 159,126 157,109"><p>NAŠLI SME VÁS V BEZVEDOMÍ NA ULICI DNES RÁNO A PRIVIEZLI SEM. VĎAKA BOHU, ŽE STE V PORIADKU!</p></text-area><text-area bgcolor="#ffffff" points="575,93 944,93 945,158 927,167 771,168 631,170 587,169 576,162"><p>TEN DOM, O KTOROM STE HOVORIL, SEŇOR WEIR, BOL DOMOM SAMOTNÉHO DONA CARLA. HOVORÍ SA, ŽE V ŇOM STRAŠÍ. STE ALE VEĽMI SLABÝ NA TO, ABY STE TAM TERAZ ŠLI.</p></text-area><text-area bgcolor="#ffffff" points="782,185 794,175 896,175 911,183 914,199 891,217 846,225 815,223 804,212 804,203 785,195"><p>ALE MUSÍM A AJ PÔJDEM!</p></text-area><text-area bgcolor="#ffffff" points="69,536 435,526 440,542 455,551 453,562 432,579 391,585 149,593 96,594 69,591" text-rotation="2"><p>MINULÚ NOC SA TIETO DVERE DALI OTVORIŤ TAK JEDNODUCHO. TERAZ AKOBY NA NICH TLAČILA ŤAŽOBA VEKOV.</p></text-area><text-area bgcolor="#ffffff" points="220,598 448,598 455,608 443,638 425,652 332,658 226,661 205,654 199,637 209,624 209,606"><p>NO ALE NIKTO DO TOHTO DOMU NEVSTÚPIL OD VTEDY, ČO DON CARLO ZOMREL!</p></text-area><text-area bgcolor="#ffffff" points="467,525 929,514 942,524 943,544 911,559 707,567 694,580 512,586 476,584 466,572" text-rotation="1"><p>VIDÍTE, SEŇOR WEIR? NIKTO TU NENARUŠIL PRACH NAPADANÝ ZA TIE ROKY, TAKŽE STE TU NEMOHLI BYŤ MINULÚ NOC, AKO TVRDÍTE.</p></text-area><text-area bgcolor="#ffffff" points="631,589 716,586 726,570 936,566 945,578 939,588 904,593 861,598 853,610 823,616 718,616 651,616 627,611"><p>ŽE NIE? TAK POĎTE TEDA SO MNOU DO ZÁHRADY!</p></text-area><text-area bgcolor="#ffffff" points="73,971 476,971 493,981 499,1003 486,1017 454,1028 358,1030 358,1042 337,1049 280,1049 75,1048"><p>TEN KOSTÝM A TÁ KOSTRA SÚ VEĽMI STARÉ. MUSELO TO TU VISIEŤ PO MNOHO ROKOV. PRAVDEPODOBNE JE TO JEDNA Z ĎAĽŠÍCH DON CARLOVÝCH OBETÍ.</p></text-area><text-area bgcolor="#ffffff" points="315,1058 349,1054 363,1042 365,1033 447,1033 452,1054 445,1075 424,1085 429,1101 415,1119 349,1121 317,1107 308,1081"><p>JEHO POSLEDNÁ, SEŇOR GARCIA, ON SÁM!</p></text-area><text-area bgcolor="#ffffff" points="528,961 917,961 932,978 933,988 947,1004 935,1020 768,1023 753,1039 672,1045 557,1043 529,1036"><p>DON CARLO SA UŽ VIAC NEBUDE PÝTAŤ, AKÁ JE PRÁVE HODINA. LEBO UŽ VIE, AKÁ JE ODPOVEĎ. PRE NEHO JE TO HODINA VEČNOSTI. DÚFAJME, ŽE TU TERAZ NÁJDE SVOJ POKOJ!</p></text-area><text-area bgcolor="#ffffbe" points="907,1355 958,1355 958,1382 906,1382"><p>KONIEC</p></text-area></text-layer></page>
  </body>
