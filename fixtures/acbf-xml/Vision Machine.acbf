    <frame points="21,15 372,11 971,10 965,429 28,426"/><frame points="39,427 950,427 952,954 39,956"/><frame points="37,956 274,959 270,1488 36,1489"/><frame points="278,960 511,962 505,1487 275,1489"/><frame points="501,1006 965,1011 961,1524 460,1525 463,1484 501,1484"/><text-layer lang="sk"><text-area bgcolor="#f3e9c5" points="42,48 43,87 44,89 139,89 140,88 140,46 138,46 45,46"><p>O JEDEN ROK NESKÔR.</p></text-area><text-area bgcolor="#f4e7c7" points="54,112 56,181 199,180 198,110 192,110 58,110"><p>DATAMERGE MANAGEMENT, INC. HOBOKEN, NEW JERSEY.</p></text-area><text-area bgcolor="#ffffff" points="368,131 368,137 374,148 380,153 391,156 393,157 465,157 483,153 492,144 492,129 481,119 470,117 403,117 387,117 375,123"><p>ČO SA DEJE, BUDDY?</p></text-area><text-area bgcolor="#fefefe" points="475,171 475,178 478,187 485,196 491,198 495,202 520,206 576,206 615,205 633,200 648,184 648,173 645,166 634,154 629,151 623,151 616,149 508,149 499,151 493,158 483,162"><p>PROBLÉM S MOJIMI VÝPLATAMI. ZMENŠUJÚ SA MI.</p></text-area><text-area bgcolor="#ffffff" points="194,508 194,492 207,483 259,483 274,489 276,506 264,517 230,521 206,517"><p>NO, ÁNO ...</p></text-area><text-area bgcolor="#ffffff" points="230,546 244,526 275,516 341,516 379,527 388,549 386,576 367,589 306,596 263,593 238,575"><p>... NEBOLI STE PRIPOJENÝ K SIETI <emphasis>VYŠE DVADSAŤ DNÍ.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="549,831 551,852 558,870 571,883 589,891 689,891 712,880 721,871 726,861 726,823 721,809 708,796 694,790 665,788 613,788 584,790 568,798 556,810"><p>O ČOM TO HOVORÍTE? SOM ONLINE KAŽDÝ DEŇ. SOM NAJPRODUKTÍVNEJŠÍ ČLEN NÁŠHO TÍMU.</p></text-area><text-area bgcolor="#ffffff" points="48,966 263,966 262,1004 243,1016 218,1020 90,1020 64,1012 47,996"><p>NEROBTE SA HLÚPYM, BUDDY. HOVORÍM O <emphasis>SPROUTVILLE</emphasis> SIETI.</p></text-area><text-area bgcolor="#ffffff" points="54,1075 54,1046 73,1034 96,1022 230,1022 254,1036 263,1052 264,1086 246,1100 206,1112 145,1114 92,1106 66,1095"><p>PODĽA PRACOVNEJ ZMLUVY STE POVINNÝ NOSIŤ FIRMOU POSKYTNUTÉ iOČI NEUSTÁLE.</p></text-area><text-area bgcolor="#ffffff" points="314,1016 314,1031 318,1042 328,1052 338,1054 341,1056 349,1056 351,1057 384,1057 421,1056 436,1049 443,1042 445,1034 443,1017 437,1007 423,1000 405,999 364,999 341,999 326,1004"><p>VEĎ ICH AJ NOSÍM. TAK O ČO IDE ...</p></text-area><text-area bgcolor="#ffffff" points="512,1016 658,1016 660,1042 650,1061 620,1070 552,1068 522,1057 510,1033"><p>POMOHLO BY, KEBY STE SI ICH AJ <emphasis>ZAPLI.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="751,1048 752,1059 762,1068 769,1071 785,1073 788,1074 799,1074 801,1073 816,1073 818,1071 829,1071 830,1070 833,1070 840,1065 845,1058 845,1048 843,1046 843,1043 836,1036 829,1035 826,1034 769,1034 759,1039"><p>HEJ, POČKAJTE ...</p></text-area><text-area bgcolor="#f9fffe" points="796,1428 796,1445 802,1450 892,1450 896,1448 896,1424 891,1423 804,1423" type="code"><p>VITAJTE.</p></text-area></text-layer></page>
