    <frame points="42,62 88,65 114,46 175,37 262,57 401,63 434,32 523,17 546,34 569,61 779,64 838,51 894,67 946,69 944,354 46,351"/><frame points="47,352 952,356 954,600 949,677 942,759 793,764 740,765 652,762 578,760 49,761"/><frame points="48,762 491,761 492,812 489,844 481,852 476,862 483,877 466,883 454,895 453,912 461,930 482,939 489,940 489,949 48,953 48,953 48,953"/><frame points="490,761 943,762 943,949 489,952 492,940 475,937 461,930 458,921 451,910 453,897 460,886 473,882 486,877 476,865 479,855 488,844 491,812"/><frame points="42,1526 75,1411 66,1347 47,1336 38,1314 57,1265 40,1112 137,1094 131,1075 133,1050 159,1032 157,1000 182,978 249,972 304,980 360,960 401,958 438,974 463,1026 948,943 880,1484 788,1480 771,1527"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="314,253 295,241 306,227 350,227 363,240 355,251"><p>TAKŽE?</p></text-area><text-area bgcolor="#ffffff" points="288,305 292,275 312,259 400,259 426,267 433,294 422,317 394,327 311,326"><p>OČAKÁVAM TEN BOZK NA UDOBRENIE SA.</p></text-area><text-area bgcolor="#ffffff" points="733,294 726,283 720,279 711,272 643,272 640,273 617,276 608,281 598,292 599,308 603,314 611,322 614,322 617,325 621,325 624,326 703,326 722,323 733,311"><p>POVEDAL SI, ŽE TOTO NIE JE MÔJ SVET.</p></text-area><text-area bgcolor="#ffffff" points="280,398 280,411 283,418 296,430 299,430 303,433 392,433 409,430 421,418 421,402 419,400 419,395 410,385 403,382 380,380 314,380 294,384 289,387" type="audio"><p>MÁŠ PRAVDU, LIZ ... ONA ANI NIE JE <emphasis>PRIPOJENÁ.</emphasis> NEUVERITEĽNÉ ...</p></text-area><text-area bgcolor="#ffffff" points="248,477 236,465 238,447 253,437 295,437 311,441 332,445 336,463 319,481 282,483" type="audio"><p>DOKIAĽ SA DOKÁŽEME <emphasis>MY</emphasis> PRIPOJIŤ ...</p></text-area><text-area bgcolor="#ffffff" points="501,386 501,400 504,405 513,413 518,414 520,416 536,416 538,418 556,419 561,422 572,422 574,420 574,417 577,414 580,414 584,411 591,403 591,387 583,377 581,377 578,374 572,374 570,374 522,374 520,374 516,374 510,376"><p>TO JE PRAVDA ...</p></text-area><text-area bgcolor="#ffffff" points="829,557 816,542 814,513 836,501 891,501 910,520 906,543 888,557"><p>NO MÝLIŠ SA, BUDDY.</p></text-area><text-area bgcolor="#ffffff" points="785,629 768,614 764,587 785,567 807,562 901,562 930,571 942,588 940,618 904,633 804,634"><p>... VTEDY KEĎ MÔŽEM ROBIŤ ÚPLNE <emphasis>ČOKOĽVEK,</emphasis> ČO SI ZMYSLÍM ...</p></text-area><text-area bgcolor="#ffffff" points="773,677 766,657 786,643 809,638 903,638 932,649 937,669 920,685 864,689 800,690"><p>... BEZ DOPADU NA <emphasis>SKUTOČNÝ</emphasis> SVET ...</p></text-area><text-area bgcolor="#ffffff" points="341,803 341,812 345,820 353,828 363,833 376,834 438,834 465,833 478,828 484,822 487,815 484,799 476,792 461,787 446,787 381,787 366,787 348,795"><p>... <emphasis>NIČENIE</emphasis> VECÍ JE SKUTOČNE ZÁBAVA.</p></text-area><text-area bgcolor="#ffffff" points="490,875 480,861 492,849 538,849 550,861 541,876"><p>JASNE.</p></text-area><text-area bgcolor="#ffffff" points="467,931 456,909 464,889 489,881 564,881 582,894 585,921 564,934 509,938"><p>NO NAPRIEK TOMU SI SEM PRIŠLA ...</p></text-area><text-area bgcolor="#ffffff" points="167,1008 169,1023 178,1034 189,1040 207,1041 285,1041 285,1041 301,1027 302,1024 302,1011 300,1002 290,992 283,989 259,988 197,988 178,993 169,1002"><p>... A NEVZALA SI SI SVOJ MEČ.</p></text-area><text-area bgcolor="#ffffff" points="142,1061 142,1072 147,1079 154,1085 158,1085 160,1087 164,1088 220,1088 224,1087 226,1085 233,1084 242,1076 242,1061 240,1059 240,1057 235,1052 230,1050 192,1050 190,1048 187,1048 181,1048 166,1048 164,1048 158,1048 156,1050 151,1051"><p>ONA ... MALA MEČ?</p></text-area><text-area bgcolor="#ffffff" points="469,1217 464,1200 475,1183 537,1183 553,1196 549,1217 525,1227 494,1225"><p>ZABUDNIME NA TO ...</p></text-area><text-area bgcolor="#ffffff" points="513,1262 506,1246 518,1230 581,1230 598,1239 596,1258 581,1267 540,1269"><p>... A ZAČNIME ODZNOVA.</p></text-area></text-layer></page>
