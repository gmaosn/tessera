573,601 577,600 580,600 582,598 585,598 588,596 591,592 591,590 593,587 593,579 587,571 581,568 579,568 574,564 535,564 522,566"><p>TU.  VEZMI SI.</p></text-area><text-area bgcolor="#fefefe" points="474,796 474,810 481,822 494,833 506,836 514,836 516,837 578,837 580,836 595,836 606,831 612,825 614,819 615,785 609,779 591,772 561,772 497,772 479,787" type="audio"><p>DÁVA JEJ TO OBVYKLE TAKTO ZABRAŤ?</p></text-area><text-area bgcolor="#fefefe" points="622,795 621,819 624,839 639,851 782,851 791,843 795,835 795,804 788,783 773,770 768,769 763,762 698,762 666,762 640,773"><p>NEEXISTUJE ŽIADNE "OBVYKLE". STÁLE EŠTE PORIADNE NEROZUMIEME JEJ SCHOPNOSTIAM ...</p></text-area><text-area bgcolor="#f3e6c6" points="60,891 60,953 62,960 219,960 220,890 217,890 63,890"><p>"... PRETO TIE UTLMOVACIE PROSTRIEDKY, KEĎ JE OFFLINE."</p></text-area><text-area bgcolor="#ffffff" points="228,989 228,995 229,997 231,998 235,1003 241,1007 244,1007 246,1009 258,1009 263,1010 279,1010 304,1009 308,1007 313,1007 315,1005 319,1004 323,1000 323,989 315,980 309,977 293,977 251,977 250,977 242,978 235,981"><p>DOBRÉ DIEVČA.</p></text-area><text-area bgcolor="#ffffff" points="179,1135 179,1140 185,1149 200,1155 223,1155 225,1160 240,1160 240,1157 242,1155 256,1155 260,1154 262,1152 265,1152 267,1150 271,1150 275,1146 275,1135 273,1130 267,1125 261,1125 257,1123 199,1123 195,1125 189,1125 187,1126"><p>SSSPÁNOK...</p></text-area><text-area bgcolor="#ffffff" points="299,1150 300,1162 307,1171 316,1175 328,1176 332,1177 361,1177 363,1176 370,1176 377,1173 380,1173 389,1164 389,1147 376,1136 371,1136 368,1136 322,1136 319,1136 314,1136 309,1139"><p>SAMOZREJME.</p></text-area><text-area bgcolor="#ffffff" points="714,1127 714,1135 719,1146 727,1152 738,1154 740,1156 766,1157 769,1159 783,1159 787,1157 796,1156 798,1154 806,1153 813,1150 819,1144 821,1139 821,1128 819,1126 819,1123 813,1116 807,1113 799,1112 795,1112 741,1112 724,1116"><p>ZASLÚŽIŠ SI HO.</p></text-area></text-layer></page>
    <page>
