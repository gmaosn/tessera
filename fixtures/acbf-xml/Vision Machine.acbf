    <frame points="14,29 983,39 981,371 12,362"/><frame points="12,364 982,372 981,685 10,679"/><frame points="77,694 268,694 270,712 585,712 591,697 630,695 634,714 861,714 858,1020 827,1024 815,1059 917,1064 917,1155 798,1158 797,1181 160,1183 149,1122 150,1068 172,1032 130,1026 130,786 74,782"/><frame points="14,1186 983,1183 985,1525 16,1523"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="157,93 158,68 176,55 259,55 278,71 277,94 254,109 210,111 172,107"><p>KAM DO PEKLA IDEŠ?</p></text-area><text-area bgcolor="#ffffff" points="461,124 452,105 460,86 479,80 542,80 562,88 562,106 561,125 521,131 487,133"><p>NA PRECHÁDZKU. POĎ SO MNOU.</p></text-area><text-area bgcolor="#ffffff" points="590,139 571,122 571,95 587,81 617,74 705,74 734,86 742,111 726,135 702,141"><p>DO PEKLA S TEBOU! PREDPOKLADÁ SA, ŽE <emphasis>NEBUDEŠ ZLÁ</emphasis> A PODOBNÉ VECI ...</p></text-area><text-area bgcolor="#ffffff" points="560,211 540,192 544,165 584,148 708,148 733,163 742,187 728,208 700,217 606,219"><p>JA VIEM, BUDDY. MÁM ROVNAKÉ ŤAŽKOSTI SAMA SO SEBOU AKO MÁŠ AJ TY.</p></text-area><text-area bgcolor="#ffffff" points="624,261 622,241 642,225 724,225 734,225 751,236 753,259 734,274 687,277 650,275"><p>TAKMER SME TO UŽ ALE <emphasis>OPRAVILI.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="774,299 775,280 790,274 842,274 853,283 854,301 842,311 809,313 787,310"><p>OPRAVILI <emphasis>ČO?</emphasis></p></text-area><text-area bgcolor="#fefefe" points="483,397 483,401 485,406 492,412 502,413 504,415 584,415 591,413 593,411 597,411 603,405 603,399 596,391 589,388 571,388 507,388 497,388 494,390 490,390"><p>VŠETKO.</p></text-area><text-area bgcolor="#fbfdff" points="478,610 478,623 484,638 497,650 511,652 516,653 587,653 589,652 597,652 599,650 605,650 607,647 612,645 619,638 622,629 621,607 619,602 608,591 587,586 511,586 507,588 496,590 490,594 481,603"><p>HOCI SI TO VÄČŠINA ĽUDÍ NAJSKÔR ANI NEVŠIMNE.</p></text-area><text-area bgcolor="#f4e9c9" points="84,702 83,761 85,774 261,774 261,702 258,702 86,702"><p>"LEN SA ZRAZU BUDÚ LEPŠIE VEDIEŤ KONCENTROVAŤ."</p></text-area><text-area bgcolor="#f3e8c7" points="730,1076 729,1127 731,1145 906,1145 907,1073 901,1073 743,1073 733,1073"><p>"BUDÚ DOSTÁVAŤ MENEJ NEVYŽIADANEJ REKLAMY A ŠUMU, KTORÝ IM ZABERÁ VÝHĽAD."</p></text-area><text-area bgcolor="#f4e9c9" points="45,1209 46,1271 255,1271 256,1208 253,1208 61,1208"><p>"AKOBY NIEKTO OTVORIL OKNO A VPUSTIL DNU SVIEŽI VZDUCH."</p></text-area><text-area bgcolor="#fffffd" points="564,1233 564,1239 568,1244 568,1245 571,1248 573,1248 574,1249 578,1249 579,1250 586,1250 590,1251 618,1251 618,1251 620,1249 626,1248 630,1244 630,1242 632,1239 632,1233 630,1231 630,1228 629,1228 626,1225 624,1225 618,1224 576,1224 570,1226 565,1231"><p>UFFF.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0018.webp"/>
    <frame points="3,2 984,9 984,618 264,617 264,540 4,539"/><frame points="5,552 248,552 260,1525 4,1526"/><frame points="258,631 960,636 962,982 261,981"/><frame points="261,989 686,992 693,1464 267,1467"/><frame points="691,990 990,991 990,1522 698,1527"/><text-layer lang="sk"><text-area bgcolor="#f4e8c5" points="68,46 69,100 209,100 209,45 205,45 71,45"><p>"SLEDOVANIE SA TAKISTO SKONČILO."</p></text-area><text-area bgcolor="#f5e5c8" points="103,126 103,210 105,212 324,211 323,123 110,123"><p>"A DATABÁZY, KTORÉ OBSAHOVALI KAŽDÉHO <emphasis>OSOBNÉ INFORMÁCIE</emphasis> BOLI KOMPLETNE VYMAZANÉ."</p></text-area><text-area bgcolor="#ffffff" points="665,255 666,271 678,284 683,287 703,291 705,292 767,292 800,291 817,285 826,276 829,269 826,251 812,238 803,238 795,235 780,235 776,234 714,234 711,235 689,237 682,242 674,244"><p>ČO MYSLÍTE TÝM, ŽE TAM <emphasis>NIČ</emphasis> NIE JE?</p></text-area><text-area bgcolor="#404040" points="8,568 237,568 237,607 8,607" type="commentary" inverted="True"><p><emphasis>MOUNTAIN VIEW, KALIFORNIA</emphasis></p></text-area><text-area bgcolor="#f0e1c0" points="98,849 97,897 99,906 111,907 192,907 193,906 193,848 192,848 106,848 100,848"><p>"ZAČÍNAME VŠETKO ODZNOVA."</p></text-area><text-area bgcolor="#ffffff" points="137,1049 137,1056 138,1057 138,1059 139,1061 147,1069 149,1069 150,1070 155,1070 156,1071 173,1072 190,1072 192,1070 201,1069 203,1068 210,1060 210,1047 208,1044 206,1043 202,1038 200,1038 196,1036 193,1036 192,1036 155,1036 154,1036 147,1037 139,1044"><p>ACH, ČLOVEČE.</p></text-area><text-area bgcolor="#ffffff" points="499,641 729,641 730,677 694,705 616,712 537,705 504,684 497,663"><p>TO JE VŠETKO, ČO MI CHCETE POVEDAŤ? PRÍJEM Z MIKROPLATIEB PRÁVE KLESOL NA <emphasis>NULU!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="649,894 650,918 660,942 672,954 680,958 707,965 797,965 833,962 856,953 873,932 873,893 865,875 847,861 818,854 705,854 682,860 664,869 657,876"><p>ONI ... ONI ZASIAHLI SOFTVÉR, KTORÝ SPRAVUJE ZDAŇOVANIE, REKLAMNÉ SERVRE A MECHANIZMY NA VYNUCOVANIE DODRŽIAVANIA AUTORSKÝCH PRÁV ...</p></text-area><text-area bgcolor="#2f2f2f" points="266,1001 473,1001 473,1038 266,1038" type="commentary" inverted="True"><p><emphasis>KOKOMO, INDIANA.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="324,1069 326,1079 335,1088 339,1088 342,1091 353,1091 355,1093 365,1093 369,1096 380,1096 383,1093 395,1093 397,1091 408,1091 411,1088 417,1088 422,1084 425,1079 424,1065 421,1061 410,1055 406,1055 403,1055 343,1055 338,1057 331,1059 326,1064"><p>ČO TO ZNAMENÁ ...</p></text-area><text-area bgcolor="#ffffff" points="473,1137 438,1125 423,1105 429,1085 431,1056 458,1045 482,1041 563,1041 603,1054 618,1083 615,1111 594,1130 580,1135"><p>TO ZNAMENÁ, ŽE ĽUDIA UŽ NIE SÚ POVINNÍ PLATIŤ POPLATKY VŽDY, KEĎ SI NIEKTO Z NICH ZAPÍSKA PESNIČKU CHRÁNENÚ AUTORSKÝM PRÁVOM, PÁN SENÁTOR.</p></text-area><text-area bgcolor="#ffffff" points="458,1195 449,1171 458,1152 477,1140 632,1140 658,1157 660,1184 644,1203 608,1211 526,1211 482,1208"><p>ĽUDIA UŽ NIE SÚ POVINNÍ SLEDOVAŤ LEN FÉROVÉ A VYVÁŽENÉ PRÍSPEVKY A VIDEÁ.</p></text-area><text-area bgcolor="#ffffff" points="807,1069 809,1098 816,1110 823,1117 826,1117 831,1121 840,1124 850,1124 852,1125 913,1125 932,1123 948,1116 958,1104 960,1094 958,1062 943,1046 932,1043 929,1040 920,1040 917,1039 869,1039 839,1040 825,1046 811,1059"><p>ZÁROVEŇ UŽ SATIRICKÉ A PARODUJÚCE VÝTVORY NIE SÚ POTLÁČANÉ.</p></text-area><text-area bgcolor="#ffffff" points="756,1402 756,1408 763,1416 778,1420 841,1420 845,1419 851,1419 853,1417 856,1417 863,1410 862,1399 854,1392 768,1392 764,1395 761,1396"><p><emphasis>SAKRA!</emphasis></p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0019.webp"/>
    <frame points="44,69 421,70 416,21 435,18 475,37 470,65 948,70 951,348 925,347 892,348 847,357 811,367 790,375 43,374"/><frame points="43,404 737,404 784,372 811,365 844,353 890,348 924,343 952,347 991,359 992,805 48,799"/><frame points="46,806 337,810 345,836 468,835 595,842 600,819 657,801 711,813 719,837 743,837 761,811 801,805 836,819 844,839 942,844 950,1075 930,1083 903,1119 47,1118"/><frame points="6,1126 991,1126 993,1478 5,1476"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="175,172 139,167 113,153 104,124 116,101 158,87 250,87 284,97 299,117 297,147 275,164 226,171"><p>... A AUTORSKÉ PRÁVO BOLO SKRÁTENÉ SPÄŤ NA DĹŽKU ŽIVOTA AUTORA PLUS PÄŤDESIAT ROKOV.</p></text-area><text-area bgcolor="#ffffff" points="143,241 134,212 148,189 180,176 291,176 333,185 346,207 345,231 318,251 261,259 183,257"><p>DOSLOVA <emphasis>MILIARDY</emphasis> DOLÁROV POTENCIÁLNEHO BOHATSTVA BOLI PRÁVE REDISTRIBUOVANÉ.</p></text-area><text-area bgcolor="#ffffff" points="579,194 580,209 586,221 594,229 604,234 618,237 620,238 722,238 752,229 763,217 763,189 746,173 714,167 644,167 609,169 592,176 582,186"><p>TO JE NEZMYSEL. NEDOKÁŽU PREDSA ZMENIŤ ZÁKONY TEJTO KRAJINY.</p></text-area><text-area bgcolor="#ffffff" points="70,415 323,415 327,439 313,466 277,478 198,482 126,480 88,470 68,445"><p>KONTROLUJÚ ALE SOFTVÉR, ČO NÁM ZNEMOŽŇUJE USKUTOČNIŤ KROKY NA VYNUCOVANIE ZÁKONA.</p></text-area><text-area bgcolor="#ffffff" points="373,470 373,486 375,489 375,495 381,507 390,516 409,523 456,525 460,526 479,526 484,522 497,520 509,512 519,500 519,493 521,491 519,469 514,461 514,457 504,448 495,443 488,443 486,441 449,441 431,441 417,441 407,441 394,446 375,465"><p>TO JE LEN <emphasis>TECHNICKÝ</emphasis> PROBLÉM. NAŠI ĽUDIA TO VYRIEŠIA.</p></text-area><text-area bgcolor="#ffffff" points="280,710 264,691 264,667 284,653 307,649 420,649 446,664 446,691 433,708 396,719 312,719"><p>TO JE MOŽNÉ. ALE ČÍM DLHŠIE BUDÚ ĽUDIA ROBIŤ SO SYSTÉMOM ...</p></text-area><text-area bgcolor="#ffffff" points="407,763 390,743 398,721 435,711 506,711 530,720 541,741 532,759 506,767 432,768"><p>... TÝM <emphasis>VIAC</emphasis> SA IM TO BUDE PÁČIŤ.</p></text-area><text-area bgcolor="#ffffff" points="543,732 534,709 542,690 566,681 640,681 668,693 672,720 652,737 603,742 564,741"><p>A JE TU EŠTE <emphasis>VÄČŠÍ</emphasis> PROBLÉM.</p></text-area><text-area bgcolor="#ffffff" points="669,762 660,742 672,736 677,726 766,726 776,726 790,737 790,757 765,768 698,771"><p>SAMOZREJME, ŽE ÁNO.</p></text-area><text-area bgcolor="#ffffff" points="438,919 398,913 378,899 373,873 386,857 421,845 520,845 556,856 569,876 564,898 536,915" type="audio"><p>PANI PREZIDENTKA ... PRIŠLI SME O NÁŠ SLEDOVACÍ SYSTÉM.</p></text-area><text-area bgcolor="#ffffff" points="404,983 396,959 406,937 441,923 554,923 600,929 620,946 622,977 594,997 530,1004 434,998" type="audio"><p>CELÝ NÁŠ PROTITERORISTICKÝ SYSTÉM A SYSTÉM BOJA PROTI KRIMINALITE NA ŇOM ZÁVISIA.</p></text-area><text-area bgcolor="#fefefe" points="395,1046 395,1050 399,1060 409,1070 412,1070 416,1073 423,1073 425,1075 505,1075 507,1073 520,1072 532,1060 533,1056 532,1043 530,1038 523,1031 508,1028 505,1026 490,1026 439,1026 423,1028 409,1029 398,1039" type="audio"><p>ŽIADEN STRACH, CHAVEZ.</p></text-area><text-area bgcolor="#fefefe" points="658,1155 658,1162 660,1166 667,1173 670,1173 671,1174 737,1174 740,1173 740,1167 741,1166 741,1157 740,1156 740,1154 735,1149 731,1148 727,1146 675,1146 672,1147 666,1147 664,1148"><p>EVERSOVÁ!</p></text-area><text-area bgcolor="#ffffff" points="630,1249 602,1242 590,1224 598,1204 623,1198 699,1198 722,1205 730,1225 718,1242 677,1248" type="audio"><p>DOSTANEŠ SVOJ SYSTÉM SPÄŤ ...</p></text-area><text-area bgcolor="#ffffff" points="588,1321 580,1292 593,1269 634,1252 758,1252 802,1261 816,1282 818,1310 796,1334 754,1345 642,1347 606,1337" type="audio"><p>... HNEĎ AKO MOJI ROBOTI DOKONČIA NIČENIE SYSTÉMOM ZOZBIERANÝCH DÁT, KTORÉ NIE SÚ V SÚLADE SO ZÁKONNÝMI REGULÁCIAMI.</p></text-area><text-area bgcolor="#ffffff" points="707,1377 711,1392 729,1409 738,1409 753,1412 805,1412 835,1411 837,1409 844,1409 854,1404 865,1391 865,1373 861,1362 856,1357 832,1349 782,1349 765,1349 762,1351 732,1351 720,1356 708,1369"><p>NA TO ... NA TO ALE NEMÁTE PRÁVO!</p></text-area><text-area bgcolor="#ffffff" points="653,1451 641,1442 649,1428 659,1423 724,1423 745,1431 746,1447 724,1454 687,1455" type="audio"><p>ALE ÁNO.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0020.webp"/>
    <frame points="4,571 3,335 21,240 68,203 48,126 84,73 136,41 267,14 439,14 508,25 551,37 670,42 712,13 761,5 824,25 847,82 960,238 992,264 988,530 975,578"/><frame points="22,575 428,578 428,843 21,845"/><frame points="438,592 950,594 951,918 905,911 851,907 785,911 728,923 685,941 601,943 583,949 553,956 417,956 272,962 182,950 90,948 91,890 136,860 139,842 424,838 441,821"/><frame points="36,928 91,926 91,885 136,858 139,839 422,837 455,829 653,827 654,856 643,889 622,908 618,935 598,944 598,997 576,1016 550,1047 524,1076 499,1126 479,1175 471,1223 464,1278 465,1325 475,1375 479,1387 37,1391"/><frame points="538,1525 513,1478 489,1424 472,1367 463,1307 466,1245 478,1187 501,1121 528,1073 561,1034 594,1000 632,970 680,944 732,923 786,910 843,906 888,910 937,919 991,934 990,1524"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="254,137 214,129 197,101 200,76 220,60 243,53 318,53 349,65 358,87 356,111 336,132 293,136" type="audio"><p>EVERSOVÁ, HOVORÍME TU O BEZPEČNOSTI CELEJ NAŠEJ KRAJINY!</p></text-area><text-area bgcolor="#ffffff" points="262,179 251,163 255,149 264,141 338,141 356,145 360,164 348,181 298,184" type="audio"><p>TU SÚ V HRE ŽIVOTY!</p></text-area><text-area bgcolor="#ffffff" points="365,102 364,83 358,60 368,41 393,29 466,29 498,42 506,61 493,106 462,115 388,114" type="audio"><p>NIE. BUDETE MAŤ SYSTÉM K DISPOZÍCII ZA MENEJ AKO DVE MINÚTY.</p></text-area><text-area bgcolor="#ffffff" points="495,109 510,57 540,50 620,50 652,64 660,93 650,120 604,133 526,130 503,123" type="audio"><p>PRETO TERAZ S VAMI HOVORÍM ... ABY STE NESPRAVILI NIEČO NEROZUMNÉ A ...</p></text-area><text-area bgcolor="#ffffff" points="565,227 563,225 563,222 554,211 543,206 530,205 528,204 487,204 484,205 475,206 472,208 465,208 461,211 450,223 450,240 454,249 463,258 470,262 491,263 541,263 546,260 555,258 563,250 565,245"><p>DELTA TANGO PÄŤ PÄŤ PÄŤ.</p></text-area><text-area bgcolor="#ffffff" points="278,411 267,395 275,379 288,374 338,374 355,385 356,401 340,413" type="audio"><p>POČKAJTE, ČO?</p></text-area><text-area bgcolor="#fffeff" points="126,603 126,612 127,614 133,620 141,621 142,622 152,622 153,623 167,623 173,622 185,621 193,614 193,605 192,604 192,601 191,601 186,597 139,597 134,598 130,599 129,601 127,603"><p>ZNIČTE TO.</p></text-area><text-area bgcolor="#ffffff" points="273,619 258,607 267,597 314,597 325,606 315,620" type="audio"><p><emphasis>NIE!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="635,630 638,641 645,649 650,652 666,656 694,657 699,658 713,658 717,657 749,655 751,653 755,653 764,649 768,645 769,641 768,625 762,618 747,613 678,613 655,613 645,618"><p>AKTIVUJEM VYPÍNAČ.</p></text-area><text-area bgcolor="#f4e7c7" points="70,959 71,1000 72,1001 185,1001 185,958 180,957 74,957"><p>"DÁTOVÉ CENTRUM JE OFFLINE."</p></text-area><text-area bgcolor="#f4e9cb" points="753,1391 754,1431 934,1430 934,1400 936,1397 936,1389 927,1387 759,1387"><p>"VYPÍNANIE SATELITOV ZAHÁJENÉ."</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0021.webp"/>
    <frame points="54,3 394,4 393,570 103,570 104,591 49,591"/><frame points="423,58 933,60 936,284 853,287 853,359 888,383 888,411 871,556 843,565 428,563"/><frame points="104,568 908,570 909,774 571,776 566,789 128,786 99,769"/><frame points="55,790 940,797 944,1159 54,1154"/><frame points="53,1155 941,1159 945,1488 55,1487"/><text-layer lang="sk"><text-area bgcolor="#fefefe" points="177,180 177,183 179,185 180,188 185,193 189,195 191,195 192,196 198,196 202,198 233,198 238,196 246,195 248,193 250,193 254,189 254,187 255,186 255,178 250,173 240,171 190,171 189,171 186,171 184,172"><p>ČOŽE?</p></text-area><text-area bgcolor="#ffffff" points="471,123 471,129 473,133 479,138 483,138 484,139 497,139 498,140 501,140 505,144 505,145 513,145 516,142 519,139 530,138 532,136 534,136 538,132 538,121 533,116 531,116 529,116 480,116 475,119 474,119"><p>HEJ!</p></text-area><text-area bgcolor="#fefefe" points="572,142 572,146 579,156 588,159 590,161 609,161 610,162 613,162 616,164 627,164 631,161 649,161 653,158 656,158 658,156 661,156 666,152 665,137 663,136 659,131 654,131 651,130 592,130 584,130 577,134"><p>SAKRA!</p></text-area><text-area bgcolor="#ffffff" points="743,148 745,162 749,169 761,179 775,181 777,183 812,184 830,184 833,183 844,183 846,181 853,181 866,177 875,168 877,161 877,150 874,138 865,130 846,125 789,125 771,125 753,132 746,139"><p>OUKEJ, TAK TOTO UŽ NIE JE VTIPNÉ.</p></text-area><text-area bgcolor="#fefefe" points="690,205 690,211 697,220 700,220 703,222 718,223 749,223 765,222 771,219 777,212 777,208 775,206 775,203 771,199 764,197 709,197 704,197 701,197 696,199"><p>ACH, NIE ...</p></text-area><text-area bgcolor="#ffffff" points="741,440 741,445 753,459 757,459 763,461 825,461 834,456 841,448 841,437 838,429 832,424 827,422 817,422 769,422 758,422 753,424 745,431"><p>NIE NIE NIE NIE <emphasis>NIE</emphasis> ...</p></text-area><text-area bgcolor="#ffffff" points="524,620 515,608 538,594 600,594 620,604 620,618 598,625 547,624"><p>HALÓ?</p></text-area><text-area bgcolor="#fefefe" points="548,664 548,675 553,685 567,695 580,697 582,698 642,698 673,697 691,689 697,680 696,661 685,650 677,647 670,647 664,647 585,647 562,650 555,655" type="audio"><p>PANI PREZIDENTKA, TOTO NEMÔŽETE UROBIŤ!</p></text-area><text-area bgcolor="#ffffff" points="723,680 713,659 726,648 748,642 826,642 845,652 848,671 832,685 757,690"><p>ŽIADEN STRACH, CHAVEZ.</p></text-area><text-area bgcolor="#ffffff" points="744,735 739,711 762,692 862,692 885,704 888,732 868,744 814,749 762,746"><p>MÁME TISÍCKY ZÁLOŽNÝCH SYSTÉMOV.</p></text-area><text-area bgcolor="#f4e8c5" points="655,848 657,913 908,912 908,842 905,842 660,842"><p>"KEĎ JE SYSTÉM MIMO PREVÁDZKY, MÔŽME RUČNE VYMENIŤ NAPADNUTÉ ZARIADENIA, NAINŠTALOVAŤ ZÁLOHY A SYSTÉM REŠTARTNUŤ."</p></text-area><text-area bgcolor="#ffffff" points="288,1162 558,1162 562,1186 547,1212 506,1223 456,1229 354,1226 309,1214 289,1194"><p>TO NÁM ALE POTRVÁ <emphasis>HODINY.</emphasis> EVERSOVÁ BY NÁM ODOVZDALA SYSTÉM <emphasis>DO TRIDSIATICH SEKÚND.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="424,1308 419,1282 434,1258 480,1242 580,1242 626,1254 642,1280 640,1313 610,1331 563,1340 496,1342 484,1334 447,1330"><p>LIZ EVERSOVÁ JE TERORISTA A ZRADCA. NEMÔŽEM RISKOVAŤ ŽIVOTY <emphasis>MILIÓNOV</emphasis> ĽUDÍ NA JEJ <emphasis>DOBRÉ SLOVO.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="389,1390 374,1379 374,1350 398,1338 468,1338 496,1345 504,1371 489,1388 463,1395 412,1395"><p>AKÚ ... AKÚ MÁME ALTERNATÍVU?</p></text-area><text-area bgcolor="#ffffff" points="465,1400 491,1395 506,1384 574,1384 595,1399 602,1418 584,1433 547,1438 496,1437 469,1426"><p>TAK TO PRÁVE ZISTÍME.</p></text-area><text-area bgcolor="#ffffff" points="603,1406 596,1387 610,1374 668,1374 684,1388 682,1404 664,1411 617,1412"><p>BOH NÁM POMÁHAJ.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0022.webp"/>
    <frame points="30,14 968,20 967,399 27,400"/><frame points="29,401 968,404 968,785 26,785"/><frame points="31,784 968,784 971,1172 32,1173"/><frame points="31,1177 968,1176 975,1516 30,1518"/><text-layer lang="sk"><text-area bgcolor="#1a1a1a" points="35,33 242,33 242,73 33,73" type="commentary" inverted="True"><p><emphasis>COLUMBUS, OHIO.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="129,244 129,254 135,268 144,277 159,284 192,285 253,285 262,280 270,279 284,265 286,257 286,229 281,225 272,225 258,219 240,218 238,218 177,218 175,218 162,218 147,223 131,238"><p>DVE ŠÁLKY CUKRU ... A JEDNU LYŽIČKU VANILKY ...</p></text-area><text-area bgcolor="#1e1e1e" points="33,425 242,425 242,462 32,462" type="commentary" inverted="True"><p><emphasis>ATLANTA, GEORGIA.</emphasis></p></text-area><text-area bgcolor="#fefefe" points="499,462 500,469 504,476 511,483 515,483 519,487 538,488 540,490 630,490 635,487 635,481 640,475 641,471 640,460 630,449 624,448 622,446 607,446 536,446 521,446 506,454 503,459"><p>ZAČÍNAM PRVÝ BYPASS.</p></text-area><text-area bgcolor="#1c1c1c" points="728,807 960,807 960,844 726,844" type="commentary" inverted="True"><p><emphasis>NA HRANICI USA A TEXASU.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="62,793 224,793 228,829 213,860 178,872 120,873 78,868 59,835 56,810"><p>MÁME LOKALIZOVANÝCH TROCH Z NICH. NO MUSÍ TAM BYŤ NIEKDE EŠTE JEDEN.</p></text-area><text-area bgcolor="#fffffd" points="469,829 469,837 473,846 482,855 490,858 494,860 552,860 566,857 568,855 571,855 579,847 580,842 579,826 570,817 561,815 558,814 492,814 488,816 485,816 478,819" type="audio"><p>OCO, SI TAM?</p></text-area><text-area bgcolor="#ffffff" points="253,1105 253,1114 257,1125 262,1130 273,1134 275,1135 340,1135 345,1134 350,1134 357,1131 363,1125 366,1118 366,1105 364,1103 362,1097 357,1092 348,1088 340,1087 338,1085 322,1085 318,1085 306,1085 298,1085 286,1085 279,1087 273,1087 269,1090 263,1092 255,1100"><p>TERAZ NIE JE VHODNÁ DOBA, SYNU.</p></text-area><text-area bgcolor="#252525" points="963,1190 963,1258 682,1258 682,1190" type="commentary" inverted="True"><p><emphasis>DVESTO MÍĽ OD POBREŽIA V ZÁLIVE BAJA CALIFORNIA.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="278,1305 278,1319 281,1325 290,1334 307,1339 332,1340 355,1340 380,1339 398,1334 409,1322 409,1307 407,1305 407,1302 391,1289 302,1289 288,1294"><p>JE TO ... JE TO NAOZAJ BLÍZKO, MAMI.</p></text-area><text-area bgcolor="#ffffff" points="124,1422 122,1390 142,1368 178,1357 277,1357 312,1374 324,1402 318,1431 288,1452 196,1456 149,1448" type="audio"><p>ŽIADEN STRACH, MOJA. NÁŠ ZÁCHRANNÝ TÍM ŤA UŽ LOKALIZOVAL ... BUDÚ PRI TEBE O DVE MINÚTY.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0023.webp"/>
    <frame points="55,8 310,9 312,748 29,748 30,690 51,643 52,596 20,576 12,531 16,477 47,413 46,211"/><frame points="315,10 649,13 646,795 623,796 623,764 505,763 506,751 313,747"/><frame points="650,10 983,12 984,796 648,796"/><frame points="44,758 623,762 626,1152 616,1167 610,1183 609,1222 613,1263 625,1275 625,1496 46,1494"/><frame points="657,826 942,826 945,1500 801,1503 803,1525 667,1527 660,1516 660,1492 653,1285 623,1279 611,1262 608,1220 610,1181 614,1164 625,1150 652,1102"/><text-layer lang="sk"><text-area bgcolor="#fffffd" points="163,156 164,169 176,182 198,187 233,187 237,189 252,189 256,186 266,185 279,181 288,173 288,154 286,150 278,142 267,138 239,138 210,138 188,138 185,140 180,140 178,142 175,142 165,151"><p>ČO ... POČKAŤ ... HALÓ?</p></text-area><text-area bgcolor="#ffffff" points="59,177 160,177 173,190 172,230 59,230" type="code"><p>VZDIALENÉ PRIPOJENIE ZLYHALO.</p></text-area><text-area bgcolor="#ffffff" points="516,155 516,164 518,166 518,169 520,171 521,174 528,179 531,179 534,182 548,182 550,184 565,184 569,182 587,181 589,179 592,179 599,173 601,168 601,158 599,156 599,153 597,150 591,145 580,145 537,145 529,145 527,147 523,148"><p><strong>JEŽIŠI!</strong></p></text-area><text-area bgcolor="#ffffff" points="502,570 495,562 490,560 488,557 463,556 452,556 420,556 402,557 388,563 380,572 380,582 382,584 383,589 390,596 400,600 405,600 410,602 474,602 490,599 501,590 503,586"><p><strong>VYPNITE TO! IHNEĎ!</strong></p></text-area><text-area bgcolor="#ffffff" points="738,287 726,266 734,246 758,239 823,239 846,252 848,280 826,290 780,296"><p>MOMENT. ČO JE S MOJOU OBRAZOVKOU ...</p></text-area><text-area bgcolor="#ffffff" points="701,354 682,339 688,323 706,316 783,316 805,324 806,346 782,352 762,356 734,358" type="audio"><p>OCO, ČO SA TO ...</p></text-area><text-area bgcolor="#ffffff" points="765,391 760,372 776,358 838,358 859,370 853,392 822,400 787,400"><p>A <emphasis>SAKRA!</emphasis></p></text-area><text-area bgcolor="#fefefe" points="262,1251 262,1257 264,1258 270,1265 272,1265 274,1267 277,1267 278,1268 285,1268 291,1272 299,1272 303,1270 317,1270 322,1268 335,1267 337,1265 339,1265 340,1263 345,1259 345,1250 344,1249 344,1246 342,1245 340,1242 336,1241 333,1240 275,1240 271,1241"><p>MAMI?</p></text-area><text-area bgcolor="#ffffff" points="728,880 711,864 723,845 765,845 781,863 761,880"><p>-JÁJ-</p></text-area><text-area bgcolor="#ffffff" points="685,930 682,908 710,890 816,890 841,906 842,930 818,942 753,949 707,944"><p>VŽDY, KEĎ TO ČLOVEK ZROVNA POTREBUJE. ŽE?</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0024.webp"/>
    <frame points="12,2 981,2 981,259 9,264"/><frame points="12,266 982,263 985,663 14,661"/><frame points="13,667 720,669 721,1175 17,1179"/><frame points="719,667 985,669 986,1172 723,1173"/><frame points="16,1178 986,1175 991,1526 19,1527"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="266,9 430,9 430,39 411,57 376,63 310,61 283,52 269,33"><p>NIE, MAMI. JA NEVIEM KOĽKO VAJÍČOK MÁME V ...</p></text-area><text-area bgcolor="#ffffff" points="421,62 422,70 426,77 432,82 439,85 447,85 452,88 465,88 469,87 490,87 492,85 501,85 503,83 507,83 516,74 516,70 517,69 517,63 515,59 515,54 503,45 499,45 494,45 443,45 441,45 436,46 435,49 431,52 431,54 424,58"><p>POZOR, BUDDY ...</p></text-area><text-area bgcolor="#ffffff" points="195,256 190,226 201,208 242,194 343,194 381,209 390,232 387,255"><p>POČUJ, MAMI. ZOSTAŇ DOMA, OUKEJ? A PRESVEDČ SA, ŽE MÁŠ DVERE ZAMKNUTÉ.</p></text-area><text-area bgcolor="#ffffff" points="563,179 566,193 576,204 586,206 588,209 607,210 656,210 692,209 697,206 703,206 707,204 719,192 719,177 716,174 716,171 707,162 700,159 673,157 604,157 601,158 586,159 584,161 578,161 565,173"><p>ČO TÝM MYSLÍŠ, ŽE ŽIADNE SLEDOVANIE?</p></text-area><text-area bgcolor="#ffffff" points="700,214 715,210 724,195 816,195 835,212 834,233 812,243 737,243 706,235"><p>MYSLÍM TÝM, ŽE <emphasis>VEĽKÉ OČI</emphasis> SÚ VYPNUTÉ ...</p></text-area><text-area bgcolor="#fcfffe" points="714,383 713,387 714,402 717,406 718,410 723,415 731,418 736,418 738,420 751,420 754,421 765,421 768,420 778,420 782,418 787,418 793,415 801,407 801,405 803,403 803,385 801,383 801,379 795,372 790,369 787,369 785,369 730,369 723,372"><p>... NO MY STÁLE <emphasis>FUNGUJEME.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="56,760 44,733 49,707 96,690 209,690 246,702 257,728 253,753 220,772 100,772" type="audio"><p>MÁME 12 PERCENT NAŠICH SLEDOVACÍCH KAMIER OPÄŤ NA ANALÓGOVÝCH KÁBLOCH.</p></text-area><text-area bgcolor="#ffffff" points="119,820 114,799 132,779 248,779 269,794 266,818 234,830 144,830" type="audio"><p>PANI PREZIDENTKA ... TOTO JE <emphasis>ŠIALENÉ!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="126,1020 122,997 144,979 221,979 235,1001 225,1025 190,1031 147,1030"><p>KONTROLUJ SA, CHAVEZ.</p></text-area><text-area bgcolor="#ffffff" points="159,1079 162,1086 169,1093 171,1093 177,1098 211,1101 262,1101 281,1098 289,1090 291,1082 300,1072 300,1065 290,1054 283,1050 275,1050 262,1048 207,1048 174,1050 173,1054 168,1056 160,1064" type="audio"><p>CELÝ BEZPEČNOSTNÝ APARÁT ...</p></text-area><text-area bgcolor="#ffffff" points="299,1120 294,1096 310,1075 347,1063 471,1063 500,1079 512,1104 506,1129 474,1144 400,1147 334,1143 314,1136"><p>... BY MOHOL BYŤ ZNEUŽITÝ TÝMI TERORISTAMI A SPÔSOBIŤ <emphasis>TISÍCKRÁT</emphasis> VÄČŠIE ŠKODY AKO SÚ TIETO.</p></text-area><text-area bgcolor="#ffffff" points="501,1064 512,1046 548,1034 640,1034 678,1044 688,1068 677,1096 643,1106 556,1108 515,1100"><p>VER MI, CHAVEZ. SOM ROVAKO ZHROZENÁ A POBÚRENÁ AKO SI TERAZ TY.</p></text-area><text-area bgcolor="#ffffff" points="738,734 731,712 752,692 776,686 856,686 884,699 890,728 868,746 812,751 758,747"><p>KOMPLETNÉ VYČISTENIE SKONČÍ ZA 59 MINÚT.</p></text-area><text-area bgcolor="#ffffff" points="818,770 816,776 818,798 823,807 835,819 865,822 878,825 913,825 933,824 950,824 950,820 952,818 957,818 964,811 971,796 970,777 965,763 956,754 930,746 890,746 875,753 846,758 829,758" type="audio"><p>NIE. AUTORIZUJEM OKAMŽITÝ REŠTART CLÉHO SYSTÉMU.</p></text-area><text-area bgcolor="#ffffff" points="742,862 738,842 764,828 856,828 880,841 878,864 846,870 770,870"><p>TAK TO NIE, SEKRETÁR CHAVEZ ...</p></text-area><text-area bgcolor="#fefefe" points="501,1226 501,1231 505,1240 515,1249 518,1249 521,1252 528,1252 530,1254 633,1254 633,1251 635,1249 639,1249 647,1241 650,1233 650,1225 646,1217 637,1209 626,1207 624,1205 602,1205 519,1205 518,1208 513,1210 503,1220" type="audio"><p>... STE ZATKNUTÝ.</p></text-area><text-area bgcolor="#ffffff" points="504,1354 507,1371 511,1379 518,1386 530,1391 546,1392 628,1392 646,1386 655,1377 659,1369 659,1358 657,1356 657,1348 654,1342 642,1332 619,1328 557,1328 532,1330 515,1330 507,1338 506,1352"><p>VY IDIOTI! NEVIDÍTE, ČO SA TU PRÁVE DEJE?</p></text-area></text-layer></page>
