    <frame points="3,180 23,151 32,84 603,83 603,100 565,100 566,735 599,736 602,758 3,757"/><frame points="565,101 750,99 768,77 826,58 873,55 926,90 962,99 967,211 985,240 989,322 969,374 599,372 597,365 563,363"/><frame points="565,379 961,377 962,745 715,745 710,755 694,754 673,744 598,738 565,734"/><frame points="46,761 621,761 624,1193 51,1195"/><frame points="622,760 945,760 949,1195 624,1195"/><frame points="51,1201 945,1200 950,1495 51,1497"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="223,185 216,170 222,157 239,153 297,153 318,160 321,174 307,186 257,189"><p>NAZDAR, CHLAPCI.</p></text-area><text-area bgcolor="#ffffff" points="280,231 280,237 282,243 291,251 296,251 299,253 305,253 306,254 318,254 326,261 335,261 340,260 340,258 343,255 364,251 369,248 375,242 375,233 373,231 373,227 365,220 357,220 352,218 314,218 295,219 287,223"><p>UFFF, ČLOVEČE.</p></text-area><text-area bgcolor="#ffffff" points="211,351 207,330 221,315 285,315 301,327 299,351 275,361 233,361"><p>ŽIADEN STRACH.</p></text-area><text-area bgcolor="#ffffff" points="582,153 585,167 595,178 604,183 623,184 625,186 683,186 689,182 689,180 693,177 699,165 698,147 693,139 684,132 677,131 675,130 607,130 594,134 585,143"><p>NIE SOM TERAZ NA PILULKÁCH.</p></text-area><text-area bgcolor="#ffffff" points="711,383 789,383 789,406 775,418 738,420 718,413 712,398"><p>ČO TO JE?</p></text-area><text-area bgcolor="#ffffff" points="822,444 819,442 819,436 811,428 806,427 804,426 774,426 773,426 748,426 743,429 734,438 732,442 734,459 739,466 746,472 750,472 752,474 756,475 800,475 802,474 812,470 822,459"><p>TO JA NETUŠÍM.</p></text-area><text-area bgcolor="#fcfeff" points="626,639 626,662 629,672 640,686 657,694 718,694 738,693 740,691 748,690 763,675 763,671 765,669 765,645 763,643 762,633 750,620 730,614 662,614 657,615 643,619 629,632"><p>UTLMOVACIE PROSTRIEDKY. SPROUT ICH POUŽÍVA NA KONTROLU ĽUDÍ.</p></text-area><text-area bgcolor="#ffffff" points="53,767 188,767 192,781 183,796 171,813 115,817 75,814 55,803"><p>PRACOVALA SOM PRE SPROUT, PAMÄTÁŠ?</p></text-area><text-area bgcolor="#ffffff" points="224,855 189,843 174,813 183,796 196,782 223,775 306,775 345,783 359,799 361,829 344,847 310,855"><p>A OSPRAVEDLŇUJEM SA, ŽE SOM TU NESTIHLA PRE VÁS VŠETKO DOKONALE PRIPRAVIŤ ...</p></text-area><text-area bgcolor="#ffffff" points="191,1086 191,1100 195,1109 205,1118 223,1123 292,1123 304,1121 308,1118 311,1118 315,1116 323,1108 324,1092 322,1083 309,1071 303,1071 290,1069 225,1069 205,1072"><p>POČKAJ ... TY SI VEDELA, ŽE SEM PRÍDE?</p></text-area><text-area bgcolor="#ffffff" points="89,1144 91,1157 101,1168 118,1176 135,1177 206,1177 239,1176 255,1168 263,1159 263,1145 261,1139 255,1132 217,1131 201,1127 193,1123 125,1123 122,1125 111,1126 106,1128 104,1131 99,1132"><p>PO TEJ VEĽKEJ BITKE TU S NAŠIM BUDDYM?</p></text-area><text-area bgcolor="#ffffff" points="665,1124 650,1106 649,1083 663,1068 689,1062 771,1062 801,1074 809,1104 796,1120 758,1130 685,1130"><p>MUSELA SEM PRÍSŤ A <emphasis>POBOZKAŤ</emphasis> HO PRE UDOBRENIE SA ...</p></text-area><text-area bgcolor="#ffffff" points="763,1158 759,1134 795,1121 811,1118 861,1118 888,1127 896,1146 886,1166 851,1173 786,1171"><p>... ALEBO HO <emphasis>ZABIŤ</emphasis> UŽ <emphasis>NADOBRO.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="317,1210 515,1210 518,1234 506,1256 471,1268 411,1272 341,1265 319,1247 315,1229"><p>PRIŠLA SI ALE TROCHU <emphasis>PRISKORO.</emphasis> STÁLE EŠTE SPRACOVÁVAME ZÍSKANÉ DÁTA ...</p></text-area><text-area bgcolor="#ffffff" points="305,1332 292,1305 297,1285 316,1274 382,1274 398,1274 421,1287 423,1319 400,1336 369,1340 323,1338"><p>... TERAZ MA ALE NA CHVÍĽU OSPRAVEDLŇTE, PROSÍM ...</p></text-area></text-layer></page>
