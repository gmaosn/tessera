    <frame points="32,111 177,111 177,91 202,80 258,80 258,56 286,45 340,49 354,71 352,104 560,112 561,508 31,509"/><frame points="564,116 654,114 657,89 685,71 759,65 830,75 848,94 849,112 963,118 966,321 962,448 959,514 560,510"/><frame points="55,516 347,517 342,582 343,650 346,674 347,1163 58,1164"/><frame points="340,582 348,564 370,554 434,557 432,535 457,513 516,507 586,515 610,529 638,694 637,805 642,1168 439,1165 415,1171 379,1166 352,1163 346,674 340,647"/><frame points="644,518 930,520 932,1167 647,1168"/><frame points="56,1499 55,1224 229,1182 267,1167 316,1162 363,1163 414,1169 445,1176 476,1164 496,1169 673,1205 935,1296 990,1368 991,1394 931,1498"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="268,86 267,66 283,56 329,56 342,69 339,90 315,101 281,99"><p>UFF, PREPÁČTE.</p></text-area><text-area bgcolor="#ffffff" points="192,124 187,105 203,91 261,91 271,100 278,112 268,129 217,131"><p>BOLO TO DOBRÉ.</p></text-area><text-area bgcolor="#ffffff" points="243,188 237,162 245,139 272,133 283,121 401,121 443,131 457,152 455,185 433,205 385,212 299,213 260,205"><p><emphasis>O ČOM </emphasis>TO HOVORÍŠ? ZABILA MA ASI <emphasis>MILIÓNKRÁT</emphasis> A ZNIČILA KAŽDÝ SVET, KTORÝ SME KEDY VYTVORILI.</p></text-area><text-area bgcolor="#ffffff" points="193,499 173,478 171,449 188,430 217,422 330,422 361,434 371,457 367,482 349,500"><p>A MY SME ZAS ZOZBIERALI 93 TERABAJTOV DÁT O JEJ SYSTÉME A SCHOPNOSTIACH ...</p></text-area><text-area bgcolor="#ffffff" points="679,142 667,120 670,97 699,81 799,81 829,95 837,123 820,144 775,153 707,151"><p>... A POTOM IŠLA <emphasis>DOMOV</emphasis> MYSLIAC SI, ŽE VYKONALA <emphasis>DOBRÚ</emphasis> PRÁCU.</p></text-area><text-area bgcolor="#ffffff" points="778,167 778,174 780,180 788,189 803,194 825,195 828,197 839,197 843,195 855,195 873,192 875,190 881,189 886,184 886,182 888,180 888,170 886,168 885,161 881,157 867,152 827,152 823,152 819,152 814,155 809,155 807,157 787,158"><p>A TO MÁ AJ PRAVDU!</p></text-area><text-area bgcolor="#ffffff" points="743,228 735,217 749,208 783,208 795,222 779,230"><p>NIE.</p></text-area><text-area bgcolor="#ffffff" points="720,263 716,246 727,239 771,239 783,248 783,263 766,269 735,269"><p>POZRI.</p></text-area><text-area bgcolor="#fffffd" points="289,995 286,986 278,978 266,975 258,975 256,972 248,972 244,971 237,971 230,972 211,972 205,976 198,976 190,978 180,988 179,992 177,994 177,999 179,1001 179,1007 182,1011 182,1013 188,1019 195,1020 199,1023 265,1023 267,1022 272,1022 274,1020 280,1018 288,1010"><p>HEJ, HEJ. ČO TO JE?</p></text-area><text-area bgcolor="#ffffff" points="111,1082 95,1062 100,1042 124,1030 203,1030 243,1030 259,1043 259,1070 237,1082 173,1090"><p>JEDEN Z NAŠICH VEĽMI <emphasis>DÔLEŽITÝCH</emphasis> VIRTUÁLNYCH SVETOV.</p></text-area><text-area bgcolor="#ffffff" points="449,539 451,556 459,565 472,569 476,572 485,572 487,573 571,573 574,570 578,570 581,567 585,567 598,553 597,538 587,526 580,522 554,520 491,520 475,520 473,522 459,526 451,534"><p>DAVE! ČO TY TU SAKRA ROBÍŠ?</p></text-area><text-area bgcolor="#ffffff" points="343,647 343,585 363,573 379,568 452,568 465,576 488,581 498,601 495,641 467,663 409,667 359,661"><p>LIZ SA PÁČILI MOJE VIDEÁ, MOJE ZANIETENIE KOMUNITOU. TAK SOM JEJ POMOHOL PRI TVORBE TOHTO MIESTA.</p></text-area><text-area bgcolor="#fefefe" points="383,1014 383,1021 389,1037 401,1049 425,1054 470,1054 503,1052 515,1045 522,1038 525,1031 525,1016 522,1011 522,1003 515,996 506,991 501,991 496,988 486,988 484,986 470,986 453,986 449,986 425,986 413,990 405,990 394,996 387,1003 385,1012"><p>A NIKTO SA ANI NEUNÚVAL MI TO OZNÁMIŤ?</p></text-area><text-area bgcolor="#ffffff" points="699,555 700,564 702,566 703,571 712,580 725,583 727,585 754,585 758,586 765,590 776,590 782,585 791,585 809,580 819,569 818,551 811,542 800,537 774,535 734,535 731,536 717,537 708,542 701,549"><p>VŠETKO JE TO LEN O TEBE, ČO?</p></text-area><text-area bgcolor="#ffffff" points="686,683 686,688 689,692 698,700 707,701 709,703 725,703 726,706 739,706 739,705 741,703 749,703 751,701 766,700 773,694 773,691 774,690 773,680 765,673 762,673 760,672 702,672 700,673 697,673 692,676"><p>OBVYKLE.</p></text-area><text-area bgcolor="#ffffff" points="722,1077 722,1086 725,1094 738,1109 750,1114 775,1116 856,1116 891,1109 903,1095 903,1077 899,1068 892,1061 875,1053 856,1052 854,1051 775,1051 772,1052 754,1053 737,1059 727,1068"><p>ČO JE TU NA TOM TAKÉ ÚŽASNÉ? CELÉ TOTO MIESTO VYZERÁ AKO ...</p></text-area><text-area bgcolor="#ffffff" points="236,1203 238,1218 243,1230 253,1240 275,1249 299,1251 415,1251 418,1244 436,1231 440,1218 437,1193 424,1180 409,1173 377,1170 313,1170 269,1173 252,1181 240,1194"><p>... TAK AKO SKUTOČNÝ SVET. JE TO MIESTO, KDE SA ASI ZVÄČŠA VYSKYTUJEŠ. NIE JE TAK?</p></text-area><text-area bgcolor="#ffffff" points="581,1230 581,1245 582,1246 582,1251 591,1261 594,1261 596,1263 645,1263 647,1261 650,1261 655,1257 658,1251 658,1236 657,1235 657,1232 649,1224 644,1223 598,1223 592,1225 583,1227"><p>NIE JE TO SRANDA?</p></text-area><text-area bgcolor="#fefefe" points="563,1332 564,1345 567,1349 568,1353 575,1360 585,1361 587,1363 650,1363 659,1358 662,1358 669,1350 670,1345 669,1330 667,1328 666,1324 660,1319 654,1316 649,1316 646,1314 629,1314 589,1314 582,1317 573,1318 567,1323"><p>O ČO TU VLASTNE IDE?</p></text-area><text-area bgcolor="#ffffff" points="722,1357 724,1371 730,1380 741,1387 746,1387 754,1390 805,1390 834,1389 836,1387 847,1384 856,1375 858,1367 858,1356 854,1352 854,1348 849,1343 844,1342 840,1339 827,1337 773,1337 744,1338 736,1343 731,1344 725,1350 724,1355"><p>TO JE PRESNE TO, ČO MI NEŠLO DO HLAVY.</p></text-area></text-layer></page>
