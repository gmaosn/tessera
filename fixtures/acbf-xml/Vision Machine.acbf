    <frame points="45,403 119,90 984,102 973,819 978,967 798,967 250,1000 3,999 26,900"/><frame points="55,1000 926,1001 925,1236 54,1233"/><frame points="55,1232 924,1239 924,1473 635,1474 620,1500 542,1502 507,1491 497,1473 51,1471"/><text-layer lang="sk"><text-area bgcolor="#f4e9cb" points="294,346 294,395 297,402 430,402 434,398 434,346 430,345 303,345 296,345"><p>"VAŠE MOŽNOSTI SÚ NEKONEČNÉ."</p></text-area><text-area bgcolor="#ffffff" points="303,1032 303,1039 305,1042 306,1046 311,1051 314,1051 315,1052 315,1055 318,1056 324,1056 329,1054 353,1054 357,1052 362,1052 367,1049 367,1048 372,1042 371,1030 364,1024 362,1024 359,1023 319,1023 312,1025 308,1026"><p>WOW.</p></text-area><text-area bgcolor="#ffffff" points="550,1157 559,1148 572,1146 617,1146 634,1154 627,1172 559,1170"><p>CHALANI...</p></text-area><text-area bgcolor="#ffffff" points="510,1206 519,1188 551,1178 655,1178 683,1190 691,1210 690,1226 514,1225"><p>... MYSLÍM, ŽE NÁM PRÁVE DÁVAJÚ TO, ČO SME SI PRIALI.</p></text-area><text-area bgcolor="#fefefe" points="505,1454 505,1461 508,1467 508,1472 522,1486 529,1486 531,1488 600,1488 602,1486 610,1485 623,1473 623,1451 621,1446 609,1434 537,1434 534,1434 520,1437 509,1447"><p>TERAZ SA STANEME <emphasis>VŠETCI</emphasis> VIZIONÁRMI.</p></text-area></text-layer></page>
