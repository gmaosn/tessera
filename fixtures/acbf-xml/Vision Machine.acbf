    <frame points="140,49 945,49 947,313 139,313"/><frame points="43,320 854,317 860,581 42,583"/><frame points="28,590 856,587 861,882 43,880 41,694 20,661 17,621"/><frame points="110,1511 109,1360 105,879 514,883 561,849 621,828 683,832 729,856 788,883 981,886 990,1515"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="220,101 222,87 237,81 293,81 306,94 294,111 235,112"><p>A KONČÍ.</p></text-area><text-area bgcolor="#ffffff" points="294,124 296,109 311,102 318,98 365,98 385,111 378,129 339,135 310,131"><p>ACH BOŽE.</p></text-area><text-area bgcolor="#fffeff" points="672,112 676,132 680,140 689,149 713,159 742,160 811,160 847,159 870,150 881,139 885,129 883,108 879,98 872,91 852,82 819,79 749,79 707,82 688,90 675,103" type="audio"><p>KÁMO, NEUVERÍŠ, ČO SA MI PRÁVE STALO. I KEĎ ... STÁVÍM SA, ŽE UVERÍŠ ...</p></text-area><text-area bgcolor="#ffffff" points="729,276 743,277 757,284 847,284 857,279 861,279 868,273 870,268 870,250 868,246 857,236 842,232 828,232 775,232 761,232 745,237 734,247 731,252 731,271 729,273"><p>DAVE! JA NEMÁM NA SEBE iOČI!</p></text-area><text-area bgcolor="#ffffff" points="335,327 465,327 470,350 458,371 431,377 353,376 333,357"><p>TAK AKO TO, ŽE S TEBOU HOVORÍM?</p></text-area><text-area bgcolor="#fefcfb" points="589,371 589,382 594,398 610,414 614,415 614,419 618,422 736,422 766,421 786,416 795,411 807,400 810,393 808,368 796,353 770,343 745,341 670,341 632,343 605,352 592,364" type="audio"><p>TO <emphasis>NETUŠÍM!</emphasis> STÁLE VŠAK PRIJÍMAM <emphasis>SIGNÁL!</emphasis> ONI ... ONI MUSELI NIEČO UROBIŤ ...</p></text-area><text-area bgcolor="#ffffff" points="38,597 270,597 279,619 280,661 262,687 224,701 200,707 108,705 54,691 28,657 26,621" type="audio"><p>ZDRAVÍM, BUDDY. NEDÁVNO SI SI POZREL EPIZÓDU "BUDDYHO LUV SHO", KTORÁ OBSAHOVALA NÁZORY, KTORÉ BOLI 73 PERCENT UŽÍVATEĽMI OZNAČENÉ AKO <emphasis>KONTROVERZNÉ.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="61,768 61,738 77,721 106,711 230,711 264,725 277,754 270,783 242,801 193,806 109,803 76,792" type="audio"><p>NEDÁVNO SCHVÁLENÁ LEGISLATÍVA O FÉROVOSTI A ROVNOVÁHE VYŽADUJE, ABY TI BOLI POSKYTNUTÉ AJ <emphasis>ODLIŠNÉ</emphasis> NÁZORY.</p></text-area><text-area bgcolor="#fefefc" points="618,679 618,687 626,695 634,697 636,698 708,698 710,697 715,697 717,695 719,695 725,690 726,686 725,678 716,670 706,668 627,668 622,670 621,675"><p>ACH, ČLOVEČE.</p></text-area><text-area bgcolor="#fefefe" points="271,946 272,961 278,970 285,976 304,979 370,979 371,978 383,968 385,962 384,946 378,938 370,933 362,932 359,931 297,931 290,933 284,933" type="audio"><p>AHOJ, BUDDY. TO SOM JA. JANE.</p></text-area><text-area bgcolor="#ffffff" points="258,1137 256,1120 267,1109 284,1106 328,1106 349,1118 350,1139 332,1149 274,1151"><p>PRESTAŇ. PROSÍM.</p></text-area><text-area bgcolor="#ffffff" points="315,1274 319,1255 373,1255 384,1258 382,1282 365,1290 326,1285"><p><strong>PRESTAŇ!</strong></p></text-area><text-area bgcolor="#fefdff" points="343,1185 348,1206 361,1219 369,1223 403,1226 480,1226 501,1220 507,1216 517,1204 517,1184 514,1175 504,1165 481,1158 400,1158 378,1158 355,1168 346,1177" type="audio"><p>PODĽA ZÁKONA TENTO PROGRAM NEMÔŽE BYŤ ZRUŠENÝ ANI ZASTAVENÝ.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0014.webp"/>
    <frame points="35,37 516,37 517,480 513,500 500,528 498,559 505,572 504,629 512,654 517,689 520,770 35,765"/><frame points="521,36 576,39 606,16 636,21 664,37 957,37 962,409 762,412 749,392 730,371 701,355 669,354 645,362 630,383 610,412 521,412"/><frame points="521,415 606,417 623,385 644,360 680,345 701,349 728,367 749,387 762,412 961,418 962,754 762,749 747,771 551,769 527,763 516,727 515,688 509,651 502,627 505,572 497,553 499,528 515,497 519,476"/><frame points="5,766 749,771 764,750 956,751 956,735 993,741 992,1168 654,1178 606,1226 450,1194 445,1177 3,1171"/><frame points="2,1174 223,1175 278,1159 282,1171 336,1175 450,1141 461,1160 559,1133 560,1150 709,1125 713,1157 810,1125 821,1146 864,1142 869,1162 921,1163 932,1170 988,1169 991,1261 925,1285 927,1482 83,1487 82,1305 23,1324 24,1291 4,1301"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="81,99 74,77 82,60 103,53 176,53 199,61 204,88 192,106 159,112 99,108" type="audio"><p>BUDDY MÁ NAOZAJ PRAVDU V JEDNEJ VECI.</p></text-area><text-area bgcolor="#ffffff" points="43,200 43,138 61,124 92,115 177,115 210,132 220,165 212,203 193,219 160,227 102,227 62,217" type="audio"><p>SPROUT COMPUTERS V PODSTATE VLASTNÍ VŠETKO, ČO BOLO V SYSTÉME VYTVORENÉ ALEBO DOŇHO NAHRANÉ.</p></text-area><text-area bgcolor="#ffffff" points="66,271 61,255 69,242 104,232 165,232 179,232 206,240 211,264 199,279 172,285 94,285 79,280" type="audio"><p>AVŠAK ZABUDOL NA JEDNU VEC, ...</p></text-area><text-area bgcolor="#ffffff" points="710,87 700,72 703,53 712,47 870,47 880,65 877,82 866,92 807,99 736,98" type="audio"><p>... ŽE SA SPROUT ZAVIAZAL, ŽE NEBUDE NIKDY ZLÝ.</p></text-area><text-area bgcolor="#ffffff" points="803,134 801,117 808,102 848,96 904,96 931,108 934,130 918,146 884,153 829,152" type="audio"><p>MÁ TO VO SVOJOM VEREJNOM PREHLÁSENÍ!</p></text-area><text-area bgcolor="#ffffff" points="778,257 863,257 863,268 777,268" type="sign"><p>7. NEBUĎ ZLÝ.</p></text-area><text-area bgcolor="#ffffff" points="659,314 659,319 661,323 670,331 680,332 724,332 727,330 730,330 736,324 736,312 733,310 728,304 726,303 719,303 718,302 711,302 710,301 706,301 705,300 696,300 687,295 683,295 681,295 681,300 677,303 670,303 668,304"><p><strong>PRESTAŇ!</strong></p></text-area><text-area bgcolor="#ffffff" points="693,663 695,623 716,595 759,583 877,583 920,599 938,633 938,633 938,633 935,673 910,707 858,719 758,719 706,700" type="audio"><p><emphasis>NEMÁŠ SA ČOHO OBÁVAŤ. SI TERAZ SO SVOJIMI PRIATEĽMI.</emphasis></p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0015.webp"/>
    <frame points="36,62 228,62 205,38 213,24 266,63 310,62 320,5 331,2 350,15 352,62 739,60 748,43 786,34 819,39 841,58 895,60 920,50 959,61 983,75 965,198 962,245 35,414 35,195 18,197 17,129 33,113"/><frame points="90,404 961,244 964,713 93,601"/><frame points="33,558 96,566 97,594 923,704 916,844 724,822 670,843 636,832 573,858 566,1081 566,1524 4,1524 3,846 32,846"/><frame points="572,798 963,848 961,1498 562,1495"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="840,1184 840,1193 842,1196 843,1201 851,1209 856,1210 858,1212 908,1212 909,1211 917,1210 926,1202 926,1200 928,1198 928,1185 926,1183 926,1179 920,1173 917,1173 913,1170 907,1170 904,1170 862,1170 860,1170 854,1170 851,1173 848,1174 842,1180"><p>HEJ, BUDDY ...</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0016.webp"/>
    <frame points="3,7 991,7 989,8 992,1048 990,1045 954,1044 953,1031 55,1033 55,1047 4,1046"/><frame points="56,1032 952,1033 955,1466 52,1471"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="494,366 494,377 510,395 533,400 611,400 630,394 642,382 642,367 640,365 638,356 626,346 612,341 584,341 582,341 506,341 498,347 498,357"><p>... SNAŽÍM SA ŤA CELÝ ČAS NÁJSŤ.</p></text-area><text-area bgcolor="#fefefe" points="126,1112 128,1126 133,1135 141,1142 163,1149 195,1151 199,1152 218,1152 222,1151 245,1150 247,1148 269,1145 276,1142 286,1132 288,1126 288,1111 283,1099 278,1094 268,1089 239,1086 186,1086 160,1086 138,1094 129,1103"><p>MOMENT ... VY STE ... VY STE <emphasis>LIZ EVERSOVÁ!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="653,1310 653,1318 657,1332 673,1348 700,1355 794,1355 796,1353 810,1352 826,1346 837,1335 839,1330 839,1308 834,1297 821,1286 806,1281 796,1281 794,1280 724,1280 689,1281 679,1286 674,1286 665,1292 657,1300"><p>NO, TO ÁNO, ALE NEMAJ MI TO TERAZ PRÍLIŠ ZA ZLÉ.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0017.webp"/>
    <frame points="264,323 254,287 183,279 145,237 166,210 212,207 185,133 155,73 174,25 250,11 315,17 353,44 419,43 461,11 555,14 635,5 675,2 741,41 752,62 749,103 818,123 845,173 855,206 837,260 821,307 571,308 520,308 503,320"/><frame points="34,327 482,321 480,489 477,692 35,695"/><frame points="485,338 521,338 527,304 864,305 874,334 941,334 941,463 962,433 990,422 992,520 987,541 957,614 965,672 957,715 479,715 478,487 487,471"/><frame points="70,727 940,724 944,968 68,967"/><frame points="71,969 658,972 659,1235 638,1268 650,1287 658,1313 659,1499 67,1501"/><frame points="659,972 941,973 941,1311 843,1311 863,1332 926,1337 954,1365 978,1385 983,1423 993,1445 962,1504 723,1502 738,1443 697,1405 669,1364 659,1312 651,1283 640,1268 659,1233"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="176,50 178,67 188,78 195,82 211,83 213,84 271,84 277,80 283,78 290,71 292,66 292,51 290,42 282,34 268,29 202,29 199,30 194,30 191,33 186,35 179,42"><p>NECHAJTE MA SAKRA NA POKOJI!</p></text-area><text-area bgcolor="#fefefe" points="454,36 454,47 455,49 465,56 470,56 472,57 542,57 544,55 545,50 548,46 547,37 536,28 470,28 467,29 464,29 458,32"><p>BUDDY ...</p></text-area><text-area bgcolor="#ffffff" points="409,76 409,87 413,94 417,98 420,98 427,102 431,102 434,103 496,103 503,102 510,102 512,100 515,100 520,97 526,91 527,88 527,80 525,73 520,68 512,66 464,65 458,64 446,64 422,65 420,67 416,68"><p>PRACUJETE PRE SPROUT!</p></text-area><text-area bgcolor="#fefefe" points="524,268 521,266 521,263 515,257 505,253 493,251 491,247 483,247 474,250 441,251 424,256 413,267 413,277 426,291 435,293 504,293 508,292 510,290 513,290 524,280"><p><emphasis>PRACOVALA</emphasis> SOM.</p></text-area><text-area bgcolor="#ffffff" points="142,333 253,333 262,346 259,361 237,371 172,371 140,365 132,348"><p>TERAZ SOM <emphasis>S NIMI.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="176,378 218,378 234,377 250,377 254,399 238,413 192,415 176,405 171,393"><p>S KÝM S <emphasis>NIMI?</emphasis></p></text-area><text-area bgcolor="#ffffff" points="268,419 271,401 286,391 358,391 377,400 378,424 352,435 290,433 276,427"><p>S <emphasis>MOS</emphasis> REBELMI.</p></text-area><text-area bgcolor="#ffffff" points="343,482 342,457 347,442 368,435 380,431 382,427 425,427 448,436 456,455 456,481 441,495 406,499 364,497"><p>MOS AKO: <emphasis>MIMO OFICIÁLNEJ SIETE.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="532,312 858,312 864,341 850,369 807,385 646,392 580,386 539,364 528,328"><p>NÁŠ PLÁN JE PRELOMIŤ BEZPEČNOSTNÝ KÓD VŠETKÝCH iOČÍ A ZVEREJNIŤ SLOBODNÝ SYSTÉM, KTORÝ UMOŽNÍ ĽUĎOM POUŽÍVAŤ iOČI BEZ TOHO, ABY BOLI SLEDOVANÍ A MONITOROVANÍ.</p></text-area><text-area bgcolor="#ffffff" points="488,628 488,640 493,654 507,668 531,677 568,680 673,680 713,677 741,666 754,650 752,626 748,618 737,608 706,598 668,596 598,596 538,598 508,607 491,621"><p>AVŠAK MOMENTÁLNE NAJPRV ZLEPŠUJEME SVOJU SCHOPNOSŤ VYUŽÍVAŤ SLEDOVACÍ SYSTÉM SPROUTU NA LOKALIZOVANIE JEHO <emphasis>OBETÍ.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="767,661 770,676 782,688 792,690 853,690 861,687 868,681 873,672 873,660 871,658 870,653 866,648 857,641 842,640 840,638 827,638 821,637 814,637 810,638 800,638 785,641 776,646 772,650"><p>JEDNOU Z OBETÍ SI AJ <emphasis>TY.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="524,963 513,935 524,917 549,905 586,899 716,899 761,904 786,919 795,944 784,965"><p>POSLEDNÉ TRI MESIACE SA ŤA SNAŽILI OCHROMIŤ HYPERSONICKÝM ÚTOKOM.</p></text-area><text-area bgcolor="#ffffff" points="93,979 308,979 320,1004 318,1031 296,1056 246,1066 162,1066 110,1056 83,1030 78,1001"><p>POLOVICA Z ÚTOKOV BOLA NA PODVEDOMIE, ABY TI POŠKODILI SPÁNKOVÝ CYKLUS BEZ TOHO, ABY SI SI TO VŠIMOL.</p></text-area><text-area bgcolor="#ffffff" points="78,1138 80,1095 104,1081 159,1069 251,1069 304,1076 340,1089 352,1112 352,1132 337,1153 303,1161 256,1167 178,1167 118,1162"><p>S TAKOUTO PREDPRÍPRAVOU BY ŤA ICH NOVÉ HOLOGRAFICKÉ GENERÁTORY DOHNALI KOMPLETNE DO ŠIALENSTVA BEHOM TRIDSIATICH ŠIESTICH HODÍN.</p></text-area><text-area bgcolor="#ffffff" points="383,1065 384,1077 386,1082 391,1088 405,1095 415,1095 417,1097 437,1097 441,1098 452,1098 456,1097 468,1097 470,1095 480,1095 482,1093 486,1093 493,1090 499,1084 501,1080 501,1064 499,1060 487,1051 468,1049 411,1049 399,1051 389,1056 385,1060"><p>TERAZ SI ALE SLOBODNÝ.</p></text-area><text-area bgcolor="#ffffff" points="774,1104 766,1092 771,1079 782,1075 824,1075 838,1082 837,1100 824,1105 797,1107"><p>SLOBODNÝ?</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0018.webp"/>
    <frame points="58,38 938,34 941,451 406,451 408,433 72,433 73,454 54,460"/><frame points="72,435 409,430 405,449 587,449 612,469 764,471 865,484 900,529 899,600 884,640 913,683 942,723 938,776 738,780 737,794 732,811 709,816 672,816 638,808 632,792 630,780 534,779 532,792 342,796 335,805 291,1010 69,1016"/><frame points="337,795 533,792 534,783 630,785 645,771 672,767 702,767 725,769 738,778 945,775 944,1079 272,1082 289,1012"/><frame points="57,1045 280,1044 272,1082 946,1076 944,1495 53,1498"/><text-layer lang="sk"><text-area bgcolor="#fefefe" points="431,258 428,250 416,240 414,237 348,237 346,237 337,237 335,239 324,242 320,245 312,255 311,265 315,277 324,287 331,290 347,291 396,291 414,290 417,287 421,287 431,277"><p>VŠETCI STÁŤ! NIKTO SA ANI NEPOHNE!</p></text-area><text-area bgcolor="#ffffff" points="206,469 205,489 207,499 221,516 229,521 236,521 239,524 248,524 251,526 282,526 287,529 305,529 312,526 334,523 346,518 356,509 361,499 361,475 358,466 345,453 323,447 262,447 238,447 219,455"><p>HĽADÁME TIETO DVE PODOZRIVÉ OSOBY. VIDEL ICH NIEKTO?</p></text-area><text-area bgcolor="#ffffff" points="449,455 570,455 575,475 559,489 502,495 461,488 445,473"><p>NIE, PÁN POLICAJT. PREPÁČTE.</p></text-area><text-area bgcolor="#ffffff" points="499,709 489,691 496,679 515,671 571,671 594,677 599,691 590,700 588,713 542,718"><p>A ČO TY TAM?</p></text-area><text-area bgcolor="#ffffff" points="598,724 596,704 611,693 659,693 679,703 679,723 658,733 616,733"><p>EH, NIE, PANE.</p></text-area><text-area bgcolor="#ffffff" points="576,758 574,747 584,739 631,739 643,752 632,765 592,764"><p>HMM.</p></text-area><text-area bgcolor="#ffffff" points="641,803 635,785 647,772 712,772 732,778 733,797 720,812 663,812" type="thought"><p>ČO TO DO PEKLA?</p></text-area><text-area bgcolor="#ffffff" points="682,897 664,877 659,843 671,818 715,819 732,812 742,802 839,802 890,808 914,828 921,872 897,896 849,908 734,911"><p>JEDEN Z MOJICH POSLEDNÝCH PROJEKTOV V SPROUTE BOLO VYTVORENIE PROGRAMU, KTORÝ ZABRÁNI ĽUĎOM NAHRÁVAŤ AUTORSKY CHRÁNENÉ FILMY POMOCOU iOČÍ.</p></text-area><text-area bgcolor="#ffffff" points="545,1076 540,1050 554,1030 591,1016 697,1016 712,1016 753,1026 766,1047 768,1076"><p>NEBOLO ŤAŽKÉ PROGRAM POZMENIŤ TAK, ABY NIKTO NEMOHOL NAHRÁVAŤ <emphasis>MŇA.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="420,1148 410,1125 425,1106 452,1099 528,1099 562,1110 570,1135 556,1150 516,1160 462,1158"><p>PRÁVE TERAZ NÁS NEMÔŽU ANI VIDIEŤ ANI POČUŤ.</p></text-area><text-area bgcolor="#fdfbf7" points="399,1180 399,1184 401,1187 401,1189 407,1196 410,1196 413,1198 424,1199 429,1201 468,1201 480,1198 485,1198 490,1196 498,1188 498,1180 496,1176 490,1170 487,1169 484,1166 474,1166 472,1166 427,1166 425,1166 415,1166 413,1168 408,1169 401,1176"><p>ÚŽASNÉ...</p></text-area><text-area bgcolor="#ffffff" points="500,1222 494,1202 503,1194 508,1187 561,1187 578,1198 578,1218 555,1228 521,1228"><p>MOMENT...</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0019.webp"/>
    <frame points="8,6 992,3 993,1169 2,1169"/><frame points="55,1180 950,1179 948,1498 54,1503"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="313,130 313,136 315,138 316,146 329,158 338,160 340,162 360,162 364,163 378,163 382,162 396,162 409,159 412,156 414,156 422,148 424,142 424,131 422,121 414,113 409,111 404,111 399,110 337,110 334,111 323,114 316,121 315,128"><p>... JE TO EŠTE OVEĽA LEPŠIE.</p></text-area><text-area bgcolor="#ffffff" points="428,1224 428,1228 430,1231 431,1238 444,1250 499,1250 503,1249 511,1249 515,1246 518,1246 526,1238 526,1234 528,1232 528,1228 526,1226 526,1219 519,1212 513,1209 509,1209 506,1208 452,1208 450,1209 443,1209"><p>VEĽMI VTIPNÉ.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0020.webp"/>
    <frame points="55,35 468,33 471,4 484,3 511,9 510,32 947,37 944,289 887,289 883,270 116,273 114,287 57,290"/><frame points="114,272 885,270 884,506 764,506 751,477 731,452 700,440 651,461 628,497 627,505 116,507"/><frame points="60,777 57,551 70,548 76,527 106,509 490,507 531,501 565,517 577,544 607,544 621,511 627,496 650,458 701,439 733,455 754,474 765,507 772,516 771,541 940,543 940,773 919,776 919,813 478,818 472,801 483,773"/><frame points="61,823 939,825 936,1254 57,1258"/><frame points="95,1263 485,1263 485,1493 93,1493"/><frame points="496,1263 896,1260 896,1497 496,1494"/><text-layer lang="sk"><text-area bgcolor="#0a222b" points="71,50 279,50 279,83 70,83" type="commentary" inverted="True"><p><emphasis>O MESIAC NESKÔR.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="612,103 612,118 615,127 633,148 746,148 761,147 778,140 787,131 790,122 790,110 787,99 777,87 766,81 737,79 676,79 650,79 625,87 614,98"><p>LEN MALÉ MNOŽSTVO ĽUDÍ <emphasis>FYZICKY</emphasis> OPUSTILO SIEŤ ...</p></text-area><text-area bgcolor="#ffffff" points="242,275 454,275 459,303 450,331 404,351 304,353 260,341 240,307"><p>... AVŠAK MINIMÁLNE 18 PERCENT POUŽIVATEĽOV iOČÍ TERAZ TRÁVI ASPOŇ ČASŤ SVOJHO ČASU <emphasis>MOS.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="462,276 646,276 652,315 625,330 597,346 579,349 515,348 476,339 464,310"><p>PIRÁTIA HUDBU A FILMY. TO JE PRESNE TAK, AKO SME PREDPOKLADALI. ŽE ÁNO.</p></text-area><text-area bgcolor="#ffffff" points="583,397 574,372 574,351 600,345 646,322 772,322 818,334 833,353 838,381 818,405 780,416 667,419 608,409"><p>A JE TO ZÁROVEŇ POMERNE MÁLÁ ČASŤ POPULÁCIE V POROVNANÍ S TÝM, KOĽKO ĽUDÍ ŠŤAHOVALO PIRÁTSKY OBSAH V MINULOSTI. NIE JE TAK?</p></text-area><text-area bgcolor="#ffffff" points="88,566 78,547 88,533 122,522 216,522 253,530 268,547 259,568 227,575 144,578 107,575"><p>TU IDE O VIAC AKO O <emphasis>PIRÁTSKY</emphasis> OBSAH, PANI PREZIDENTKA.</p></text-area><text-area bgcolor="#ffffff" points="147,640 140,614 154,593 184,582 209,580 330,580 362,590 390,614 388,638 352,659 223,662 174,656"><p>V MINULOSTI ĽUDIA ZAČALI PLATIŤ REÁLNYMI PENIAZMI ZA SLUŽBY VYUŽÍVANÉ VO VIRTUÁLNOM SVETE.</p></text-area><text-area bgcolor="#ffffff" points="362,578 363,555 381,542 413,536 518,536 542,540 560,562 556,600 515,619 417,620 388,610 363,589"><p>TERAZ ĽUDIA MÍŇAJÚ <emphasis>VIRTUÁLNE</emphasis> PENIAZE ZA TOVARY A SLUŽBY Z <emphasis>REÁLNEHO</emphasis> SVETA.</p></text-area><text-area bgcolor="#ffffff" points="407,862 408,868 415,877 431,882 434,885 451,885 455,884 493,884 511,882 519,880 524,877 530,871 531,868 530,860 527,855 523,852 508,848 454,848 423,849 416,852"><p>NEROZUMIEM.</p></text-area><text-area bgcolor="#ffffff" points="456,1125 452,1097 463,1079 504,1063 626,1063 665,1076 674,1097 675,1121 662,1143 614,1158 518,1157 470,1143"><p>ZAČALO TO ONLINE AUKCIAMI. A ĽUDIA NERADI PLATIA DANE. A TAK PRESUNULI AUKCIE DO HERNÉHO SVETA.</p></text-area><text-area bgcolor="#ffffff" points="640,1180 641,1156 674,1141 699,1138 805,1138 853,1149 866,1166 862,1192 824,1210 708,1211 657,1201"><p>PENIAZE SÚ <emphasis>FIKTÍVNE.</emphasis> VYMIEŇAJÚ ALE ZA NE TOVARY Z <emphasis>REÁLNEHO</emphasis> SVETA.</p></text-area><text-area bgcolor="#ffffff" points="319,1272 474,1272 474,1324 440,1335 372,1336 336,1326 318,1301"><p>ZAVOLALI STE MA NA TOTO STRETNUTIE KVÔLI DISKUSII O <emphasis>GARÁŽOVÝCH VÝPREDAJOCH?</emphasis></p></text-area><text-area bgcolor="#ffffff" points="506,1272 649,1272 650,1296 627,1320 574,1324 520,1318 505,1308"><p>ÚPRIMNE SI ŽELÁM, ABY TO BOLO TAKÉ JEDNODUCHÉ.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0021.webp"/>
    <frame points="51,514 44,186 68,93 126,57 303,42 703,46 766,33 865,21 920,28 948,73 952,257 937,313 945,408 935,482 928,510"/><frame points="54,524 946,520 944,1001 56,1003"/><frame points="56,1009 942,1011 941,1504 48,1499"/><text-layer lang="sk"><text-area bgcolor="#f5e6c4" points="308,57 308,106 311,109 592,108 594,100 594,55 590,55 311,55"><p>"S NAŠOU <emphasis>PODPOROU</emphasis> ZAČALA TLAČ OZNAČOVAŤ MOS REBELOV ZA VEĽMI ZLÝ VTIP."</p></text-area><text-area bgcolor="#f3e6c6" points="636,386 637,454 892,454 896,451 896,385 893,385 642,385"><p>"HRÁČI A POČÍTAČOVÍ <emphasis>MANIACI,</emphasis> KTORÍ SA STRETÁVAJÚ VO VYMYSLENÝCH NUDNÝCH VIRTUÁLNYCH SVETOCH."</p></text-area><text-area bgcolor="#f3e8c7" points="109,558 111,626 340,626 339,555 113,555"><p>"JE TO SKVELÁ PRÍLEŽITOSŤ PRE AUTOROV FIKCIÍ, ŽE ÁNO? KAŽDÝ MÔŽE PREŽÍVAŤ SVOJ SEN, POROZPRÁVAŤ SVOJ PRÍBEH ..."</p></text-area><text-area bgcolor="#f2e9cd" points="589,1039 589,1072 592,1076 758,1075 758,1051 760,1049 759,1038 754,1037 593,1037"><p>"... VYTVORIŤ SVOJU VLASTNÚ UTÓPIU ..."</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0022.webp"/>
    <frame points="105,35 241,34 253,17 268,30 718,31 745,22 795,23 801,31 912,33 916,356 102,354"/><frame points="58,360 950,362 947,960 56,950"/><frame points="50,1274 46,1023 111,1027 99,994 106,961 123,950 618,956 651,977 660,1025 687,978 780,960 871,970 898,987 890,1032 949,1037 950,1278"/><frame points="52,1280 948,1284 946,1502 46,1498"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="341,83 342,105 347,112 359,123 376,128 401,129 444,129 473,126 482,122 493,110 495,104 494,82 488,72 483,67 469,61 450,59 404,59 368,60 365,63 356,65 342,79"><p>... AVŠAK TAM ZAČÍNAJÚ PROBLÉMY. NIE JE TAK?</p></text-area><text-area bgcolor="#ffffff" points="294,450 287,421 297,395 329,385 400,385 438,393 452,410 452,439 434,461 373,467 320,464"><p>NAŠA TECHNOLÓGIA JE AŽ <emphasis>PRÍLIŠ</emphasis> DOBRÁ. TIETO VIRTUÁLNE SVETY ...</p></text-area><text-area bgcolor="#ffffff" points="357,500 364,481 379,473 455,473 482,484 486,506 470,520 430,525 385,525 364,517"><p>... NO ... TAKMER <emphasis>FUNGUJÚ.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="384,605 370,572 376,547 411,529 441,526 546,526 586,543 598,572 593,601 551,619 452,622 410,618"><p>VEĽKÁ VÄČŠINA MOS KOMUNITY JE UŽ PRIPRAVENÁ TRÁVIŤ TAKMER <emphasis>CELÝ</emphasis> SVOJ ČAS V TÝCHTO FIKTÍVNYCH SVETOCH.</p></text-area><text-area bgcolor="#ffffff" points="128,953 342,953 358,975 358,1004 334,1026 270,1037 160,1033 122,1011 112,978"><p>FIKTÍVNE ZÁKONY. FIKTÍVNE <emphasis>VLÁDY</emphasis> VYTVORENÉ FILMOVÝMI TVORCAMI, HLUPÁKMI A <emphasis>KRIMINÁLNIKMI</emphasis> ...</p></text-area><text-area bgcolor="#ffffff" points="104,1085 104,1059 126,1045 155,1038 252,1038 282,1047 295,1065 292,1093 264,1111 184,1115 129,1109"><p>... KTORÍ SA CHYSTAJÚ OVLÁDNUŤ <emphasis>ŽIVOTY ĽUDÍ Z REÁLNEHO SVETA!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="699,1033 691,1007 701,989 738,977 830,977 864,987 876,1009 868,1033 838,1045 778,1049 724,1047"><p>POKÚŠALI SME SA PROTI NIM BOJOVAŤ <emphasis>SOFTVÉROM.</emphasis> JE TO ALE STRATENÝ BOJ ...</p></text-area><text-area bgcolor="#ffffff" points="678,1102 669,1081 679,1063 708,1055 794,1055 817,1066 822,1091 808,1109 753,1115 701,1113"><p>... A NAVYŠE POLOVICA NAŠICH ĽUDÍ SA PRIDALA NA ICH STRANU.</p></text-area><text-area bgcolor="#ffffff" points="96,1290 266,1290 264,1312 239,1326 206,1330 142,1330 114,1324 100,1313"><p>PRETO TERAZ PRICHÁDZAME ZA VAMI.</p></text-area><text-area bgcolor="#ffffff" points="117,1382 109,1360 116,1343 142,1336 224,1336 243,1336 261,1349 264,1372 248,1389 201,1394 146,1392"><p>MILIARDY DOLÁROV SÚ V STÁVKE.</p></text-area><text-area bgcolor="#ffffff" points="161,1430 153,1414 163,1404 175,1398 259,1398 282,1404 290,1418 279,1433 232,1439 182,1439"><p>A AJ MILIÓNY ŽIVOTOV.</p></text-area><text-area bgcolor="#ffffff" points="755,1347 758,1366 765,1374 789,1384 808,1384 814,1385 829,1385 849,1384 882,1384 893,1381 900,1377 904,1377 915,1366 916,1353 913,1342 907,1336 891,1329 882,1329 870,1328 791,1328 766,1335"><p>ROZUMIETE TOMU, SLEČNA TANAKAOVÁ?</p></text-area></text-layer></page>
    <page>
      <image href="Issue 02/image_0023.webp"/>
    <frame points="93,568 79,516 33,487 23,363 60,355 86,323 87,266 70,222 79,178 114,152 143,143 146,56 183,29 283,30 303,59 873,64 875,172 905,206 924,234 941,250 923,298 890,309 881,335 886,375 905,356 933,334 960,303 970,305 968,569 894,571"/><frame points="79,590 919,590 920,780 81,779"/><frame points="39,757 81,778 957,780 956,1494 44,1492"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="178,61 177,76 178,81 180,83 181,90 189,98 199,102 227,105 232,107 246,107 249,105 267,102 279,97 287,86 286,61 279,52 267,47 198,47 193,49 190,49"><p>VOLAJTE MA JANE, PÁN CHAVEZ.</p></text-area><text-area bgcolor="#ffffff" points="502,382 497,365 507,357 562,357 577,367 562,383 526,387"><p>JANE.</p></text-area><text-area bgcolor="#ffffff" points="521,453 517,421 528,400 562,388 687,388 725,404 736,438 720,469 675,479 593,482 544,474"><p>POVEDANÉ LEGUINANSKOU TERMINOLÓGIOU ... VY STE NÁŠ JEDINÝ <emphasis>ÚSPEŠNÝ TVORCA SNOV,</emphasis> KTORÉHO MÁME.</p></text-area><text-area bgcolor="#ffffff" points="591,651 592,673 609,691 626,698 656,701 721,701 759,698 779,691 793,676 793,655 784,639 775,633 755,629 748,628 638,628 604,637"><p>DOKÁŽETE VSTÚPIŤ DO TÝCHTO VIRTUÁLNYCH SVETOV A <emphasis>ZMENIŤ</emphasis> ICH ZVNÚTRA.</p></text-area><text-area bgcolor="#ffffff" points="559,733 569,734 580,741 586,741 588,743 643,743 670,741 681,730 681,719 671,709 636,708 631,707 596,707 578,708 569,713 564,719 563,727 559,729"><p><emphasis>ZMENIŤ ICH?</emphasis></p></text-area><text-area bgcolor="#fffffd" points="533,1114 533,1130 537,1138 546,1147 554,1151 584,1154 590,1157 606,1157 611,1154 632,1153 648,1149 660,1139 663,1133 663,1121 660,1110 646,1098 634,1096 613,1096 567,1096 546,1101"><p>NEMYSLÍTE SKÔR <emphasis>ZNIČIŤ</emphasis> ICH?</p></text-area><text-area bgcolor="#efe5c4" points="742,1455 742,1481 751,1484 930,1485 932,1483 939,1483 939,1455 744,1455" type="commentary"><p><emphasis>POKRAČOVANIE NABUDÚCE!</emphasis></p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0000.webp"/>
	  <title lang="en">Issue 03</title><title lang="sk">Časť 3.</title>
    <text-layer lang="sk"><text-area bgcolor="#0e0e0e" points="714,83 880,69 884,105 716,120" text-rotation="5" type="heading" inverted="True"><p>ČASŤ TRETIA (Z TROCH)</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0002.webp"/>
    <frame points="33,32 960,35 961,533 33,535"/><frame points="34,544 444,543 394,1070 33,1072"/><frame points="454,543 960,545 960,881 423,837"/><frame points="423,842 956,883 958,1107 393,1112"/><frame points="35,1123 956,1116 959,1499 34,1499"/><text-layer lang="sk"><text-area bgcolor="#1a1a1a" points="39,43 383,43 383,81 39,81" type="commentary" inverted="True"><p><emphasis>CARROLL GARDENS, BROOKLYN.</emphasis></p></text-area><text-area bgcolor="#fffdfc" points="310,121 313,133 325,145 334,149 371,152 433,152 468,149 484,142 489,137 491,131 489,115 482,108 471,103 460,102 457,100 443,100 441,100 381,100 344,100 321,108 315,113"><p>V PORIADKU, SLEČNA EVERSOVÁ. NA KOHO ČAKÁME?</p></text-area><text-area bgcolor="#ffffff" points="160,381 140,371 133,357 138,340 168,330 254,330 279,335 290,346 294,362 276,375 233,382"><p>VRAVÍM TI TO POSLEDNÝKRÁT, BUDDY. VOLAJ MA LIZ.</p></text-area><text-area bgcolor="#ffffff" points="107,421 107,402 125,389 144,387 234,387 258,399 263,419 248,435 213,443 138,441 117,433"><p>A DOZVIEŠ SA TO HNEĎ, AKO ICH UVIDÍŠ.</p></text-area><text-area bgcolor="#ffffff" points="177,606 178,617 186,626 202,630 211,630 216,634 228,634 232,631 235,630 249,630 250,629 260,628 269,623 274,617 274,608 272,603 264,596 261,596 259,596 198,596 192,596 187,596"><p>V PORIADKU.</p></text-area><text-area bgcolor="#ffffff" points="212,934 212,962 217,968 220,969 344,970 355,968 358,965 359,934 358,931 353,928 221,928 217,928" type="code"><p>AKTIVUJE SA MODIFIKÁCIA SVET ORKOV ...</p></text-area><text-area bgcolor="#ffffff" points="592,551 755,551 764,577 754,600 720,612 657,616 613,609 587,592 582,566"><p>UMMM. PEKNE VÁS VÍTAM, CTENÍ GOBLINI. DLHO SME HĽADALI ...</p></text-area><text-area bgcolor="#ffffff" points="720,627 720,640 722,644 722,647 728,654 730,654 732,657 742,658 744,659 793,659 795,656 799,656 808,648 811,638 811,632 809,630 809,627 807,624 796,614 785,613 751,613 746,614 743,614 741,616 738,616 736,618 730,618 728,619"><p>SKRÁŤ TO, MLADÝ.</p></text-area><text-area bgcolor="#ffffff" points="747,950 734,930 738,903 766,887 792,881 844,881 912,888 930,903 934,931 919,951 892,961 838,966 778,962"><p>ROBÍME TO LEN PRE PRACHY. A ORKSKÁ BANKA NÁM ZA TO PLATÍ NAJLEPŠIE.</p></text-area><text-area bgcolor="#ffffff" points="832,998 830,981 839,969 904,969 914,980 915,996 903,1007 850,1010"><p>VOLAJ MA CHUCK.</p></text-area><text-area bgcolor="#ffffff" points="282,1211 282,1218 285,1225 297,1236 312,1238 366,1238 372,1237 381,1237 384,1234 387,1234 395,1225 394,1208 385,1199 380,1196 375,1196 372,1196 306,1196 299,1198 290,1201"><p>PREJDIME ALE K VECI.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0003.webp"/>
    <frame points="25,34 969,31 968,520 942,523 916,501 888,494 861,489 836,503 818,522 30,518"/><frame points="32,527 351,526 357,1499 32,1498"/><frame points="352,526 463,527 496,512 531,516 555,526 809,526 822,517 844,499 863,490 896,493 917,502 944,520 970,528 971,848 355,849"/><frame points="357,853 968,856 970,1179 779,1182 768,1171 750,1161 687,1161 652,1157 634,1155 597,1162 580,1168 565,1180 356,1179"/><frame points="358,1499 357,1183 561,1181 573,1168 606,1158 644,1155 690,1161 748,1161 769,1169 779,1181 968,1181 969,1501"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="76,43 424,43 426,73 410,100 366,119 284,125 168,122 107,107 80,79"><p>HACKOVANIE iOČÍ JE NAŠE ŽIVOBYTIE. POMÁHAME ĽUĎOM UŠETRIŤ PÁR DROBNÝCH A UPRAVUJEME IM SOFTVÉR, ABY MOHOL BEŽAŤ AJ NA HARVÉRI, KTORÝ NEPATRÍ SPROUTU.</p></text-area><text-area bgcolor="#ffffff" points="384,170 384,175 385,176 385,178 390,184 398,188 416,189 417,190 417,192 426,192 431,188 437,188 441,186 444,186 451,179 452,177 452,169 447,164 447,163 443,161 440,161 397,161 394,161 390,162 386,166"><p>PEKNE.</p></text-area><text-area bgcolor="#ffffff" points="470,169 466,145 480,132 498,127 551,127 573,137 574,163 559,178 524,183 488,182"><p>KOĽKO TOHO POTREBUJETE?</p></text-area><text-area bgcolor="#ffffff" points="425,392 419,379 426,367 484,367 497,377 490,391 456,395"><p>NIČ.</p></text-area><text-area bgcolor="#ffffff" points="366,431 362,419 377,411 439,411 458,417 455,433 409,440"><p>PARDÓN?</p></text-area><text-area bgcolor="#ffffff" points="456,472 443,448 460,437 466,416 520,404 622,404 671,412 696,429 700,459 676,479 605,487 501,486"><p>SPROUT PRÍDE S MILIÓNOM NOVÝCH MODIFIKÁCIÍ V MARCI A CENY PADNÚ OKAMŽITE NADOL.</p></text-area><text-area bgcolor="#ffffff" points="76,539 242,539 258,559 255,593 224,611 166,618 94,614 64,597 58,559"><p>POČULI SME O TÝCH REČIACH. NEVERÍME TOMU. NEDOKÁZALI BY NIČ ZAROBIŤ PRI TAK NÍZKYCH CENÁCH.</p></text-area><text-area bgcolor="#ffffff" points="109,690 104,665 109,642 141,622 209,622 236,618 294,618 325,633 336,654 336,683 320,703 281,715 186,717 133,707"><p>TO ANI NEPOTREBUJÚ. DOSTÁVAJÚ MASÍVNE VLÁDNE DOTÁCIE. ICH CIEĽOM JE, ABY KAŽDÝ NA PLANÉTE BOL PRIPOJENÝ DO ICH SYSTÉMU.</p></text-area><text-area bgcolor="#ffffff" points="592,538 775,538 787,555 787,582 763,597 722,602 640,601 594,591 577,571 580,550"><p>CHCELI STE SA STRETNÚŤ, ABY STE NÁM POVEDALI, ŽE NÁŠ BIZNIS MODEL JE NANIČ?</p></text-area><text-area bgcolor="#ffffff" points="688,656 678,638 677,621 688,607 736,607 774,607 786,627 783,648 760,657 717,659"><p>VYZERÁM AŽ TAK PRIATEĽSKY?</p></text-area><text-area bgcolor="#ffffff" points="625,694 616,687 612,666 626,655 676,655 692,662 704,676 694,692 658,696"><p>TAK POKRAČUJ.</p></text-area><text-area bgcolor="#ffffff" points="674,747 655,726 660,702 690,702 710,687 814,687 856,697 870,716 862,740 832,749 769,756 711,753"><p>PRIPRAVUJÚ UPGRADE FIRMVÉRU, KTORÝ MÁ ZABRÁNIŤ PRENIKNUTIU DO SYSTÉMU.</p></text-area><text-area bgcolor="#ffffff" points="556,810 544,784 557,762 584,751 666,751 688,757 712,762 720,785 714,808 680,818 604,824"><p>NEVERÍM, ŽE BY NIEČO TAKÉ DOKÁZALO ZASTAVIŤ ĽUDÍ AKO STE VY.</p></text-area><text-area bgcolor="#ffffff" points="396,867 564,867 578,897 570,937 538,958 464,959 411,955 386,932 381,890"><p>TO ANI NEZASTAVÍ. PRITIAHNE TO ALE ĽUDÍ, KTORÍ SÚ MOMENTÁLNE <emphasis>MIMO</emphasis> SIETE SPÄŤ <emphasis>DO NEJ.</emphasis></p></text-area><text-area bgcolor="#fffdfe" points="601,1101 601,1115 606,1127 618,1141 640,1151 664,1154 766,1154 794,1153 822,1144 838,1129 840,1123 838,1100 829,1085 817,1077 805,1073 777,1070 686,1070 655,1070 621,1080"><p>ALE LEN AK SA NEDÁME DOKOPY S NIEKÝM AKO VY A NEPRIPRAVÍME DO DVOCH MESIACOV RIEŠENIE, KTORÉ TOMU ZABRÁNI.</p></text-area><text-area bgcolor="#ffffff" points="580,1216 568,1194 573,1175 594,1162 670,1162 749,1162 771,1174 776,1197 760,1216 714,1225 612,1224"><p>HA. TAKŽE PLÁNY PRE PROTOKOL NA MIMOSIEŤOVÚ KOMUNIKÁCIU?</p></text-area><text-area bgcolor="#ffffff" points="642,1277 642,1284 649,1303 661,1314 669,1315 675,1318 723,1318 750,1317 770,1310 775,1305 775,1299 777,1296 777,1280 771,1264 759,1255 754,1255 752,1253 743,1252 702,1252 669,1253 655,1259 647,1267"><p>BUDEME POTREBOVAŤ, ABY STE NÁM TO NAHRALI NA SERVER.</p></text-area><text-area bgcolor="#ffffff" points="373,1408 375,1421 386,1433 389,1433 393,1436 397,1436 399,1438 409,1438 414,1439 446,1439 482,1438 484,1436 490,1436 494,1433 497,1433 507,1423 507,1404 504,1398 496,1391 488,1389 484,1387 418,1387 394,1388 383,1393 376,1400"><p>DOHODNIME SA ALE NAJSKÔR NA CENE.</p></text-area><text-area bgcolor="#fefefe" points="561,1447 561,1454 563,1457 564,1464 574,1475 577,1477 586,1479 612,1480 634,1480 659,1479 661,1477 668,1476 678,1468 680,1465 682,1455 680,1442 671,1432 665,1429 659,1428 657,1426 643,1426 641,1426 600,1426 598,1426 588,1426 571,1433 564,1440"><p>OUKEJ. OBJEDNÁME SI VIACEJ PIVA.</p></text-area><text-area bgcolor="#ffffff" points="826,1440 816,1422 832,1406 894,1406 912,1419 903,1440 866,1444"><p><strong>VY ZODEJI ...</strong></p></text-area></text-layer></page>
    <page>
      <image href="Issue 03/image_0004.webp"/>
