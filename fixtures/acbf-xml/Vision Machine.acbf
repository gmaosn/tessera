	<text-layer lang="sk"><text-area bgcolor="#000000" points="298,42 395,42 395,72 297,72" inverted="True" type="commentary"><p>Scenár</p></text-area><text-area bgcolor="#000000" points="299,97 389,97 389,127 299,127" inverted="True" type="commentary"><p>Kresba</p></text-area><text-area bgcolor="#000000" points="301,153 418,153 418,181 301,181" inverted="True" type="commentary"><p>Kontúry časť 1</p></text-area><text-area bgcolor="#000000" points="300,183 386,183 386,212 299,212" inverted="True" type="commentary"><p>Asistencia</p></text-area><text-area bgcolor="#000000" points="299,236 451,236 451,265 300,265" inverted="True" type="commentary"><p>Kontúry časť 2 a 3</p></text-area><text-area bgcolor="#000000" points="299,294 380,294 380,320 299,320" type="commentary" inverted="True"><p>Farby</p></text-area><text-area bgcolor="#000000" points="298,322 385,322 385,350 300,350" type="commentary" inverted="True"><p>Asistencia</p></text-area><text-area bgcolor="#000000" points="303,380 393,380 393,409 303,409" type="commentary" inverted="True"><p>Lettering</p></text-area><text-area bgcolor="#000000" points="301,435 426,435 426,463 301,463" type="commentary" inverted="True"><p>Dizajn postáv</p></text-area><text-area bgcolor="#000000" points="300,469 335,469 335,488 300,488" type="commentary" inverted="True"><p>a</p></text-area><text-area bgcolor="#000000" points="299,516 389,516 389,543 300,543" type="commentary" inverted="True"><p>Produkcia</p></text-area><text-area bgcolor="#000000" points="300,576 453,576 453,601 301,601" type="commentary" inverted="True"><p>Asistent produkcie</p></text-area><text-area bgcolor="#000000" points="301,634 411,634 411,664 299,664" type="commentary" inverted="True"><p>Dizajn knihy</p></text-area><text-area bgcolor="#000000" points="29,764 259,764 259,795 29,795" type="commentary" inverted="True"><p><strong>PORADCOVIA</strong></p></text-area><text-area bgcolor="#000000" points="153,1002 720,1002 720,1027 153,1027" inverted="True"><p>Táto publikácia vznikla vďaka podpore Fordovej nadácie.</p></text-area></text-layer><frame points="281,27 890,27 890,694 283,694"/><frame points="15,752 871,752 871,1344 21,1344"/><frame points="1,1 890,1 890,1369 1,1369"/></page>
    <page>
      <image href="Issue 01/image_0000.webp"/>
	  <title lang="en">Issue 01</title><title lang="sk">Časť 1.</title>
    <text-layer lang="sk"><text-area bgcolor="#020202" points="710,78 846,65 850,103 714,116" type="heading" text-rotation="6" inverted="True"><p>ČASŤ PRVÁ</p><p>(Z TROCH)</p></text-area></text-layer></page>
    <page>
      <image href="Issue 01/image_0002.webp"/>
    <frame points="31,54 198,52 232,33 276,30 310,52 964,46 965,662 34,666 34,465 17,468 5,467 1,299 30,272" bgcolor="#e3caae"/><frame points="68,1005 923,999 921,955 896,909 906,855 916,804 909,739 869,691 773,680 740,678 703,663 346,661 264,671 59,669" bgcolor="#eed8b9"/><frame points="29,1010 964,1002 962,1497 31,1496" bgcolor="#e8cdaf"/><text-layer lang="sk"><text-area bgcolor="#554d2f" points="436,71 916,71 916,85 902,185 449,186" type="heading" inverted="True"><p>VIZIONÁR</p></text-area><text-area bgcolor="#f8f0b3" points="72,77 155,77 155,109 69,109" type="commentary"><p>HĽA ...</p></text-area><text-area bgcolor="#f8f0b3" points="399,195 605,195 605,270 401,270 385,234"><p><emphasis>SUPERMODERNÝ</emphasis> DOBRODRUH V KOSTÝME SO SCHOPNOSŤOU VIDIEŤ <emphasis>HOCIČO</emphasis> A <emphasis>VŠETKO...</emphasis></p></text-area><text-area bgcolor="#ffffff" points="368,414 369,426 381,440 395,450 419,455 465,455 470,452 477,452 505,444 518,431 517,415 504,391 489,379 482,378 478,375 466,375 451,371 426,371 422,373 412,378 399,378 391,381 374,399"><p>POČKAJTE ... NA DRUHEJ STRANE MESTA ... SA PRÁVE DEJE <emphasis>ZLOČIN!</emphasis></p></text-area><text-area bgcolor="#fefefe" points="629,456 626,451 626,448 615,437 607,435 600,434 534,434 526,437 521,446 508,453 502,459 501,464 510,473 517,473 518,477 521,478 524,482 531,483 533,485 607,485 609,483 613,483 616,480 619,480 629,471"><p>POZRI VIZ, LEN PRETO, ŽE NIEČO <emphasis>POVIEŠ...</emphasis></p></text-area><text-area bgcolor="#ffffff" points="410,532 410,537 415,546 429,560 435,561 441,565 522,565 539,566 564,566 586,561 598,550 600,545 600,534 597,527 584,515 570,509 527,507 453,507 426,516"><p>JA <emphasis>NEHOVORÍM</emphasis> LEN TAK NIEČO, DETEKTÍV CARMICHEL ... JA TO <emphasis>VIEM!</emphasis></p></text-area><text-area bgcolor="#f8f0b3" points="69,680 70,728 246,728 246,679 241,678 76,678" type="commentary"><p>... A SCHOPNÝ TÚ ZNALOSŤ OKAMŽITE ODOVZDAŤ HOCIKOMU, KOHO STRETNE!</p></text-area><text-area bgcolor="#ffffff" points="455,843 466,828 486,817 523,817 543,833 539,858 508,872 479,870 461,859"><p>A TERAZ TO VIETE AJ <emphasis>VY!</emphasis></p></text-area><text-area bgcolor="#ffffff" points="513,921 513,928 517,935 519,942 523,946 536,951 592,951 594,950 600,950 607,945 613,937 613,922 611,920 609,914 606,911 592,906 537,906 522,911"><p><strong>ÓÓUÁ!</strong></p></text-area><text-area bgcolor="#ffffff" points="552,1077 552,1093 554,1095 554,1101 566,1114 574,1116 579,1120 597,1121 599,1123 676,1124 681,1124 685,1121 693,1120 708,1114 719,1103 720,1099 719,1075 711,1064 693,1055 663,1055 591,1055 563,1063 554,1072"><p>NEBOLO BY FAJN, KEBY BOLO VŠETKO TAKÉ JEDNODUCHÉ?</p></text-area></text-layer></page>
    <page>
      <image href="Issue 01/image_0003.webp"/>
    <frame points="41,70 492,74 561,39 633,26 716,52 776,101 807,181 804,246 882,385 886,490 174,499 176,421 68,331 41,123"/><frame points="30,500 965,489 963,882 31,889"/><frame points="49,885 947,879 950,1498 48,1501"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="51,116 237,116 237,84 49,84" type="commentary"><p><emphasis>SAN FRANCISCO.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="73,296 73,305 76,311 83,318 86,318 88,321 100,323 102,325 119,326 176,326 177,323 185,319 194,310 194,307 196,305 195,291 187,283 176,277 168,276 163,274 117,274 105,274 102,276 94,276 84,282 76,290"><p>A MOŽNO TO UŽ AJ TAKÉ <emphasis>JE.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="394,392 875,392 875,430 393,430" type="heading"><p>LIZ EVERSOVÁ, RIADITEĽKA SPROUTU</p></text-area><text-area bgcolor="#ffffff" points="394,441 874,441 874,470 393,470" type="heading"><p>KĽÚČOVÝ PREJAV NA SPROUTVILLE EXPO 2061</p></text-area><text-area bgcolor="#ffffff" points="472,560 470,578 472,588 477,599 485,607 492,611 500,612 503,614 511,614 515,617 531,617 536,616 564,616 591,609 602,598 604,593 604,568 601,556 590,545 575,540 522,540 494,541 488,546 483,547"><p>PRETOŽE TU NA VÝSTAVE SPROUTVILLE EXPO 2061 ...</p></text-area><text-area bgcolor="#2f2f2f" points="53,909 240,909 240,944 51,944" type="commentary" inverted="True"><p><emphasis>MESTO NEW YORK.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="366,944 366,959 374,970 386,979 393,979 397,982 405,982 407,984 521,984 552,975 561,966 562,951 559,941 551,933 529,925 508,924 505,924 437,924 399,925 375,934" type="audio"><p>... SA BLÍŽIME K "VYVRCHOLENIU NÁŠHO VEČERA".</p></text-area><text-area bgcolor="#ffffff" points="176,1117 179,1142 195,1158 225,1170 247,1172 254,1174 306,1174 349,1171 381,1159 398,1142 401,1133 401,1115 398,1106 383,1089 364,1080 336,1075 275,1075 235,1075 222,1080 213,1080 196,1089 179,1107"><p>V PORIADKU. POTREBUJEM NEJAKÉ ZÁBERY ZČERENEJ VODY S ČO NAJVIAC NEÓNOVÝMI ODRAZMI V NEJ ...</p></text-area><text-area bgcolor="#ffffff" points="563,1181 565,1198 571,1206 582,1216 604,1222 627,1222 630,1223 649,1223 719,1222 740,1217 749,1212 757,1204 759,1199 759,1180 755,1171 748,1164 738,1158 698,1154 606,1154 593,1158 587,1158 577,1163 565,1175"><p>HEJ, JANE! POZRI NA TÚ VEĽKÚ OBRAZOVKU! SPROUTVILLE EXPO!</p></text-area><text-area bgcolor="#ffffff" points="446,1447 458,1428 490,1415 510,1413 626,1413 658,1428 669,1450 670,1477 658,1489 461,1488 447,1472"><p>ALE CHOĎ, BUDDY. MY SME LEN <emphasis>CHUDOBNÍ ABSOLVENTI,</emphasis> JASNÉ? NEMÔŽME SI DOVOLIŤ NIČ, ČO ONI PREDÁVAJÚ.</p></text-area></text-layer></page>
    <page>
      <image href="Issue 01/image_0004.webp"/>
    <frame points="38,55 342,56 343,893 36,898"/><frame points="344,58 645,54 649,891 344,890"/><frame points="647,55 958,53 963,890 649,890"/><frame points="36,964 110,967 149,931 225,921 254,949 268,961 270,925 301,899 358,890 429,896 464,905 471,948 515,911 561,912 613,934 629,952 681,959 684,933 728,931 728,952 799,945 853,954 963,955 961,1420 906,1496 131,1499 103,1427 35,1427"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="74,68 201,68 206,92 202,122 153,140 100,137 72,121 65,92"><p>ALE SME PLNE SCHOPNÍ PO NIEČOM TAKOM <emphasis>TÚŽIŤ.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="152,147 167,135 204,127 282,127 311,135 321,153 315,180 279,189 206,191 168,185 152,171"><p>ČO MYSLÍŠ, ŽE SA CHYSTAJÚ OZNÁMIŤ?</p></text-area><text-area bgcolor="#ffffff" points="508,113 509,128 522,139 526,139 528,141 532,142 571,142 593,141 595,139 603,137 610,130 611,126 610,109 599,99 590,99 588,97 583,97 576,97 541,97 538,97 532,97 530,99 523,99 516,102 511,107 510,111"><p>NETUŠÍM. PRILBY?</p></text-area><text-area bgcolor="#ffffff" points="447,498 447,503 451,514 459,522 465,522 467,524 474,524 477,525 522,525 524,524 533,524 535,522 541,521 551,510 551,494 544,485 535,482 473,482 456,485 449,492"><p>NIE. JETPACKY!</p></text-area><text-area bgcolor="#ffffff" points="535,535 535,540 539,545 541,545 545,549 567,550 597,550 598,549 601,549 607,546 609,546 613,542 613,527 606,520 604,520 603,519 600,519 595,518 558,518 553,524 551,524 547,528 538,532"><p>PEKNE.</p></text-area><text-area bgcolor="#ffffff" points="472,603 472,614 476,626 486,636 495,640 500,640 502,642 559,642 580,636 589,627 589,623 591,621 591,608 589,606 588,595 580,587 575,586 573,584 565,583 563,582 501,582 497,584 493,584 491,586 486,587 475,598"><p>OUKEJ, CHLAPCI. SÚSTREĎTE SA.</p></text-area><text-area bgcolor="#ffffff" points="706,116 707,131 711,136 713,142 722,151 728,153 732,157 751,158 802,158 818,157 832,150 840,142 843,134 843,119 841,109 836,100 826,92 818,91 816,89 809,89 807,88 745,88 743,89 734,89 720,95 709,106"><p>ČO TY, JANE? ČO TY SI PRAJEŠ?</p></text-area><text-area bgcolor="#ffffff" points="839,158 848,144 852,132 921,132 938,140 939,163 924,172 849,171"><p>JA? NIE VEĽA.</p></text-area><text-area bgcolor="#ffffff" points="796,205 806,184 842,174 930,174 951,189 950,240 926,256 859,261 814,252 797,230"><p>LEN MILIARDU DOLÁROV NA NATOČENIE FILMU, ČO NOSÍM V HLAVE.</p></text-area><text-area bgcolor="#ffffff" points="280,935 278,960 280,978 285,992 306,1013 318,1015 326,1019 394,1019 424,1017 443,1008 457,993 462,980 462,948 457,926 442,911 420,903 408,903 406,903 337,903 332,903 320,903 297,914 285,926"><p>ÁLE. MÁŠ TU PREDSA MULTIDEF ŠPIONÁŽNU KAMERU A DOMA V LABÁKU ŠTÚDIOVÝ STROJ NA FILMOVÉ EFEKTY.</p></text-area><text-area bgcolor="#ffffff" points="289,1206 290,1225 297,1243 311,1257 345,1265 421,1265 443,1264 467,1254 478,1243 483,1233 481,1197 470,1183 458,1174 424,1168 339,1168 330,1171 310,1177 294,1192"><p>DOKÁŽEME SPRAVIŤ HOCIJAKÝ FILM, O KTOROM <emphasis>SNÍVAŠ.</emphasis> ČO NÁS NIČÍ JE <emphasis>DISTRIBÚCIA.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="489,1279 489,1291 494,1304 509,1316 514,1316 529,1320 611,1320 630,1315 644,1302 646,1297 646,1288 643,1275 630,1263 617,1261 610,1259 524,1259 522,1260 515,1260 511,1263 503,1265"><p>TY NEMÁŠ ANI PÁRU, ČO JE V MOJICH SNOCH.</p></text-area><text-area bgcolor="#fffffb" points="713,1299 713,1303 715,1305 716,1309 720,1313 724,1314 728,1317 785,1317 786,1316 789,1316 791,1314 794,1314 798,1311 798,1297 792,1292 786,1291 782,1290 732,1290 728,1291 720,1292 716,1295"><p>AAÚÚ!</p></text-area></text-layer></page>
    <page>
      <image href="Issue 01/image_0005.webp"/>
    <frame points="48,46 495,45 495,414 46,417"/><frame points="496,43 966,43 966,411 498,413"/><frame points="53,423 945,420 946,763 53,770"/><frame points="29,776 567,773 564,1036 27,1140"/><frame points="596,766 978,758 992,814 984,861 953,887 905,977 678,1021 623,925 588,892 599,842"/><frame points="27,1138 359,1078 361,1487 28,1488"/><frame points="359,1075 964,963 966,1485 362,1488"/><text-layer lang="sk"><text-area bgcolor="#ffffff" points="261,62 269,53 284,49 330,49 354,55 358,75 340,87 291,89 265,81"><p>NO ... JA ... ECH ...</p></text-area><text-area bgcolor="#ffffff" points="271,137 266,115 276,100 295,95 374,95 395,104 399,127 388,142 352,149 304,150 285,147"><p>... NEVADILO BY MI DOZVEDIEŤ SA TO ...</p></text-area><text-area bgcolor="#ffffff" points="768,104 768,111 770,114 770,116 775,119 777,124 781,125 787,125 795,124 832,124 834,122 838,122 844,119 846,119 847,117 850,115 850,105 839,95 821,95 790,95 789,95 780,95 778,97 775,97 771,100"><p>SLIZÁK.</p></text-area><text-area bgcolor="#ffffff" points="828,183 844,175 884,175 896,185 886,199 837,198"><p>UFF...</p></text-area><text-area bgcolor="#ffffff" points="312,429 460,429 462,452 445,470 412,476 352,474 326,466 313,449"><p>V ČO DÚFAŠ TY, DAVE?</p></text-area><text-area bgcolor="#ffffff" points="208,685 211,660 228,643 252,637 316,637 345,650 353,682 340,699 310,718 252,719 222,708"><p>KAŽDÝ ROK PRÍDU S NEJAKÝM NOVÝM KOMUNIKAČNÝM ZARIADENÍM ...</p></text-area><text-area bgcolor="#ffffff" points="313,728 325,712 347,694 358,688 440,688 472,701 472,749 459,760 337,762 320,748"><p>... KTORÉ V PODSTATE <emphasis>NEDOVOLÍ</emphasis> NIKOMU KOMUNIKOVAŤ S ĽUDMI NAVÔKOL.</p></text-area><text-area bgcolor="#ffffff" points="476,704 495,690 524,685 596,685 631,693 643,708 647,734 633,760 491,760 478,748"><p>CHCEM NEJAKÝ MAGICKÝ PRÍSTROJ, KTORÝ SKUTOČNE DOKÁŽE DAŤ ĽUDÍ DOKOPY V <emphasis>REÁLNOM</emphasis> SVETE.</p></text-area><text-area bgcolor="#ffffff" points="178,801 180,814 189,827 203,834 225,835 267,835 303,834 307,831 315,829 322,822 324,809 323,799 320,793 315,788 302,786 199,786 188,789"><p>ČLOVEČE, MÔJ <emphasis>VANKÚŠ</emphasis> POTREBUJE VANKÚŠ.</p></text-area><text-area bgcolor="#fdffff" points="246,995 246,1002 248,1004 249,1010 254,1020 260,1026 270,1031 296,1034 335,1034 364,1031 373,1027 382,1018 385,1010 385,992 383,990 382,982 378,977 367,970 347,967 345,967 297,967 271,969 258,975 249,985"><p>OUKEJ, TY INTELIGENT. ČO <emphasis>TY</emphasis> CHCEŠ?</p></text-area><text-area bgcolor="#ffffff" points="802,766 974,766 982,809 978,843 956,869 914,879 862,880 825,871 803,846 794,806"><p>JA CHCEM TAJNÚ ZBRAŇ, POMOCOU KTOREJ DOKÁŽEM ZNIČIŤ ZLÉ SVEDOMIE MÁS ĽUDÍ A ZMENIŤ SPOLOČENSKÉ ZRIADENIE.</p></text-area><text-area bgcolor="#ffffff" points="138,1148 147,1132 176,1125 263,1125 292,1136 294,1160 272,1172 222,1176 176,1174 148,1166"><p>A REALISTICKEJŠIE PORNO.</p></text-area><text-area bgcolor="#ffffff" points="147,1187 162,1179 187,1182 195,1190 189,1203 154,1204"><p>Ech.</p></text-area><text-area bgcolor="#ffffff" points="140,1429 141,1440 147,1452 153,1458 166,1464 191,1466 267,1466 293,1459 305,1446 305,1430 299,1414 288,1406 263,1403 180,1403 175,1403 168,1403 164,1406 160,1406 151,1411 142,1420"><p>TERAZ VIEŠ, ČO JE V SNOCH NÁS <emphasis>OSTATNÝCH.</emphasis></p></text-area><text-area bgcolor="#ffffff" points="578,1067 580,1088 594,1103 605,1106 623,1108 676,1108 678,1106 688,1106 702,1100 712,1089 712,1068 710,1059 699,1049 692,1046 687,1046 682,1044 610,1044 593,1049 581,1060"><p>OUKEJ. BUĎTE VŠETCI TICHO. TERAZ TO PRÍDE ...</p></text-area><text-area bgcolor="#ffffff" points="831,1104 831,1108 836,1115 841,1119 849,1120 908,1120 914,1118 920,1111 920,1106 919,1105 918,1099 914,1095 912,1094 901,1094 857,1094 848,1094 843,1094 837,1097"><p>SÚ TU ...</p></text-area></text-layer></page>
    <page>
      <image href="Issue 01/image_0006.webp"/>
    <frame points="36,39 961,34 962,284 38,288"/><frame points="64,554 73,484 151,432 149,299 165,254 229,217 282,231 315,277 328,315 475,317 480,288 480,253 514,226 554,231 574,241 596,269 559,312 820,312 823,352 909,351 909,456 822,459 820,505 556,505 527,526 531,550"/><frame points="41,555 956,547 956,748 38,759"/><frame points="38,760 959,751 959,1036 38,1043"/><frame points="4,1041 990,1036 993,1492 3,1497"/><text-layer lang="sk"><text-area bgcolor="#f3eed4" points="61,64 61,92 64,94 161,94 167,93 168,91 168,62 166,61 66,61"><p>"... <emphasis>iOČI.</emphasis>"</p></text-area><text-area bgcolor="#f1e7c1" points="744,363 744,442 746,447 901,447 902,363 900,362 748,362"><p>"OKULIARE, KTORÉ DOKÁŽU VAŠE OKO PREMENIŤ NA <emphasis>VIDEOKAMERU</emphasis> ..."</p></text-area><text-area bgcolor="#f3e4c2" points="93,605 92,684 94,689 248,689 270,687 271,612 270,604 96,604"><p>"... A VÁŠ <emphasis>MOZOG</emphasis> NA DIGITÁLNY EDITOVACÍ SOFTWARE NA ŠPECIÁLNE EFEKTY."</p></text-area><text-area bgcolor="#f3e8c7" points="717,587 717,635 719,642 856,642 858,639 858,587 854,586 720,586"><p>"VŠETKO, ČO MUSÍTE SPRAVIŤ, JE SI TO LEN <emphasis>PREDSTAVIŤ</emphasis> ..."</p></text-area><text-area bgcolor="#f2e5c7" points="772,916 772,950 774,952 884,952 885,915 883,913 880,913 777,913"><p>"... A ONO SA TO <emphasis>STANE."</emphasis></p></text-area><text-area bgcolor="#f6e9c7" points="47,1066 46,1178 50,1183 221,1183 222,1066 50,1066"><p>"TERAZ MÔŽETE BEZ NÁMAHY NAHRÁVAŤ A UPRAVOVAŤ VAŠE ZÁŽITKY, MYŠLIENKY, SNY A PRÍBEHY TAK AKO NIKDY PREDTÝM ..."</p></text-area></text-layer></page>
    <page>
      <image href="Issue 01/image_0007.webp"/>
    <frame points="37,50 968,44 968,412 35,418"/><frame points="33,425 965,416 967,1142 35,1149"/><frame points="34,1153 962,1148 963,1487 35,1488"/><text-layer lang="sk"><text-area bgcolor="#f4e8c5" points="103,120 103,196 106,200 299,200 298,119 108,119"><p>"... A NÁSLEDNE VÝSLEDOK OKAMŽITE ROZDISTRIBUOVAŤ DO MILIÓNOV ĎAĽŠÍCH iOČÍ ..."</p></text-area><text-area bgcolor="#f2e8c2" points="782,223 783,278 902,278 902,223 898,222 787,222"><p>"... MÔŽETE SVOJE iOČI NAVZÁJOM POPREPÁJAŤ ..."</p></text-area><text-area bgcolor="#f4e7c7" points="425,535 425,598 428,601 591,600 590,532 430,532"><p>"... POZERAŤ SA NA SVET OČAMI INÝCH UŽIVATEĽOV ..."</p></text-area><text-area bgcolor="#f4e9cb" points="770,1397 770,1458 772,1461 907,1462 933,1461 935,1459 936,1399 933,1397 772,1397"><p>"... A DOSLOVA TAK ZMENIŤ SVET, V KTOROM ŽIJETE."</p></text-area></text-layer></page>
    <page>
