        </text-area>
        <text-area points="437,197 436,168 456,161 479,165 516,163 533,173 536,189 517,203 461,204 451,207">
          <p>Carrot?!</p>
        </text-area>
        <text-area points="491,327 505,307 521,300 570,304 601,304 612,314 607,335 575,343 520,343 501,336">
          <p>Carrot?!!!</p>
        </text-area>
        <text-area points="813,351 797,303 806,267 840,258 935,264 950,277 950,348 918,361 838,361">
          <p>I really didn't think I would have to use this trick ...</p>
        </text-area>
        <text-area points="357,583 308,567 276,539 266,511 273,485 305,465 326,471 343,489 371,461 396,459 417,472 423,506 399,548 367,579">
          <p>Carrot!</p>
        </text-area>
        <text-area points="504,1242 490,1229 493,1217 518,1214 540,1211 556,1218 560,1228 553,1238 538,1242 520,1240">
          <p>Groo</p>
        </text-area>
      </text-layer>
      <text-layer lang="fr">
        <text-area points="44,44 43,15 157,14 158,26 149,39 97,48 62,49">
          <p>Carotte?</p>
        </text-area>
        <text-area points="218,366 209,350 217,324 257,304 320,302 383,312 405,309 419,315 421,360 417,365">
          <p>Incroyable!... même pas sous le lit?</p>
        </text-area>
        <text-area points="437,43 438,15 526,13 533,25 531,41 513,53 483,53 456,51">
          <p>Carotte!</p>
        </text-area>
        <text-area points="559,146 552,136 557,118 574,108 611,107 645,113 652,119 651,144 639,153 568,149">
          <p>Carotte?</p>
        </text-area>
        <text-area points="437,197 436,168 456,161 479,165 516,163 533,173 536,189 517,203 461,204 451,207">
          <p>Carotte?!</p>
        </text-area>
        <text-area points="491,327 505,307 521,300 570,304 601,304 612,314 607,335 575,343 520,343 501,336">
          <p>Carotte?!!!</p>
        </text-area>
        <text-area points="813,351 797,303 806,267 840,258 935,264 950,277 950,348 918,361 838,361">
          <p>Je ne pensais pas devoir en arriver là et utiliser cette technique ...</p>
        </text-area>
        <text-area points="357,583 308,567 276,539 266,511 273,485 305,465 326,471 343,489 371,461 396,459 417,472 423,506 399,548 367,579">
          <p>Carotte!</p>
        </text-area>
        <text-area points="504,1242 490,1229 493,1217 518,1214 540,1211 556,1218 560,1228 553,1238 538,1242 520,1240">
          <p>Groo</p>
        </text-area>
      </text-layer>
      <text-layer lang="sk">
        <text-area points="44,44 43,15 157,14 158,26 149,39 97,48 62,49">
          <p>Carrot?</p>
        </text-area>
        <text-area points="218,366 209,350 217,324 257,304 320,302 383,312 405,309 419,315 421,360 417,365">
          <p>Zaujímavé! Nie je ani pod posteľou</p>
        </text-area>
        <text-area points="437,43 438,15 526,13 533,25 531,41 513,53 483,53 456,51">
          <p>Carrot!</p>
        </text-area>
        <text-area points="559,146 552,136 557,118 574,108 611,107 645,113 652,119 651,144 639,153 568,149">
          <p>Carrot?</p>
        </text-area>
        <text-area points="437,197 436,168 456,161 479,165 516,163 533,173 536,189 517,203 461,204 451,207">
          <p>Carrot?!</p>
        </text-area>
        <text-area points="491,327 505,307 521,300 570,304 601,304 612,314 607,335 575,343 520,343 501,336">
          <p>Carrot?!!!</p>
        </text-area>
        <text-area points="813,351 797,303 806,267 840,258 935,264 950,277 950,348 918,361 838,361">
          <p>Skutočne som si nemyslela, že budem musieť použiť tento trik ...</p>
        </text-area>
        <text-area points="357,583 308,567 276,539 266,511 273,485 305,465 326,471 343,489 371,461 396,459 417,472 423,506 399,548 367,579">
          <p>Carrot!</p>
        </text-area>
        <text-area points="504,1242 490,1229 493,1217 518,1214 540,1211 556,1218 560,1228 553,1238 538,1242 520,1240">
