    <page>
      <image href="03 - Pepper &amp; Carrot/en_Pepper-and-Carrot_by-David-Revoy_E03P04.webp"/>
      <text-layer lang="en">
        <text-area points="92,524 95,515 107,510 126,509 140,516 147,524 140,536 126,540 110,539 96,534">
          <p>...</p>
        </text-area>
