    <page>
      <image href="03 - Pepper &amp; Carrot/en_Pepper-and-Carrot_by-David-Revoy_E04P07.webp"/>
      <text-layer lang="en">
        <text-area points="192,67 74,65 81,15 226,13 226,38">
          <p>What else can this mean?</p>
        </text-area>
        <text-area points="91,80 110,70 191,71 199,86 162,111 131,112 93,103 85,92">
          <p>Embed?</p>
        </text-area>
        <text-area points="166,113 204,87 244,93 263,104 262,126 239,139 199,140 170,126">
          <p>Empty?</p>
        </text-area>
        <text-area points="295,135 304,114 333,94 371,83 443,82 513,95 549,125 551,146 544,170 499,185 449,192 357,185 312,171">
          <p>C'mon Carrot I'm running out of words this really doesn't make any sense!</p></text-area>
        <text-area points="70,550 311,550 311,599 70,599" bgcolor="#61445a" inverted="true">
          <p><inverted>... this really doesn't make any sense ...</inverted></p>
        </text-area>
        <text-area points="752,583 733,556 731,546 916,544 911,574 856,577">
          <p>Grrrrrrr!!!</p>
        </text-area>
        <text-area points="667,787 679,762 938,762 938,788">
          <p>nothing ever works with me!</p>
        </text-area>
        <text-area points="43,855 42,817 111,818 126,829 122,839 86,856">
          <p>Bah ...</p>
        </text-area>
        <text-area points="103,898 116,871 158,853 234,844 278,850 304,862 320,895 312,926 279,945 210,952 137,940 106,914">
          <p>I still have time to invent another potion</p>
        </text-area>
        <text-area points="629,1185 633,1168 643,1156 740,1156 745,1170 735,1194 711,1210 675,1215 643,1207 631,1193">
          <p>Sleep well Carrot</p>
        </text-area>
        <text-area points="771,1337 932,1337 932,1361 770,1361">
          <p>To be continued...</p>
        </text-area>
      </text-layer>
      <text-layer lang="fr">
        <text-area points="192,67 74,65 81,15 226,13 226,38">
          <p>Quoi?</p>
        </text-area>
        <text-area points="91,80 110,70 191,71 199,86 162,111 131,112 93,103 85,92">
          <p>Embué?</p>
        </text-area>
        <text-area points="166,113 204,87 244,93 263,104 262,126 239,139 199,140 170,126">
          <p>Emané?</p>
        </text-area>
        <text-area points="295,135 304,114 333,94 371,83 443,82 513,95 549,125 551,146 544,170 499,185 449,192 357,185 312,171">
          <p>Allez Carotte, fait un effort, ça ne veut rien dire tout ça</p></text-area>
        <text-area points="70,550 311,550 311,599 70,599" bgcolor="#61445a" inverted="true">
          <p><inverted>... ça ne veut rien dire tout ça ...</inverted></p>
        </text-area>
        <text-area points="752,583 733,556 731,546 916,544 911,574 856,577">
          <p>Grrrrrrr!!!</p>
        </text-area>
        <text-area points="667,787 679,762 938,762 938,788">
          <p>Rien ne marche jamais avec moi!</p>
        </text-area>
        <text-area points="43,855 42,817 111,818 126,829 122,839 86,856">
          <p>Bof ...</p>
        </text-area>
        <text-area points="103,898 116,871 158,853 234,844 278,850 304,862 320,895 312,926 279,945 210,952 137,940 106,914">
          <p>il me reste encore du temps pour en préparer une meilleure</p>
        </text-area>
        <text-area points="629,1185 633,1168 643,1156 740,1156 745,1170 735,1194 711,1210 675,1215 643,1207 631,1193">
          <p>... bonne nuit Carotte ...</p>
        </text-area>
        <text-area points="771,1337 932,1337 932,1361 770,1361">
          <p>à suivre ...</p>
        </text-area>
      </text-layer>
      <text-layer lang="sk">
        <text-area points="192,67 74,65 81,15 226,13 226,38">
          <p>Čo iné to môže znamenať?</p>
        </text-area>
        <text-area points="91,80 110,70 191,71 199,86 162,111 131,112 93,103 85,92">
          <p>Element?</p>
        </text-area>
        <text-area points="166,113 204,87 244,93 263,104 262,126 239,139 199,140 170,126">
          <p>Empatia?</p>
        </text-area>
        <text-area points="295,135 304,114 333,94 371,83 443,82 513,95 549,125 551,146 544,170 499,185 449,192 357,185 312,171">
          <p>Ale choď Carrot, dochádzajú mi slová, toto nedáva žiaden zmysel!</p></text-area>
        <text-area points="70,550 311,550 311,599 70,599" bgcolor="#61445a" inverted="true">
          <p><inverted>... toto skutočne nedáva žiaden zmysel ...</inverted></p>
        </text-area>
        <text-area points="752,583 733,556 731,546 916,544 911,574 856,577">
          <p>Chrrrrrr!!!</p>
        </text-area>
        <text-area points="667,787 679,762 938,762 938,788">
          <p>Nič mi nevychádza!</p>
        </text-area>
        <text-area points="43,855 42,817 111,818 126,829 122,839 86,856">
          <p>Aah ...</p>
        </text-area>
        <text-area points="103,898 116,871 158,853 234,844 278,850 304,862 320,895 312,926 279,945 210,952 137,940 106,914">
          <p>Stále mám čas vymyslieť nejaký ďalší elixír</p>
        </text-area>
        <text-area points="629,1185 633,1168 643,1156 740,1156 745,1170 735,1194 711,1210 675,1215 643,1207 631,1193">
          <p>Spi sladko Carrot</p>
        </text-area>
        <text-area points="771,1337 932,1337 932,1361 770,1361">
          <p>Pokračovanie nabudúce...</p>
        </text-area>
      </text-layer>
