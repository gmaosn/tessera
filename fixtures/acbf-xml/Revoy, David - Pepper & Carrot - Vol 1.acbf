      <text-layer lang="en">
        <text-area points="102,21 898,21 898,85 105,85" bgcolor="#c3bda3">
          <p>Pepper&amp;Carrot is totally free, open-source, and sponsored thanks to the help of patrons. This episode was sponsored by 156 patrons:</p>
        </text-area>
        <text-area points="405,607 584,607 584,631 405,631" bgcolor="#dcd9ba">
