    <page bgcolor="#727a63">
      <image href="03 - Pepper &amp; Carrot/en_Pepper-and-Carrot_by-David-Revoy_E01P01.webp"/>
      <text-layer lang="en" bgcolor="#fefde9">
        <text-area points="303,145 688,145 690,189 302,191" bgcolor="#727a63" type="heading">
          <p>Episode 1: Potion of flight</p>
        </text-area>
        <text-area points="437,276 444,257 460,242 489,233 525,232 558,240 578,252 588,269 589,282 577,300 552,312 523,316 486,315 458,306 441,295">
          <p>...and the last touch</p>
        </text-area>
        <text-area points="485,864 489,843 507,821 534,804 561,796 589,804 614,818 630,836 642,862 643,883 629,900 606,908 560,916 526,909 499,893 486,877">
          <p>...mmm probably not strong enough</p>
        </text-area>
        <text-area points="739,2009 747,1992 765,1977 787,1969 808,1972 828,1982 842,1998 846,2011 844,2026 835,2038 817,2045 780,2043 759,2037 744,2023">
          <p>ha... perfect</p>
        </text-area>
        <text-area points="471,2518 477,2504 496,2487 522,2474 557,2469 593,2476 630,2489 657,2509 658,2521 649,2544 628,2561 596,2569 549,2569 507,2555 477,2532">
          <p>NO! Don't even think about it</p>
        </text-area>
        <text-area points="232,3667 238,3654 254,3644 285,3637 327,3640 368,3650 384,3659 388,3668 382,3681 352,3692 316,3697 277,3693 247,3685 233,3674" bgcolor="#a6c9c5">
          <p>Happy?!</p>
        </text-area>
      </text-layer>
      <text-layer lang="fr" bgcolor="#fefde9">
        <text-area points="303,145 688,145 690,189 302,191" bgcolor="#727a63" type="heading">
          <p>Episode 1: Potion d'envol</p>
        </text-area>
        <text-area points="437,276 444,257 460,242 489,233 525,232 558,240 578,252 588,269 589,282 577,300 552,312 523,316 486,315 458,306 441,295">
          <p>...et la dernière touche</p>
        </text-area>
        <text-area points="485,864 489,843 507,821 534,804 561,796 589,804 614,818 630,836 642,862 643,883 629,900 606,908 560,916 526,909 499,893 486,877">
          <p>...mmm probablement pas assez</p>
        </text-area>
        <text-area points="739,2009 747,1992 765,1977 787,1969 808,1972 828,1982 842,1998 846,2011 844,2026 835,2038 817,2045 780,2043 759,2037 744,2023">
          <p>ha... parfait</p>
        </text-area>
        <text-area points="471,2518 477,2504 496,2487 522,2474 557,2469 593,2476 630,2489 657,2509 658,2521 649,2544 628,2561 596,2569 549,2569 507,2555 477,2532">
          <p>NON! N'y pense même pas</p>
        </text-area>
        <text-area points="232,3667 238,3654 254,3644 285,3637 327,3640 368,3650 384,3659 388,3668 382,3681 352,3692 316,3697 277,3693 247,3685 233,3674" bgcolor="#a6c9c5">
          <p>Satisfait?</p>
        </text-area>
      </text-layer>
      <text-layer lang="sk" bgcolor="#fefde9">
        <text-area points="303,145 688,145 690,189 302,191" bgcolor="#727a63" type="heading">
          <p>Epizóda 1: Elixír lietania</p>
        </text-area>
        <text-area points="437,276 444,257 460,242 489,233 525,232 558,240 578,252 588,269 589,282 577,300 552,312 523,316 486,315 458,306 441,295">
          <p>...a ešte kúsok tohto</p>
        </text-area>
        <text-area points="485,864 489,843 507,821 534,804 561,796 589,804 614,818 630,836 642,862 643,883 629,900 606,908 560,916 526,909 499,893 486,877">
          <p>...mmm asi to nie je dosť silné</p>
        </text-area>
        <text-area points="739,2009 747,1992 765,1977 787,1969 808,1972 828,1982 842,1998 846,2011 844,2026 835,2038 817,2045 780,2043 759,2037 744,2023">
          <p>ha... perfektné</p>
        </text-area>
        <text-area points="471,2518 477,2504 496,2487 522,2474 557,2469 593,2476 630,2489 657,2509 658,2521 649,2544 628,2561 596,2569 549,2569 507,2555 477,2532">
          <p>NIE! Nech ti to ani nenapadne</p>
        </text-area>
        <text-area points="232,3667 238,3654 254,3644 285,3637 327,3640 368,3650 384,3659 388,3668 382,3681 352,3692 316,3697 277,3693 247,3685 233,3674" bgcolor="#a6c9c5">
          <p>Štastný?!</p>
        </text-area>
      </text-layer>
