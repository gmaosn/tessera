    <page>
      <image href="03 - Pepper &amp; Carrot/en_Pepper-and-Carrot_by-David-Revoy_E04P06.webp"/>
      <text-layer lang="en">
        <text-area points="483,268 481,246 488,223 660,222 671,239 671,264 659,293 635,315 580,321 537,320 504,307">
          <p>WOW ... Carrot! that's amazing... a real alphabet ...</p>
        </text-area>
        <text-area points="774,274 779,253 796,238 835,234 878,240 904,260 905,285 900,300 859,309 806,307 783,296">
          <p>You... You write?</p>
        </text-area>
        <text-area points="797,402 790,394 807,370 853,363 880,387 877,404 865,416">
          <p>E?</p>
        </text-area>
        <text-area points="734,441 746,421 796,407 857,423 875,436 865,451 797,471 750,461">
          <p>Energy?</p>
        </text-area>
        <text-area points="804,497 796,486 807,472 880,448 925,461 945,484 936,507 907,520 871,521 826,508">
          <p>Eternal?</p>
        </text-area>
        <text-area points="718,533 725,519 762,503 800,503 855,520 865,536 855,556 736,558 721,545">
          <p>Emotion?</p>
        </text-area>
      </text-layer>
      <text-layer lang="fr">
        <text-area points="483,268 481,246 488,223 660,222 671,239 671,264 659,293 635,315 580,321 537,320 504,307">
          <p>Poc ouaouh ... Carotte! c'est fantastique...</p>
        </text-area>
        <text-area points="774,274 779,253 796,238 835,234 878,240 904,260 905,285 900,300 859,309 806,307 783,296">
          <p>tu... ...tu écris?</p>
        </text-area>
        <text-area points="797,402 790,394 807,370 853,363 880,387 877,404 865,416">
          <p>E?</p>
        </text-area>
        <text-area points="734,441 746,421 796,407 857,423 875,436 865,451 797,471 750,461">
          <p>Energie?</p>
        </text-area>
        <text-area points="804,497 796,486 807,472 880,448 925,461 945,484 936,507 907,520 871,521 826,508">
          <p>Eternel?</p>
        </text-area>
        <text-area points="718,533 725,519 762,503 800,503 855,520 865,536 855,556 736,558 721,545">
          <p>Emotion?</p>
        </text-area>
      </text-layer>
      <text-layer lang="sk">
        <text-area points="483,268 481,246 488,223 660,222 671,239 671,264 659,293 635,315 580,321 537,320 504,307">
          <p>WOW ... Carrot! to je úžasné... skutočná abeceda ...</p>
        </text-area>
        <text-area points="774,274 779,253 796,238 835,234 878,240 904,260 905,285 900,300 859,309 806,307 783,296">
          <p>Ty... vieš písať?</p>
        </text-area>
        <text-area points="797,402 790,394 807,370 853,363 880,387 877,404 865,416">
          <p>E?</p>
        </text-area>
        <text-area points="734,441 746,421 796,407 857,423 875,436 865,451 797,471 750,461">
          <p>Energia?</p>
        </text-area>
        <text-area points="804,497 796,486 807,472 880,448 925,461 945,484 936,507 907,520 871,521 826,508">
          <p>Elektrina?</p>
        </text-area>
        <text-area points="718,533 725,519 762,503 800,503 855,520 865,536 855,556 736,558 721,545">
          <p>Emócia?</p>
        </text-area>
      </text-layer>
      <frame points="39,0 491,1 491,193 40,193"/>
