      <text-layer lang="en">
        <text-area points="44,44 43,15 157,14 158,26 149,39 97,48 62,49">
          <p>Carrot?</p>
        </text-area>
        <text-area points="218,366 209,350 217,324 257,304 320,302 383,312 405,309 419,315 421,360 417,365">
          <p>Amazing! Not even under the bed?</p>
        </text-area>
        <text-area points="437,43 438,15 526,13 533,25 531,41 513,53 483,53 456,51">
