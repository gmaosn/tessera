    <page>
      <image href="03 - Pepper &amp; Carrot/en_Pepper-and-Carrot_by-David-Revoy_E03P03.webp"/>
      <text-layer lang="en">
        <text-area points="190,674 342,651 378,713 215,742" text-rotation="10" bgcolor="#e9d9a0" type="letter">
          <p>Komona Potion Challenge</p>
        </text-area>
        <text-area points="185,763 414,719 450,765 394,779 408,805 225,845" text-rotation="12" bgcolor="#e2c58d" type="letter">
          <p>50000Ko grand prize FOR THE BEST POTION</p>
        </text-area>
        <text-area points="254,876 491,826 534,878 300,932" text-rotation="13" bgcolor="#cca85c" type="letter">
          <p>On Azurday, 3 Pinkmoon Grand Plaza of Komona</p>
        </text-area>
        <text-area points="520,1084 529,1066 545,1052 652,1045 718,1046 754,1061 772,1081 770,1097 744,1116 679,1125 586,1123 546,1114 524,1093">
          <p>Lucky me, I still have a full day to prepare!</p>
        </text-area>
        <text-area points="531,1237 520,1191 537,1175 580,1169 620,1163 669,1178 687,1189 678,1232 656,1252 584,1254">
          <p>Let's win this challenge!</p>
        </text-area>
      </text-layer>
      <text-layer lang="fr">
        <text-area points="190,674 342,651 378,713 215,742" text-rotation="10" bgcolor="#e9d9a0" type="letter">
          <p>Concours de Potions de Komona</p>
        </text-area>
        <text-area points="185,763 414,719 450,765 394,779 408,805 225,845" text-rotation="12" bgcolor="#e2c58d" type="letter">
          <p>grand prix de 50 000Ko POUR LA MEILLEURE POTION</p>
        </text-area>
        <text-area points="254,876 491,826 534,878 300,932" text-rotation="13" bgcolor="#cca85c" type="letter">
          <p>Azarday, 3 Pinkmoon Grand' place de Komona</p>
        </text-area>
        <text-area points="520,1084 529,1066 545,1052 652,1045 718,1046 754,1061 772,1081 770,1097 744,1116 679,1125 586,1123 546,1114 524,1093">
          <p>Quelle chance ce concours! Et j'ai encore un jour complet pour me préparer</p>
        </text-area>
        <text-area points="531,1237 520,1191 537,1175 580,1169 620,1163 669,1178 687,1189 678,1232 656,1252 584,1254">
          <p>Bien sûr que je vais participer!</p>
        </text-area>
      </text-layer>
      <text-layer lang="sk">
        <text-area points="190,674 342,651 378,713 215,742" text-rotation="10" bgcolor="#e9d9a0" type="letter">
          <p>Súťaž o Komonský elixír</p>
        </text-area>
        <text-area points="185,763 414,719 450,765 394,779 408,805 225,845" text-rotation="12" bgcolor="#e2c58d" type="letter">
          <p>50000Ko cena pre víťaza</p><p>ZA NAJLEPŠÍ ELIXÍR</p>
        </text-area>
        <text-area points="254,876 491,826 534,878 300,932" text-rotation="13" bgcolor="#cca85c" type="letter">
          <p>Na azúrový deň, 3. ružomesiac Hlavné Námestie v Komone</p>
        </text-area>
        <text-area points="520,1084 529,1066 545,1052 652,1045 718,1046 754,1061 772,1081 770,1097 744,1116 679,1125 586,1123 546,1114 524,1093">
          <p>Naštastie, mám ešte celý deň na prípravu!</p>
        </text-area>
        <text-area points="531,1237 520,1191 537,1175 580,1169 620,1163 669,1178 687,1189 678,1232 656,1252 584,1254">
          <p>Poďme tú súťaž vyhrať!</p>
        </text-area>
      </text-layer>
